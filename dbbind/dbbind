_BAD_IDENT = re.compile(r"[\s\"'`;\\()\[\]]")


def quote_ident(name, engine, what="标识符"):
    """校验并引用标识符（拒绝注入字符），支持 schema.table。"""
    if not isinstance(name, str) or not name.strip():
        die("USAGE", "%s不能为空" % what)
    out = []
    for part in name.strip().split("."):
        if not part or _BAD_IDENT.search(part):
            die("USAGE", "%s含非法字符：%r" % (what, name),
                "表名/库名请只用字母数字下划线（点号可表示 schema.table）")
        out.append("`%s`" % part if engine == "mysql" else '"%s"' % part)
    return ".".join(out)


def sql_str_literal(value, engine):
    if value is None:
        return "NULL"
    s = str(value)
    if engine == "mysql":
        s = s.replace("\\", "\\\\")
    return "'%s'" % s.replace("'", "''")


