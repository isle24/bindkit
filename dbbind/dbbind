def ensure_init():
    """§1.1 首次运行自动初始化：幂等，绝不覆盖用户已有内容。"""
    try:
        os.makedirs(BASE_DIR, exist_ok=True)
        os.chmod(BASE_DIR, 0o700)
    except OSError as e:
        die("STATE_CORRUPT", "无法创建状态目录 %s：%s" % (BASE_DIR, e),
            "检查家目录是否可写")
    if os.path.exists(AGENT_FILE):
        try:
            os.chmod(AGENT_FILE, 0o644)
        except OSError:
            pass
    else:
        try:
            with open(AGENT_FILE, "w", encoding="utf-8") as f:
                f.write(AGENT_TEMPLATE)
            os.chmod(AGENT_FILE, 0o644)
        except OSError as e:
            warn("写入 %s 失败：%s" % (AGENT_FILE, e))
    if not os.path.exists(STATE_FILE):
        _write_state({"version": 1, "databases": {}})


def load_state():
    if not os.path.exists(STATE_FILE):
        return {"version": 1, "databases": {}}
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        die("STATE_CORRUPT", "状态文件不可读：%s\n  %s" % (STATE_FILE, e))
    data = parse_jsonc(text, STATE_FILE)
    if not isinstance(data, dict):
        die("STATE_CORRUPT", "状态文件顶层不是对象：%s" % STATE_FILE)
    data.setdefault("version", 1)
    if not isinstance(data.get("databases"), dict):
        die("STATE_CORRUPT", "状态文件缺少 databases 对象：%s" % STATE_FILE)
    return data


def _write_state(state):
    try:
        os.makedirs(BASE_DIR, exist_ok=True)
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2, sort_keys=True)
        os.chmod(tmp, 0o600)
        os.replace(tmp, STATE_FILE)
        os.chmod(STATE_FILE, 0o600)
        os.chmod(BASE_DIR, 0o700)
    except OSError as e:
        die("STATE_CORRUPT", "写入状态文件失败：%s\n  %s" % (STATE_FILE, e))


def save_state(state):
    _write_state(state)


