# ---------------------------------------------------------------------------

def rows_as_objects(columns, rows):
    return [dict(zip(columns, r)) for r in rows]


def render_table(columns, rows, max_width=48):
    cols = [str(c) for c in columns]
    cells = [["NULL" if v is None else str(v) for v in r] for r in rows]
    widths = [len(c) for c in cols]
    for r in cells:
        for i, v in enumerate(r):
            if i < len(widths):
                widths[i] = max(widths[i], len(v))
    widths = [min(w, max_width) for w in widths]

    def cut(s, w):
        return s if len(s) <= w else s[:max(1, w - 1)] + "…"

    lines = []
    if cols:
        lines.append("  " + "  ".join(cut(c, w).ljust(w) for c, w in zip(cols, widths)))
        lines.append("  " + "  ".join("-" * w for w in widths))
    for r in cells:
        lines.append("  " + "  ".join(cut(v, w).ljust(w) for v, w in zip(r, widths)))
    return "\n".join(lines)


def _cell_text(v):
    if v is None:
        return ""
    if isinstance(v, (dict, list)):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, bool):
        return "true" if v else "false"
    return str(v)


def format_data(rec, columns, rows, fmt):
    if fmt == "json":
        return json.dumps(rows_as_objects(columns, rows), ensure_ascii=False,
                          indent=2, default=str) + "\n"
    if fmt == "jsonl":
        return "".join(json.dumps(o, ensure_ascii=False, default=str) + "\n"
                       for o in rows_as_objects(columns, rows))
    if fmt == "csv":
        buf = io.StringIO()
        writer = csv_mod.writer(buf, lineterminator="\n")
        if columns:
            writer.writerow([_cell_text(c) for c in columns])
        for r in rows:
            writer.writerow([_cell_text(v) for v in r])
        return buf.getvalue()
    if fmt == "sql":
        eng = rec.get("engine")
        lines = ["-- dbbind export（%s）" % rec["name"],
                 "-- 目标表名请按需替换；字符串已按引擎转义，NULL 写作 NULL"]
        for r in rows:
            lines.append("INSERT INTO exported_data (%s) VALUES (%s);"
                         % (", ".join(str(c) for c in columns),
                            ", ".join(sql_literal(v, eng) for v in r)))
        return "\n".join(lines) + "\n"
    return render_table(columns, rows) + "\n"


def sql_literal(v, engine):
    if v is None:
        return "NULL"
    if isinstance(v, bool):
        if engine == "postgres":
            return "TRUE" if v else "FALSE"
        return "1" if v else "0"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, (dict, list)):
        v = json.dumps(v, ensure_ascii=False)
    s = str(v)
    if engine == "mysql":
        s = (s.replace("\\", "\\\\").replace("\0", "\\0").replace("\n", "\\n")
              .replace("\r", "\\r").replace("\x1a", "\\Z"))
    return "'%s'" % s.replace("'", "''")


def write_out(path, text):
    target = os.path.abspath(os.path.expanduser(path))
    d = os.path.dirname(target)
    if d and not os.path.isdir(d):
        die("USAGE", "输出目录不存在：%s" % d, "先创建目录，或换一个 --out 路径")
    try:
        with open(target, "w", encoding="utf-8", newline="") as f:
            f.write(text)
    except OSError as e:
        die("USAGE", "写入失败：%s\n  %s" % (path, e))
    return target


