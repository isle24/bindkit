def cmd_config_validate(args):
    issues, files_report = [], []
    cfg = None
    try:
        cfg = load_effective_config(explicit=getattr(args, "config", None))
    except DbbindError as e:
        issues.append({"severity": "error", "code": e.code,
                       "message": redact(e.message), "hint": e.hint})
    if cfg:
        for f in cfg["files"]:
            problems = 0
            if f["exists"] and not f["readable"]:
                issues.append({"severity": "error", "file": f["path"], "message": "文件不可读"})
                problems += 1
            for u in f["unknown_fields"]:
                issues.append({"severity": "warning", "file": f["path"], "message": u,
                               "hint": "未知字段会被忽略，注意是否拼错"})
                problems += 1
            files_report.append({"path": f["path"], "kind": f["kind"], "exists": f["exists"],
                                 "readable": f["readable"], "aliases": len(f["aliases"]),
                                 "problems": problems})
        for alias, field, name in cfg["missing_env"]:
            issues.append({"severity": "error", "alias": alias, "field": field,
                           "message": "环境变量 $%s 未设置（别名 %s 的 %s）"
                                      % (name, alias, field),
                           "hint": "export %s=... 后再试" % name})
        for name, rec in cfg["entries"].items():
            if not rec.get("usable"):
                issues.append({"severity": "error", "alias": name,
                               "message": rec.get("usable_reason") or "不可用"})
    errors = [i for i in issues if i["severity"] == "error"]
    payload = {"ok": not issues, "count": len(issues), "errors": len(errors),
               "files": files_report, "issues": issues}
    if JSON_MODE:
        emit_json(payload)
    else:
        human()
        for i in issues:
            human("  [%s] %s %s" % ("错误" if i["severity"] == "error" else "警告",
                                    i.get("file") or i.get("alias") or "", i["message"]))
            if i.get("hint"):
                human("         %s" % i["hint"])
        human()
        human("  发现 %d 个问题（%d 个错误）" % (len(issues), len(errors)) if issues
              else "  %s" % (C_OK + "配置检查通过" + C_OFF))
        human()
    return 0 if not issues else EXIT_ERR


