def validate_alias(name):
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", name or ""):
        die("USAGE", "别名只能包含字母、数字、点、下划线、连字符，且不能以符号开头：%s" % name,
            "例如：demo-mysql、nas_pg")


def cmd_add(args):
    name = args.name
    validate_alias(name)
    if args.read_only and args.allow_write:
        die("USAGE", "--read-only 与 --allow-write 不能同时使用")
    engine = args.engine
    if engine not in ENGINE_NAMES:
        die("USAGE", "不支持的引擎：%s" % engine, "当前支持：%s" % "|".join(ENGINE_NAMES))
    state = load_state()
    existed = name in state["databases"]
    if existed and not args.force:
        die("USAGE", "别名已存在：%s" % name,
            "换个名字，或加 --force 覆盖（会替换 databases.json 里的旧记录）")

    warnings = []
    if engine == "sqlite":
        if args.password or args.password_stdin:
            warnings.append("sqlite 不需要密码，已忽略 --password/--password-stdin")
        if not args.file:
            die("USAGE", "sqlite 必须用 --file 指定数据库文件")
        rec = {
            "name": name, "engine": "sqlite", "host": None, "port": None,
            "user": None, "password": None, "database": None,
            "file": os.path.abspath(os.path.expanduser(args.file)),
            "via_ssh": args.via_ssh, "docker_exec": args.docker_exec,
            "read_only": not args.allow_write,
            "created_at": datetime.now().isoformat(timespec="seconds"),
            "source": "manual", "origin": "state",
        }
    else:
        if not args.host:
            die("USAGE", "%s 需要 --host" % engine, "例如：--host 192.0.2.10")
        if not args.user:
            die("USAGE", "%s 需要 --user" % engine, "例如：--user root")
        password = None
        if args.password_stdin:
            password = sys.stdin.readline().rstrip("\n")
            if not password:
                die("USAGE", "从 stdin 读到的密码为空")
        elif args.password is not None:
            password = args.password
            warn("--password 会出现在 shell 历史与 ps 输出里，建议改用 --password-stdin")
        elif sys.stdin.isatty():
            try:
                password = getpass.getpass("  数据库密码（输入时不可见，可留空）: ")
            except (KeyboardInterrupt, EOFError):
                print()
                die("USAGE", "已取消")
        if args.port:
            try:
                port = int(args.port)
            except (TypeError, ValueError):
                die("USAGE", "--port 必须是整数：%s" % args.port)
        else:
            port = DEFAULT_PORTS[engine]
        rec = {
            "name": name, "engine": engine, "host": args.host, "port": port,
            "user": args.user, "password": password or None,
            "database": args.database, "file": None,
            "via_ssh": args.via_ssh, "docker_exec": args.docker_exec,
            "read_only": not args.allow_write,
            "created_at": datetime.now().isoformat(timespec="seconds"),
            "source": "manual", "origin": "state",
        }
    register_secret(rec.get("password"))
    state["databases"][name] = rec
    save_state(state)

    cfg = load_effective_config(explicit=getattr(args, "config", None))
    entry = cfg["entries"].get(name)
    test_result = None
    if args.test and entry:
        if not entry.get("usable"):
            warn("别名不可用：%s" % entry.get("usable_reason"))
            test_result = {"ok": False, "message": entry.get("usable_reason")}
        else:
            try:
                res = execute_sql(entry, "select 1", mode="query", timeout=30)
                test_result = {"ok": True, "duration_ms": res["duration_ms"],
                               "via": entry["via"]}
            except DbbindError as e:
                test_result = {"ok": False, "code": e.code, "message": redact(e.message)}
                warn("连通性测试失败：%s" % redact(e.message))
    result = {
        "ok": True, "alias": name, "engine": engine,
        "via": "docker" if args.docker_exec else ("ssh" if args.via_ssh else "local"),
        "read_only": rec["read_only"], "has_password": bool(rec.get("password")),
        "path": STATE_FILE, "replaced": bool(existed),
        "test": test_result, "warnings": warnings,
    }
    if JSON_MODE:
        emit_json(result)
    else:
        human()
        ok("已绑定 %s（%s，%s）" % (bold(name), engine,
                                   "只读" if rec["read_only"] else "可写"))
        info("连接：%s" % entry_summary(entry or rec))
        if test_result and test_result.get("ok"):
            ok("连通性测试通过（%sms）" % test_result.get("duration_ms"))
        for w in warnings:
            warn(w)
        human()
        human("  试试：  dbbind exec %s \"select 1\"" % name)
        human("  看结构：dbbind tables %s" % name)
        human()
    return 0 if (test_result is None or test_result.get("ok")) else EXIT_ERR


def cmd_list(args):
    cfg = current_config(args)
    want_engine = getattr(args, "engine", None)
    want_origin = getattr(args, "origin", None)
    entries = []
    for name in sorted(cfg["entries"]):
        rec = cfg["entries"][name]
        if want_engine and rec.get("engine") != want_engine:
            continue
        if want_origin and rec.get("origin") != want_origin:
            continue
        item = public_entry(rec)
        item["warnings"] = list(item.get("warnings") or []) + \
            _policy_entry_warnings(rec.get("engine"), name)
        entries.append(item)
    if JSON_MODE:
        emit_json({"count": len(entries), "databases": entries,
                   "config_files": [f["path"] for f in cfg["files"] if f["exists"]]})
        return 0
    if not entries:
        human("还没有配置任何数据库。两种方式：")
        human("  1) 写配置文件：dbbind config init          （生成模板）")
        human("  2) 命令行添加：dbbind add mydb --engine mysql --host 1.2.3.4 --user root")
        return 0
    head = ("名称", "引擎", "目标", "通道", "来源", "模式", "状态")
    rows = []
    for e in entries:
        target = e["file"] if e["engine"] == "sqlite" else \
            "%s@%s:%s" % (e["user"], e["host"], e["port"])
        rows.append([e["name"], e["engine"], target, e["via"], e["origin"],
                     "只读" if e["read_only"] else "可写",
                     "可用" if e["usable"] else "不可用:" + (e["usable_reason"] or "")])
    widths = [max(len(str(r[i])) for r in rows + [head]) for i in range(len(head))]
    widths[2] = min(widths[2], 44)
    widths[6] = min(widths[6], 60)
    human()
    human("  " + "  ".join(str(h).ljust(widths[i]) for i, h in enumerate(head)))
    human("  " + "-" * (sum(widths) + 2 * (len(head) - 1)))
    for r in rows:
        human("  " + "  ".join(str(c)[:widths[i]].ljust(widths[i])
                               for i, c in enumerate(r)))
    human()
    human("  共 %d 个。详情：dbbind show <别名>；测试：dbbind test" % len(rows))
    human()
    return 0


