                                   else ("libpq" if eng == "postgres" else "sqlite")))
    check("ssh 命令（ssh / docker 通道）", bool(shutil.which("ssh")),
          shutil.which("ssh") or "未找到")
    check("docker 命令（本机 docker 通道）", bool(shutil.which("docker")),
          shutil.which("docker") or "未找到（只有本机 docker 通道才需要）")

    structural = 0
    if not os.path.isdir(BASE_DIR):
        structural += 1
        check("状态目录存在", False, BASE_DIR)
    else:
        mode = os.stat(BASE_DIR).st_mode & 0o777
        if mode != 0o700:
            structural += 1
        check("状态目录权限 0700", mode == 0o700, "%s (%o)" % (BASE_DIR, mode),
              "chmod 700 %s" % BASE_DIR)
    check("AGENT.md", os.path.isfile(AGENT_FILE), AGENT_FILE)
    if os.path.isfile(STATE_FILE):
        mode = os.stat(STATE_FILE).st_mode & 0o777
        if mode != 0o600:
            structural += 1
        check("databases.json 权限 0600", mode == 0o600,
              "%s (%o)" % (STATE_FILE, mode), "chmod 600 %s" % STATE_FILE)
    else:
        check("databases.json", True, "尚未创建（add 时创建）")

    cfg = None
    try:
        cfg = load_effective_config(explicit=getattr(args, "config", None))
    except DbbindError as e:
        structural += 1
        check("配置可解析", False, redact(e.message), e.hint)
    config_report = {"files": [], "unknown_fields": [], "missing_env": []}
    if cfg:
        for f in cfg["files"]:
            config_report["files"].append(
                {"path": f["path"], "kind": f["kind"], "exists": f["exists"],
                 "readable": f["readable"], "aliases": f["aliases"]})
        config_report["unknown_fields"] = cfg["unknown_fields"]
        config_report["missing_env"] = ["%s.%s ($%s)" % (a, f, n)
                                        for a, f, n in cfg["missing_env"]]
        check("配置可解析", True,
              "、".join("%s(%s)" % (f["path"], "存在" if f["exists"] else "缺失")
                        for f in cfg["files"]))
        check("配置无未知字段", not cfg["unknown_fields"],
              "；".join(cfg["unknown_fields"][:4]) or "无", "拼错的字段会被忽略，改掉它")
        check("$ENV 环境变量齐全", not cfg["missing_env"],
              "；".join("$%s" % n for _, _, n in cfg["missing_env"]) or "无",
              "在 shell 里 export 这些变量")

    entries = list((cfg or {}).get("entries", {}).values())
    usable = [e for e in entries if e.get("usable")]
    unusable = [e for e in entries if not e.get("usable")]
    for e in unusable:
        warn("别名 %s 不可用：%s" % (e["name"], e.get("usable_reason")))

    payload = {
        "ok": structural == 0, "version": VERSION, "python": sys.version.split()[0],
        "home": BASE_DIR, "state_file": STATE_FILE, "checks": checks,
        "clients": {eng: {"found": bool(find_client(eng)[0]), "path": find_client(eng)[0]}
                    for eng in ENGINE_NAMES},
        "config": config_report,
        "databases": {"count": len(entries), "usable": len(usable), "unusable": len(unusable),
                      "unusable_reasons": [{"name": e["name"],
                                            "reason": e.get("usable_reason")}
                                           for e in unusable]},
        "structural_problems": structural,
    }
    if JSON_MODE:
        emit_json(payload)
        return 0 if structural == 0 else EXIT_ERR
    human()
    for c in checks:
        human("  %s %s%s" % ("✅" if c["ok"] else "⚠️ ", c["name"],
                             ("  %s" % c["detail"]) if c["detail"] else ""))
        if not c["ok"] and c["hint"]:
            human("      %s" % c["hint"])
    human()
    human("  别名：%d 个（可用 %d，不可用 %d）" % (len(entries), len(usable), len(unusable)))
    for e in entries:
        human("    %-20s %-9s %-8s %s" % (e["name"], e["engine"], e.get("origin"),
                                          "可用" if e["usable"]
                                          else "不可用 — %s" % e.get("usable_reason")))
    human()
    human("  状态目录：%s" % BASE_DIR)
    human("  配置文件：%s" % "、".join(f["path"] for f in (cfg or {}).get("files", [])
                                      if f["exists"]))
    human()
    human("  %s" % (C_OK + "环境自检通过" + C_OFF) if not structural
          else "  %s" % (C_WARN + "发现 %d 个结构性问题（见上）" % structural + C_OFF))
    human()
    return 0 if structural == 0 else EXIT_ERR


# ---------------------------------------------------------------------------
# argparse / 入口
# ---------------------------------------------------------------------------

def _add_common(p):
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="只输出 JSON（人类可读信息走 stderr）")
    p.add_argument("--config", metavar="PATH", default=argparse.SUPPRESS,
                   help="额外的配置文件（最高优先，等价于 $%s）" % CONFIG_ENV)


def build_parser():
    common = _Parser(add_help=False)
    _add_common(common)
    p = _Parser(
        prog=PROG,
        description="dbbind — 数据库连接绑定管理器：绑定一次，之后 AI/脚本按别名免密操作数据库。",
        epilog="配置文件是首选入口：~/.dbbind/config.json、项目 .dbbind.json、$%s\n"
               "例：\n"
               "  dbbind list --json\n"
               "  dbbind exec --json demo-mysql \"select 1\"\n"
               "  dbbind dbinfo demo-pg\n"
               "  dbbind doctor\n"
               "  dbbind --startserver [--port 8791] [--host 127.0.0.1] [--daemon] [--open]\n"
               "      # Web 控制台；--host HOST 监听地址（默认 127.0.0.1，局域网访问用 0.0.0.0）\n"
               % CONFIG_ENV,
        formatter_class=argparse.RawDescriptionHelpFormatter, parents=[common])
    p.add_argument("--version", action="store_true", help="显示版本（支持 --json）")
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("add", parents=[common],
                       help="绑定数据库并写入 databases.json（配置文件之外的补充入口）")
    a.add_argument("name", help="别名")
    a.add_argument("--engine", required=True, choices=list(ENGINE_NAMES))
    a.add_argument("--host", help="地址（mysql/postgres 必填）")
    a.add_argument("--port", type=int, help="端口（默认 mysql 3306 / postgres 5432）")
    a.add_argument("--user", help="用户名（mysql/postgres 必填）")
    a.add_argument("--password", help="密码（会进 ps，建议用 --password-stdin）")
    a.add_argument("--password-stdin", action="store_true", help="从标准输入读密码")
    a.add_argument("--database", help="默认库")
    a.add_argument("--file", help="sqlite 数据库文件")
    a.add_argument("--via-ssh", metavar="ALIAS", help="通过 sshbind 别名在远端执行")
    a.add_argument("--docker-exec", metavar="TARGET", help="docker 通道：[ssh别名:]容器名")
    a.add_argument("--read-only", action="store_true", help="只读（默认）")
    a.add_argument("--allow-write", action="store_true", help="允许写（含 DDL）")
    a.add_argument("--force", action="store_true", help="覆盖同名别名")
    a.add_argument("--test", action="store_true", help="添加后立即连通性测试")
    a.set_defaults(func=cmd_add)

    l = sub.add_parser("list", parents=[common], help="列出所有别名")
    l.add_argument("--engine", choices=list(ENGINE_NAMES), help="只看某个引擎")
    l.add_argument("--origin", choices=list(ORIGIN_NAMES), help="只看某个来源")
    l.set_defaults(func=cmd_list)

    s = sub.add_parser("show", parents=[common], help="查看某个别名的详情")
    s.add_argument("name")
    s.add_argument("--reveal", action="store_true", help="显示明文密码（默认打码）")
    s.set_defaults(func=cmd_show)

    t = sub.add_parser("test", parents=[common], help="连通性测试（省略别名=测试全部）")
    t.add_argument("name", nargs="?", help="别名")
    t.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    t.set_defaults(func=cmd_test)

    r = sub.add_parser("remove", parents=[common], help="删除绑定（只删 databases.json 记录）")
    r.add_argument("name")
    r.add_argument("--yes", action="store_true", help="跳过二次确认（非交互终端必须给）")
    r.set_defaults(func=cmd_remove)

    ex = sub.add_parser("exec", parents=[common], help="执行 SQL（agent 首选入口）")
    ex.add_argument("--write", action="store_true", help="本次放行数据修改（DML）")
    ex.add_argument("--unsafe", action="store_true", help="放行 DML+DDL 并记 warning")
    ex.add_argument("--limit", type=int, default=None,
                    help="返回行数上限；默认取配置 defaults.limit；0=只探测有没有数据；"
                         "负数报错；--out 落盘时不传则不限")
    ex.add_argument("--format", choices=["json", "jsonl", "csv", "table"], default=None,
                    help="stdout 数据格式（默认 table；--json 时以 JSON 信封为准）")
    ex.add_argument("--out", help="把结果写入文件（此时不传 --limit 就是完整导出）")
    ex.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    ex.add_argument("--database", help="临时指定默认库")
    ex.add_argument("alias")
    ex.add_argument("sql")
    ex.set_defaults(func=cmd_exec)

    e = sub.add_parser("export", parents=[common], help="导出查询结果到文件")
    e.add_argument("--out", required=True, help="输出文件")
    e.add_argument("--format", choices=["csv", "json", "jsonl", "sql"], default="csv")
    e.add_argument("--limit", type=int, default=None,
                   help="行数上限；不传=不限（完整导出），0=只探测有没有数据，负数报错")
    e.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    e.add_argument("--write", action="store_true", help="本次放行 DML")
    e.add_argument("--unsafe", action="store_true", help="放行 DML+DDL")
    e.add_argument("alias")
    e.add_argument("sql")
    e.set_defaults(func=cmd_export)

    d = sub.add_parser("databases", parents=[common], help="列出库")
    d.add_argument("alias")
    d.set_defaults(func=cmd_databases)

    di = sub.add_parser("dbinfo", parents=[common], help="服务器信息：版本/当前库/编码/库清单")
    di.add_argument("alias")
    di.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    di.set_defaults(func=cmd_dbinfo)

    tb = sub.add_parser("tables", parents=[common], help="列出表")
    tb.add_argument("alias")
    tb.add_argument("--database", help="库名")
    tb.add_argument("--limit", type=int, default=None)
    tb.set_defaults(func=cmd_tables)

    co = sub.add_parser("columns", parents=[common], help="列出列定义")
    co.add_argument("alias")
    co.add_argument("table", help="表名（可带库/schema 前缀）")
    co.add_argument("--database", help="库名")
    co.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    co.set_defaults(func=cmd_columns)

    sc = sub.add_parser("schema", parents=[common], help="整库结构：表 + 列 + 索引")
    sc.add_argument("alias")
    sc.add_argument("--database", help="库名")
    sc.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)
    sc.set_defaults(func=cmd_schema)

    cf = sub.add_parser("config", parents=[common], help="配置文件相关")
    csub = cf.add_subparsers(dest="config_cmd")
    c1 = csub.add_parser("path", parents=[common], help="生效的配置文件清单")
    c1.set_defaults(func=cmd_config_path)
    c2 = csub.add_parser("show", parents=[common], help="展示合并后的最终配置")
    c2.add_argument("--reveal", action="store_true", help="显示明文密码（默认打码）")
    c2.set_defaults(func=cmd_config_show)
    c3 = csub.add_parser("init", parents=[common], help="生成配置模板")
    c3.add_argument("--project", action="store_true", help="写当前目录的 .dbbind.json")
    c3.set_defaults(func=cmd_config_init)
    c4 = csub.add_parser("validate", parents=[common], help="校验：语法/未知字段/$ENV/必填")
    c4.set_defaults(func=cmd_config_validate)
    cf.set_defaults(func=cmd_config_path)

    doc = sub.add_parser("doctor", parents=[common], help="环境与配置自检")
    doc.set_defaults(func=cmd_doctor)

    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # bindconsole 契约 §2：先扫描 --startserver，保证不影响任何既有子命令
    if "--startserver" in argv:
        set_json_mode(False)
        try:
            return start_console_mode(argv)
        except DbbindError as e:
            report_error(e)
            return e.exit_code
        except KeyboardInterrupt:
            warn("已中断")
            return 130
        except Exception as e:                 # noqa: BLE001
            sys.stderr.write("ERROR 控制台启动失败：%s\n" % e)
            return EXIT_ERR
    parser = build_parser()
    args = parser.parse_args(argv)
    # 位置参数：add/show/test/remove 里叫 name，数据命令里叫 alias —— 统一成 args.name，
    # 免得两个名字各写一半（曾经真的踩过：exec/dbinfo/tables 全部 AttributeError）
    if getattr(args, "name", None) is None and getattr(args, "alias", None) is not None:
        args.name = args.alias
    set_json_mode(bool(getattr(args, "json", False)))
    if args.version:
        if JSON_MODE:
            emit_json({"ok": True, "program": PROG, "version": VERSION})
        else:
            print("%s %s" % (PROG, VERSION))
        return EXIT_OK
    if not getattr(args, "cmd", None):
        parser.print_help()
        return EXIT_OK
    try:
        ensure_init()
        rc = args.func(args)
        return EXIT_OK if rc is None else rc
    except DbbindError as e:
        report_error(e)
        return e.exit_code
    except KeyboardInterrupt:
        warn("已中断")
        return 130
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
