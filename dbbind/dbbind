DEFAULT_CONSOLE_PORT = 8791          # dbbind 控制台默认端口（sshbind 是 8790）


def _parse_startserver_args(argv):
    """只解析 --startserver 及其参数；与其他子命令互斥（CONTRACT §2）。"""
    port = DEFAULT_CONSOLE_PORT
    host = "127.0.0.1"
    daemon = open_browser = False
    saw = False
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--startserver":
            saw = True
        elif a == "--daemon":
            daemon = True
        elif a in ("--open", "--open-browser"):
            open_browser = True
        elif a == "--port":
            i += 1
            if i >= len(argv):
                die("USAGE", "--port 需要一个端口号")
            try:
                port = int(argv[i])
            except (TypeError, ValueError):
                die("USAGE", "--port 必须是整数：%r" % argv[i])
        elif a.startswith("--port="):
            try:
                port = int(a.split("=", 1)[1])
            except (TypeError, ValueError):
                die("USAGE", "--port 必须是整数：%r" % a)
        elif a == "--host":
            i += 1
            if i >= len(argv):
                die("USAGE", "--host 需要一个地址（默认 127.0.0.1；局域网用 0.0.0.0）")
            host = argv[i]
        elif a.startswith("--host="):
            host = a.split("=", 1)[1]
        elif a in ("-h", "--help"):
            rest.append(a)
        else:
            rest.append(a)
        i += 1
    if rest:
        die("USAGE", "--startserver 与其他子命令/参数互斥：%s" % " ".join(rest),
            "用法：dbbind --startserver [--port 8791] [--host 127.0.0.1] "
            "[--daemon] [--open]")
    if not saw:
        die("USAGE", "内部错误：未检测到 --startserver")
    if not (1 <= port <= 65535):
        die("USAGE", "端口超出范围：%d" % port)
    return port, host, daemon, open_browser


def start_console_mode(argv):
    """--startserver 分支：加载内核 → 传入 handlers → 前台/后台运行。"""
    port, host, daemon, open_browser = _parse_startserver_args(argv)
    lib = bindconsole_lib()
    if not os.path.isfile(os.path.join(lib, "bindkit_console.py")):
        sys.stderr.write(
            "ERROR 找不到 bindconsole 内核：%s\n"
            "      先安装：%s\n" % (os.path.join(lib, "bindkit_console.py"),
                                   BINDCONSOLE_INSTALL_CMD))
        return EXIT_ERR
    if lib not in sys.path:
        sys.path.insert(0, lib)
    try:
        from bindkit_console import run_console
    except Exception as e:                     # noqa: BLE001
        sys.stderr.write("ERROR 加载 bindconsole 内核失败：%s\n"
                         "      重新安装：%s\n" % (e, BINDCONSOLE_INSTALL_CMD))
        return EXIT_ERR
    os.environ.setdefault("BINDCONSOLE_HOME", bindconsole_home())
    try:
        rc = run_console("db", port=port, handlers=build_console_handlers(),
                         daemon=daemon, open_browser=open_browser, host=host)
    except TypeError:
        # 老内核没有 host 参数：回环模式退化成旧签名，非回环明确报错
        if host not in ("127.0.0.1", "localhost", "::1"):
            sys.stderr.write("ERROR 当前 bindconsole 内核不支持 --host（需要重新安装）：%s\n"
                             "      重新安装：%s\n" % (host, BINDCONSOLE_INSTALL_CMD))
            return EXIT_ERR
        rc = run_console("db", port, build_console_handlers(),
                         daemon=daemon, open_browser=open_browser)
    return EXIT_OK if rc is None else int(rc)




def cmd_exec(args):
    cfg = current_config(args)
    rec = require_usable(get_entry(cfg, args.name))
    sql = args.sql
    if not sql or not sql.strip():
        die("USAGE", "请给出要执行的 SQL", 'dbbind exec %s "select 1"' % args.name)
    # 客户端元命令先挡（契约 §4.2.1b）：它不是 SQL，走引擎级防线和关键字守卫都看不见
    check_client_metacommands(sql, rec["engine"])
    write_ok = bool(args.write or args.unsafe)
    # bindconsole 策略闸门（先策略、后原只读守卫；策略上限优先于 --write/--unsafe）
    policy_rec = dict(rec, database=args.database or rec.get("database"))
    def refresh_record():
        latest = require_usable(get_entry(current_config(args), args.name))
        return dict(latest, database=args.database or latest.get("database"))
    gate = _policy_gate_db(policy_rec, sql, write_ok, bool(args.unsafe), refresh_record=refresh_record)
    gate_warnings = list(gate.get("warnings") or []) if gate else []
    if gate and gate.get("decision") in ("deny", "ask"):
        raise _raise_gate(gate)
    warnings = gate_warnings + guard_sql(rec, sql, write_ok=write_ok,
                                         unsafe=bool(args.unsafe))
    out_path = getattr(args, "out", None)
    limit = resolve_limit(cfg, args, out_path)
    res = execute_sql(rec, sql, mode="auto", timeout=args.timeout,
                      allow_write=write_ok, limit=limit, database=args.database)
    warnings.extend(res["warnings"])
    if res["truncated"] and out_path:
        warnings.append("落盘内容被 --limit %d 截断；要全量导出请去掉 --limit（落盘默认不限）"
                        % limit)
    envelope = {
        "ok": True,
        "alias": rec["name"],
        "engine": rec["engine"],
        "database": args.database or rec.get("database"),
        "sql": redact(sql),
        "columns": res["columns"],
        "rows": res["rows"],
        "row_count": res["row_count"],
        "row_count_exact": bool(res["row_count_exact"]),
        "returned": res["returned"],
        "truncated": bool(res["truncated"]),
        "limit": limit,
        "affected_rows": res["affected_rows"],
        "duration_ms": res["duration_ms"],
        "exit_code": 0,
        "warnings": warnings,
    }
    if out_path:
        fmt = args.format or "json"
        target = write_out(out_path, format_data(rec, res["columns"], res["rows"], fmt))
        envelope["out_path"] = target
        envelope["format"] = fmt
    if JSON_MODE:
        emit_json(envelope)
        return 0
    if out_path:
        ok("已输出 %d 行到 %s（%s）" % (res["returned"], envelope["out_path"],
                                       envelope["format"]))
        for w in warnings:
            warn(w)
        return 0
    sys.stdout.write(format_data(rec, res["columns"], res["rows"], args.format or "table"))
    for w in warnings:
        warn(w)
    return 0


def cmd_export(args):
    cfg = current_config(args)
    rec = require_usable(get_entry(cfg, args.name))
    fmt = args.format or "csv"
    if fmt not in ("csv", "json", "jsonl", "sql"):
        die("USAGE", "--format 只支持 csv|json|jsonl|sql（table 不适合导出）")
    check_client_metacommands(args.sql, rec["engine"])
    write_ok = bool(getattr(args, "write", False) or getattr(args, "unsafe", False))
    gate = _policy_gate_db(rec, args.sql, write_ok, bool(getattr(args, "unsafe", False)), operation="export",
        refresh_record=lambda: require_usable(get_entry(current_config(args), args.name)))
    if gate and gate.get("decision") in ("deny", "ask"):
        raise _raise_gate(gate)
    warnings = list((gate or {}).get("warnings") or []) + guard_sql(
        rec, args.sql, write_ok=write_ok, unsafe=bool(getattr(args, "unsafe", False)))
    limit = resolve_limit(cfg, args, args.out)
    res = execute_sql(rec, args.sql, mode="auto", timeout=args.timeout,
                      allow_write=write_ok, limit=limit)
    warnings.extend(res["warnings"])
    if res["truncated"]:
        warnings.append("导出被 --limit %d 截断（不完整）；要全量请去掉 --limit" % limit)
    text = format_data(rec, res["columns"], res["rows"], fmt)
    target = write_out(args.out, text)
    summary = {
        "ok": True, "alias": rec["name"], "engine": rec["engine"], "format": fmt,
        "out_path": target, "columns": res["columns"], "count": res["row_count"],
        "row_count": res["row_count"], "row_count_exact": bool(res["row_count_exact"]),
        "returned": res["returned"], "truncated": bool(res["truncated"]),
        "limit": limit, "bytes": len(text.encode("utf-8")),
        "duration_ms": res["duration_ms"], "warnings": warnings,
    }
    if JSON_MODE:
        emit_json(summary)
    else:
        ok("已导出 %d 行到 %s（%s，%d 字节）" % (res["returned"], target, fmt,
                                                summary["bytes"]))
        for w in warnings:
            warn(w)
    return 0


