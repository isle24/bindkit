        hint = "现有别名：%s" % "、".join(names) if names else \
            "还没有任何别名：写 ~/.dbbind/config.json，或 dbbind add"
        die("NOT_FOUND", "没有名为 %s 的数据库绑定" % name, hint)
    return rec


def require_usable(rec):
    if rec.get("usable"):
        register_secret(rec.get("password"))
        return rec
    reason = rec.get("usable_reason") or "配置不完整"
    code = rec.get("usable_code") or ("CLIENT_MISSING" if reason.startswith("客户端缺失")
                                      else "USAGE")
    die(code, "别名 %s 不可用：%s" % (rec["name"], reason),
        "修好后用 dbbind list --json 复查（origin=%s）" % rec.get("origin"))


