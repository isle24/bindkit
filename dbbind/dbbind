JSON_MODE = False
_SECRETS = set()


def set_json_mode(flag):
    global JSON_MODE
    JSON_MODE = bool(flag)


def _color():
    return sys.stdout.isatty() and not JSON_MODE


def human(msg=""):
    """人类可读信息：--json 时一律走 stderr，保证 stdout 只有 JSON。"""
    print(msg, file=sys.stderr if JSON_MODE else sys.stdout)


def info(msg):
    human("%s→ %s%s" % (C_DIM, msg, C_OFF) if _color() else "     " + msg)


def ok(msg):
    human("%s✅ %s%s" % (C_OK, msg, C_OFF) if _color() else "OK   " + msg)


def warn(msg):
    sys.stdout.flush()
    print("%s⚠️  %s%s" % (C_WARN, msg, C_OFF) if _color() else "WARN " + msg,
          file=sys.stderr)
    sys.stderr.flush()


def bold(msg):
    return ("%s%s%s" % (C_BOLD, msg, C_OFF)) if _color() else msg


def register_secret(value):
    if value:
        _SECRETS.add(value)


def redact(text):
    """任何要打印的文本都过一遍：密码绝不进日志/报错。"""
    if text is None:
        return text
    if not isinstance(text, str):
        text = str(text)
    for s in _SECRETS:
        if s and s in text:
            text = text.replace(s, "***")
    text = re.sub(r"(?i)(\b(?:password|identified\s+by)\s+(?:E)?)(?:'(?:''|\\.|[^'])*'|\"(?:\"\"|[^\"])*\")",
                  r"\1***", text)
    text = re.sub(r"(?i)(\b[a-z][a-z0-9+.-]*://[^\s/:@]+:)[^\s/@]+(?=@)",
                  r"\1***", text)
    text = re.sub(r"(?i)\b(password|passwd|pwd|token|secret)(\s*[:=]\s*)([^\s,;\"'}]+)",
                  r"\1\2***", text)
    return text


def emit_json(obj):
    print(json.dumps(obj, ensure_ascii=False, indent=2, default=str))


EXIT_OK, EXIT_ERR, EXIT_USAGE, EXIT_READONLY, EXIT_NOTFOUND = 0, 1, 2, 3, 4
EXIT_AUTHZ, EXIT_APPROVAL = 5, 6        # bindconsole 契约 §5.1
CODE_EXIT = {
    "USAGE": EXIT_USAGE,
    "READONLY_BLOCKED": EXIT_READONLY,
    "DDL_BLOCKED": EXIT_READONLY,
    "NOT_FOUND": EXIT_NOTFOUND,
    "AUTHZ_DENIED": EXIT_AUTHZ,
    "APPROVAL_REQUIRED": EXIT_APPROVAL,
}


class DbbindError(Exception):
    def __init__(self, code, message, hint=None, exit_code=None, extra=None):
        Exception.__init__(self, message)
        self.code = code
        self.message = message
        self.hint = hint
        self.exit_code = exit_code if exit_code is not None else CODE_EXIT.get(code, EXIT_ERR)
        self.extra = extra or {}          # 策略闸门：request_id / expires_at
        self.gate_error = False           # 人类可读输出里是否额外打印 code


def die(code, message, hint=None, exit_code=None):
    raise DbbindError(code, message, hint, exit_code)


def error_payload(code, message, hint=None, extra=None):
    err = {"code": code, "message": redact(message)}
    if hint:
        err["hint"] = redact(hint)
    for key in ("request_id", "expires_at"):
        if extra and extra.get(key):
            err[key] = extra[key]
    return {"ok": False, "error": err}


def report_error(exc):
    extra = getattr(exc, "extra", None)
    payload = error_payload(exc.code, exc.message, exc.hint, extra)
    if JSON_MODE:
        emit_json(payload)
    else:
        sys.stdout.flush()
        head = "%s❌ %s%s" % (C_ERR, payload["error"]["message"], C_OFF) if _color() \
            else "ERROR " + payload["error"]["message"]
        print(head, file=sys.stderr)
        if getattr(exc, "gate_error", False):
            # 契约 §5.1：人类可读输出也要打印 code + request_id
            print("     code: %s" % payload["error"]["code"], file=sys.stderr)
            if payload["error"].get("request_id"):
                print("     request_id: %s" % payload["error"]["request_id"],
                      file=sys.stderr)
            if payload["error"].get("expires_at"):
                print("     过期时间: %s" % payload["error"]["expires_at"],
                      file=sys.stderr)
        if exc.hint:
            print("     " + redact(exc.hint), file=sys.stderr)
        sys.stderr.flush()


class _Parser(argparse.ArgumentParser):
    """argparse 的用法错误也按契约输出（--json 时给 JSON 错误对象，退出码 2）。"""

    def error(self, message):
        if "--json" in sys.argv:
            emit_json(error_payload("USAGE", message, "用 dbbind --help 查看用法"))
            sys.exit(EXIT_USAGE)
        self.print_usage(sys.stderr)
        print("%s: error: %s" % (self.prog, message), file=sys.stderr)
        sys.exit(EXIT_USAGE)


# ---------------------------------------------------------------------------
# 容错 JSON 解析（// 与 /* */ 注释、尾随逗号；报错带 路径+行号+列号+原文）
# ---------------------------------------------------------------------------

def preprocess_jsonc(text):
    """把 JSONC 预处理成标准 JSON，同时保留「输出位置 → 原文位置」映射。

    只删注释、删尾随逗号；字符串内的内容原样保留（不会把串里的 // 当注释）。
    """
    out, mapping = [], []
    i, n = 0, len(text)
    in_str = False
    while i < n:
        ch = text[i]
        if in_str:
            out.append(ch)
            mapping.append(i)
            if ch == "\\" and i + 1 < n:
                out.append(text[i + 1])
                mapping.append(i + 1)
                i += 2
                continue
            if ch == '"':
                in_str = False
            i += 1
            continue
        if ch == '"':
            in_str = True
            out.append(ch)
            mapping.append(i)
            i += 1
            continue
        if text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        if text.startswith("/*", i):
            i += 2
            while i < n and not text.startswith("*/", i):
                if text[i] == "\n":              # 保留换行，行号才不会漂
                    out.append("\n")
                    mapping.append(i)
                i += 1
            i += 2
            continue
        out.append(ch)
        mapping.append(i)
        i += 1

    clean = "".join(out)
    clean2, map2 = [], []
    k, m = 0, len(clean)
    while k < m:
        ch = clean[k]
        if ch == ",":
            j = k + 1
            while j < m and clean[j] in " \t\r\n":
                j += 1
            if j < m and clean[j] in "}]":
                k += 1                            # 尾随逗号：丢掉
                continue
        clean2.append(ch)
        map2.append(mapping[k])
        k += 1
    return "".join(clean2), map2


def _line_col(text, idx):
    idx = max(0, min(idx, len(text)))
    line = text.count("\n", 0, idx) + 1
    start = text.rfind("\n", 0, idx) + 1
    end = text.find("\n", idx)
    if end < 0:
        end = len(text)
    snippet = text[start:end]
    if len(snippet) > 160:
        snippet = snippet[:157] + "..."
    return line, idx - start + 1, snippet


def parse_jsonc(text, path):
    """解析容错 JSON；失败时抛带 文件/行/列/原文 的 STATE_CORRUPT。"""
    clean, mapping = preprocess_jsonc(text)
    try:
        return json.loads(clean)
    except ValueError as e:
        pos = getattr(e, "pos", 0) or 0
        orig = mapping[pos] if pos < len(mapping) else len(text)
        line, col, snippet = _line_col(text, orig)
        msg = getattr(e, "msg", None) or str(e)
        die("STATE_CORRUPT",
            "配置文件语法错误：%s 第 %d 行第 %d 列\n  %s\n  %s"
            % (path, line, col, redact(snippet), redact(msg)),
            "常见笔误：少了逗号、字符串用了单引号、括号没配对")


