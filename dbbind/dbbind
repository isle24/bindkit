def cmd_test(args):
    cfg = current_config(args)
    names = [args.name] if args.name else sorted(cfg["entries"])
    if not names:
        die("NOT_FOUND", "还没有配置任何数据库", "先写 ~/.dbbind/config.json 或 dbbind add")
    results, failed = [], 0
    for name in names:
        rec = cfg["entries"].get(name)
        if not rec:
            results.append({"name": name, "ok": False, "code": "NOT_FOUND",
                            "message": "没有这个别名"})
            failed += 1
            continue
        if not rec.get("usable"):
            failed += 1
            results.append({"name": name, "engine": rec.get("engine"),
                            "via": rec.get("via"), "ok": False, "code": "USAGE",
                            "message": rec.get("usable_reason") or "配置不完整"})
            if not JSON_MODE:
                human("  %-18s 跳过  %s" % (name, rec.get("usable_reason")))
            continue
        register_secret(rec.get("password"))
        try:
            res = execute_sql(rec, "select 1", mode="query", timeout=args.timeout)
            results.append({"name": name, "engine": rec.get("engine"),
                            "via": rec.get("via"), "ok": True,
                            "duration_ms": res["duration_ms"], "message": "OK"})
            if not JSON_MODE:
                human("  %-18s 连通  %s  %sms" % (name, rec.get("via"),
                                                  res["duration_ms"]))
        except DbbindError as e:
            failed += 1
            results.append({"name": name, "engine": rec.get("engine"),
                            "via": rec.get("via"), "ok": False, "code": e.code,
                            "message": redact(e.message)})
            if not JSON_MODE:
                human("  %-18s 失败  %s" % (name, redact(e.message)))
    passed = len(results) - failed
    if JSON_MODE:
        emit_json({"ok": failed == 0, "count": len(results), "passed": passed,
                   "failed": failed, "results": results})
    else:
        human()
        human("  %s" % (C_OK + "全部 %d 个连通正常" % len(results) + C_OFF) if not failed
              else "  %s" % (C_WARN + "%d/%d 不可用" % (failed, len(results)) + C_OFF))
        human()
    return 0 if failed == 0 else EXIT_ERR


def cmd_remove(args):
    cfg = current_config(args)
    rec = get_entry(cfg, args.name)
    if rec.get("origin") == "config":
        die("USAGE", "别名 %s 来自配置文件，dbbind remove 不会删除它" % args.name,
            "请直接编辑配置文件：%s" % (rec.get("config_file") or GLOBAL_CONFIG))
    state = load_state()
    if args.name not in state["databases"]:
        die("NOT_FOUND", "别名 %s 不在 %s 里" % (args.name, STATE_FILE))
    extra = None
    if rec.get("origin") == "merged":
        extra = ("该别名同时来自配置文件 %s；删掉 databases.json 里的记录后，"
                 "它仍会按配置文件的定义生效" % rec.get("config_file"))
    if not args.yes:
        if not sys.stdin.isatty():
            die("USAGE", "非交互式终端，请加 --yes 确认",
                "dbbind remove %s --yes" % args.name)
        human()
        human("  即将删除绑定 %s（%s）" % (bold(args.name), entry_summary(rec)))
        human("  " + "-" * 46)
        human("   · 从 %s 移除该条目" % STATE_FILE)
        if extra:
            human("   · %s" % extra)
        human("   · 不影响数据库服务器上的任何数据")
        human()
        try:
            ans = input("  确认删除？输入 yes 继续: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            ans = ""
        if ans != "yes":
            human("  已取消，未做任何改动")
            return 0
    state["databases"].pop(args.name, None)
    save_state(state)
    result = {"ok": True, "alias": args.name, "removed": True, "path": STATE_FILE}
    if extra:
        result["note"] = extra
    if JSON_MODE:
        emit_json(result)
    else:
        ok("已删除绑定 %s" % args.name)
        if extra:
            warn(extra)
    return 0


def resolve_limit(cfg, args, out_path=None):
    """生效的 limit：None=不限，0=只探测是否有数据，N>0=最多返回 N 行。

    规则（CONTRACT §3.2）：
      * 显式 --limit N：以它为准；负数报 USAGE
      * 写 stdout：取配置 defaults.limit（默认 1000，保护 AI 上下文）
      * 写 --out 文件：默认不限（导出意图就是完整 dump）
    """
    limit = getattr(args, "limit", None)
    if limit is not None:
        limit = int(limit)
        if limit < 0:
            die("USAGE", "--limit 不能是负数：%d" % limit,
                "0 = 只探测有没有数据；要全量请写 --out（落盘默认不限）")
        return limit
    if out_path:
        return None
    try:
        return int(cfg["defaults"].get("limit", DEFAULT_LIMIT))
    except (TypeError, ValueError):
        return DEFAULT_LIMIT


# ---------------------------------------------------------------------------
# bindconsole：策略闸门 + 本机 Web 控制台（CONTRACT bindconsole §3/§4/§8）
# ---------------------------------------------------------------------------

BINDCONSOLE_INSTALL_CMD = "curl -fsSL https://github.com/isle24/bindkit/releases/latest/download/install.sh | bash"
_POLICY_MODULE = None


def bindconsole_home():
    return (os.environ.get("BINDCONSOLE_HOME")
            or os.path.join(os.path.expanduser("~"), ".bindconsole"))


def bindconsole_lib():
    return os.path.join(bindconsole_home(), "lib")


def load_policy_module(required=False):
    """从 ~/.bindconsole/lib 加载策略模块（单一真源）。

    未安装 → exec 闸门 fail-open（契约 §1：无策略文件=维持原行为），
    但 --startserver 必须报明确错误并给安装命令。
    """
    global _POLICY_MODULE
    if _POLICY_MODULE is not None:
        return _POLICY_MODULE
    lib = bindconsole_lib()
    if os.path.isdir(lib) and lib not in sys.path:
        sys.path.insert(0, lib)
    try:
        import bindkit_policy as mod
        _POLICY_MODULE = mod
        return mod
    except Exception as e:                     # noqa: BLE001
        if required:
            die("UNSUPPORTED", "找不到 bindconsole 内核：%s（%s）" % (lib, e),
                "先安装：%s" % BINDCONSOLE_INSTALL_CMD)
        # CONTRACT §8.1.1 的 fail-closed 边界（显式写在这里，别改成一律放行）：
        #   * policy.json 不存在  + 模块缺失 → allow（用户本就没设限，保持兼容）
        #   * policy.json 存在    + 模块缺失 → deny STATE_CORRUPT（否则已配的限制形同虚设）
        policy_path = os.path.join(os.path.expanduser("~"), ".dbbind", "policy.json")
        if os.path.exists(policy_path):
            exc = DbbindError(
                "STATE_CORRUPT",
                "策略文件存在但 bindconsole 内核缺失/无法加载，已按 fail-closed 拒绝",
                "重新安装内核：%s（加载错误：%s）" % (BINDCONSOLE_INSTALL_CMD, e))
            exc.gate_error = True
            raise exc
        return None


def _policy_gate_db(rec, sql, requested_write, requested_unsafe, operation="exec", refresh_record=None):
    """Deterministic policy first; optional AI can only fill its pending approval."""
    # Apply command flags before a gate can consume a previously approved request.
    check_client_metacommands(sql, rec["engine"])
    guard_sql(rec, sql, write_ok=requested_write, unsafe=requested_unsafe)
    mod = load_policy_module()
    if mod is None:
        return None
    try:
        try:
            import bindkit_orchestration as orchestration
        except ImportError:
            orchestration = None
        context = {"connection": orchestration.connection_context(rec, "db"), "operation": operation} if orchestration else None
        checked = False
        def recheck():
            nonlocal checked
            if checked and refresh_record is not None:
                latest = refresh_record()
                if orchestration.connection_context(latest, "db") != context["connection"]:
                    return {"decision": "deny", "code": "CONNECTION_CHANGED", "message": "数据库连接已变化，请重新提交并审核。"}
                # A changed local read-only flag can tighten access independently of policy.json.
                guard_sql(latest, sql, write_ok=requested_write, unsafe=requested_unsafe)
            checked = True
            return mod.gate_db(rec["name"], sql, rec.get("engine") or "mysql",
                rec.get("database") if rec.get("engine") != "sqlite" else None,
                requested_write=requested_write, requested_unsafe=requested_unsafe,
                requester="ai", **({"context": context} if context is not None else {}))
        gate = recheck()
        if gate.get("decision") == "ask" and orchestration:
            # Existing DML/DDL flags and read-only guard remain hard requirements.
            try:
                check_client_metacommands(sql, rec["engine"])
                guard_sql(rec, sql, write_ok=requested_write, unsafe=requested_unsafe)
            except DbbindError:
                return gate
            review_context = {"policy_revision": mod.policy_revision("db"), "operation": operation,
                "resource": {"alias": rec["name"], **{field: rec.get(field) for field in ("engine", "host", "port", "user", "database")}},
                "target_user": rec.get("user"), "target_uid": None,
                "effective_level": mod.sql_required_level(sql, rec.get("engine") or "mysql"),
                "hard_allowed": True, "protected": orchestration.protected_operation(sql) or bool(context["connection"].get("transport_requires_human")), "sql": sql}
            gate = orchestration.review_gate("db", gate, review_context, mod, recheck)
        return gate
    except Exception:
        return {"decision": "deny", "code": "AUTHZ_DENIED",
                "message": "策略校验内部错误，已按 fail-closed 拒绝",
                "hint": "查看 ~/.bindconsole/audit.log"}


def _policy_entry_warnings(engine, name):
    """从策略里取「易用性提示」（不阻断执行），例如 PG schema 未收口的提醒。"""
    mod = load_policy_module()
    if mod is None:
        return []
    try:
        pol = mod.read_policy("db")
        if not pol.get("exists") or pol.get("corrupt"):
            return []
        eff = mod.effective_db_policy(pol.get("data") or {}, name)
        return list(mod.policy_warnings(engine, eff))
    except Exception:                          # noqa: BLE001 —— 提示失败不影响主流程
        return []


def _raise_gate(gate):
    """把闸门结果转成 DbbindError（带 request_id/expires_at 额外字段）。"""
    code = gate.get("code") or "AUTHZ_DENIED"
    exc = DbbindError(code, gate.get("message") or "授权校验未通过",
                      gate.get("hint"), CODE_EXIT.get(code, EXIT_ERR))
    exc.gate_error = True
    extra = {}
    if gate.get("request_id"):
        extra["request_id"] = gate["request_id"]
    if gate.get("expires_at"):
        extra["expires_at"] = gate["expires_at"]
    exc.extra = extra
    return exc


# ---- 控制台 handlers（内核只做 HTTP/认证/CSRF，这里操作工具真实状态）-----------

_CONSOLE_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


# 业务错误码 → HTTP 状态（内核会把 ConsoleError.status 原样映射）
_CONSOLE_STATUS = {"NOT_FOUND": 404, "CONFLICT": 409, "ALREADY_EXISTS": 409,
                   "INVALID_REQUEST": 400, "INVALID_PARAM": 400}


def _console_fail(message, code="INVALID_REQUEST", hint=None):
    """抛给内核的四类错误：优先用内核的 ConsoleError（带精确 4xx），否则 ValueError。"""
    status = _CONSOLE_STATUS.get(code, 400)
    try:
        from bindkit_console import ConsoleError
        return ConsoleError(code, message, hint, status=status)
    except Exception:                          # noqa: BLE001
        return ValueError(message)


def _console_validate_name(name):
    name = str(name or "").strip()
    if not _CONSOLE_NAME_RE.match(name) or ".." in name:
        raise _console_fail("别名不合法（只允许字母数字._-，且不能以符号开头）")
    return name


def _console_policy_module():
    mod = load_policy_module()
    if mod is None:
        raise _console_fail("bindconsole 内核未安装，无法读写策略", "INTERNAL",
                            "先执行：%s" % BINDCONSOLE_INSTALL_CMD)
    return mod


def _console_db_policy_map(mod):
    pol = mod.read_policy("db")
    return (pol.get("data") or {}) if pol.get("exists") and not pol.get("corrupt") else {}


def _console_db_item(name, rec, mod):
    e = public_entry(rec)
    eff = mod.effective_db_policy(_console_db_policy_map(mod), name) if mod else None
    return {
        "alias": name,
        "engine": e["engine"],
        "host": e["host"],
        "port": e["port"],
        "user": e["user"],
        "database": e["database"],
        "file": e["file"],
        "via": e["via"],
        "via_ssh": e["via_ssh"],
        "docker_exec": e["docker_exec"],
        "origin": e["origin"],
        "usable": e["usable"],
        "usable_reason": e["usable_reason"],
        "has_password": e["has_password"],
        "read_only": e["read_only"],
        "max_level": eff["max_level"] if eff else "read",
        "allowed_databases": eff["allowed_databases"] if eff else None,
        "allowed_tables": eff["allowed_tables"] if eff else None,
        "allowed_schemas": eff["allowed_schemas"] if eff else None,
        "allow_metadata": eff["allow_metadata"] if eff else True,
        "approval": eff["approval"] if eff else {"write": False, "ddl": True},
        "warnings": list(e["warnings"] or []) +
                    _policy_entry_warnings(e["engine"], name),
    }


def console_db_list():
    cfg = load_effective_config()
    mod = load_policy_module()
    return {"items": [_console_db_item(n, cfg["entries"][n], mod)
                      for n in sorted(cfg["entries"])]}


def console_db_get(name):
    name = _console_validate_name(name)
    cfg = load_effective_config()
    if name not in cfg["entries"]:
        raise _console_fail("没有这个别名：%s" % name, "NOT_FOUND")
    return _console_db_item(name, cfg["entries"][name], load_policy_module())


def console_db_create(body):
    if not isinstance(body, dict):
        raise _console_fail("请求体必须是 JSON 对象")
    name = _console_validate_name(body.get("alias") or body.get("name"))
    engine = str(body.get("engine") or "").strip().lower()
    if engine not in ENGINE_NAMES:
        raise _console_fail("engine 必须是 mysql/postgres/sqlite")
    state = load_state()
    if name in state["databases"]:
        raise _console_fail("别名已存在：%s" % name, "CONFLICT")
    # 配置文件里的别名也算已存在（控制台不该静默遮蔽它）
    if name in load_effective_config()["entries"]:
        raise _console_fail("别名已存在（来自配置文件）：%s" % name, "CONFLICT")
    policy_entry = _console_clean_policy_entry(body)
    now = datetime.now().isoformat(timespec="seconds")
    rec = {"name": name, "engine": engine,
           "host": None, "port": None, "user": None, "password": None,
           "database": None, "file": None, "via_ssh": None, "docker_exec": None,
           "read_only": True, "created_at": now, "source": "console", "origin": "state"}
    if body.get("read_only") is False or body.get("allow_write") is True:
        rec["read_only"] = False
    if engine == "sqlite":
        path = str(body.get("file") or "").strip()
        if not path:
            raise _console_fail("sqlite 必须提供 file")
        rec["file"] = os.path.abspath(os.path.expanduser(path))
    else:
        host = str(body.get("host") or "").strip()
        user = str(body.get("user") or "").strip()
        if not host:
            raise _console_fail("%s 必须提供 host" % engine)
        if not user:
            raise _console_fail("%s 必须提供 user" % engine)
        rec["host"] = host
        rec["user"] = user
        port = body.get("port")
        try:
            rec["port"] = int(port) if port not in (None, "") else DEFAULT_PORTS[engine]
        except (TypeError, ValueError):
            raise _console_fail("port 必须是整数")
        rec["database"] = str(body.get("database") or "").strip() or None
        password = body.get("password")
        if isinstance(password, str) and password != "":
            rec["password"] = password
    for opt in ("via_ssh", "docker_exec"):
        val = body.get(opt)
        if isinstance(val, str) and val.strip():
            rec[opt] = val.strip()
    register_secret(rec.get("password"))
    # 先校验并保存授权，再登记连接；策略写失败时不能留下不受限的新别名。
    if policy_entry:
        _console_policy_put({"databases": {name: policy_entry}})
    state["databases"][name] = rec
    save_state(state)
    return {"ok": True, "alias": name, "engine": engine}


def console_db_update(name, body):
    name = _console_validate_name(name)
    if not isinstance(body, dict):
        raise _console_fail("请求体必须是 JSON 对象")
    state = load_state()
    changed = []
    policy_keys = ("max_level", "allowed_databases", "allowed_tables",
                   "allowed_schemas", "allow_metadata", "approval", "approval_ttl_s")
    policy_entry = _console_clean_policy_entry({k: body[k] for k in policy_keys if k in body})
    if name in state["databases"]:
        rec = state["databases"][name]
        if rec.get("engine") == "sqlite" and isinstance(body.get("file"), str) \
                and body["file"].strip():
            rec["file"] = os.path.abspath(os.path.expanduser(body["file"].strip()))
            changed.append("file")
        for key in ("host", "user", "database", "via_ssh", "docker_exec"):
            if key in body and body[key] is not None:
                val = body[key]
                val = val.strip() if isinstance(val, str) else val
                if val != "":                 # 留空 = 不改
                    rec[key] = val
                    changed.append(key)
        if "port" in body and body["port"] not in (None, ""):
            try:
                rec["port"] = int(body["port"])
                changed.append("port")
            except (TypeError, ValueError):
                raise _console_fail("port 必须是整数")
        if "read_only" in body and body["read_only"] is not None:
            rec["read_only"] = bool(body["read_only"])
            changed.append("read_only")
        if isinstance(body.get("password"), str) and body["password"] != "":
            rec["password"] = body["password"]
            register_secret(rec["password"])
            changed.append("password")
        if changed:
            state["databases"][name] = rec
    else:
        cfg = load_effective_config()
        if name not in cfg["entries"]:
            raise _console_fail("没有这个别名：%s" % name, "NOT_FOUND")
        if any(k in body and body[k] not in (None, "")
               for k in ("host", "user", "database", "port", "password", "file",
                          "via_ssh", "docker_exec", "read_only")):
            raise _console_fail("别名 %s 来自配置文件，不能在控制台改连接参数"
                                "（请编辑配置文件；策略字段仍可改）" % name, "CONFLICT")
    # 策略字段（任何别名都可改）
    if policy_entry:
        _console_policy_put({"databases": {name: policy_entry}})
    if changed:
        save_state(state)
    return {"ok": True, "alias": name, "changed": changed}


def console_db_delete(name, body=None):
    name = _console_validate_name(name)
    state = load_state()
    if name not in state["databases"]:
        cfg = load_effective_config()
        if name in cfg["entries"]:
            raise _console_fail("别名 %s 来自配置文件，控制台删不掉它；"
                                "请直接编辑配置文件" % name, "CONFLICT")
        raise _console_fail("没有这个别名：%s" % name, "NOT_FOUND")
    state["databases"].pop(name, None)
    save_state(state)
    return {"ok": True, "deleted": name}


def console_db_test(name):
    name = _console_validate_name(name)
    cfg = load_effective_config()
    rec = cfg["entries"].get(name)
    if not rec:
        raise _console_fail("没有这个别名：%s" % name, "NOT_FOUND")
    if not rec.get("usable"):
        return {"ok": False, "usable": False,
                "message": rec.get("usable_reason") or "不可用"}
    register_secret(rec.get("password"))
    try:
        res = execute_sql(rec, "select 1", mode="query", timeout=15)
        return {"ok": True, "usable": True, "duration_ms": res["duration_ms"],
                "via": rec.get("via")}
    except DbbindError as e:
        return {"ok": False, "usable": False, "message": redact(e.message)}


def _console_sanitize_db_policy(payload):
    """校验/规范化 db 策略，返回可写入的新策略 dict。"""
    if not isinstance(payload, dict):
        raise _console_fail("策略必须是 JSON 对象")
    out = {"version": 1, "defaults": {}, "databases": {}}
    defaults = payload.get("defaults") if isinstance(payload.get("defaults"), dict) else {}
    out["defaults"] = _console_clean_policy_entry(defaults, is_defaults=True)
    dbs = payload.get("databases") if isinstance(payload.get("databases"), dict) else {}
    for alias, entry in dbs.items():
        if not _CONSOLE_NAME_RE.match(str(alias or "")) or ".." in str(alias):
            raise _console_fail("策略里的别名不合法：%r" % (alias,))
        if not isinstance(entry, dict):
            raise _console_fail("别名 %s 的策略必须是对象" % alias)
        out["databases"][str(alias)] = _console_clean_policy_entry(entry)
    return out


def _console_clean_policy_entry(entry, is_defaults=False):
    clean = {}
    if "max_level" in entry:
        level = str(entry.get("max_level") or "").lower()
        if level not in LEVELS_FOR_POLICY:
            raise _console_fail("max_level 必须是 read/write/ddl：%r" % entry.get("max_level"))
        clean["max_level"] = level
    if "approval" in entry:
        approval = entry.get("approval")
        if not isinstance(approval, dict):
            raise _console_fail("approval 必须是对象，如 {\"write\": true, \"ddl\": true}")
        clean["approval"] = {k: bool(approval.get(k, False)) for k in ("write", "ddl")
                             if k in approval}
    if "allowed_databases" in entry:
        val = entry["allowed_databases"]
        if val is None:
            clean["allowed_databases"] = None
        elif isinstance(val, list):
            clean["allowed_databases"] = [str(x).strip() for x in val if str(x).strip()]
        else:
            raise _console_fail("allowed_databases 必须是 null 或字符串数组")
    if "allowed_tables" in entry:
        val = entry["allowed_tables"]
        if val is None:
            clean["allowed_tables"] = None
        elif isinstance(val, list):
            clean["allowed_tables"] = [str(x).strip() for x in val if str(x).strip()]
        else:
            raise _console_fail("allowed_tables 必须是 null 或字符串数组")
    if "allowed_schemas" in entry:
        val = entry["allowed_schemas"]
        if val is None:
            clean["allowed_schemas"] = None
        elif isinstance(val, list):
            clean["allowed_schemas"] = [str(x).strip() for x in val if str(x).strip()]
        else:
            raise _console_fail("allowed_schemas 必须是 null 或字符串数组")
    if "allow_metadata" in entry:
        clean["allow_metadata"] = bool(entry["allow_metadata"])
    if "approval_ttl_s" in entry:
        try:
            ttl = int(entry["approval_ttl_s"])
        except (TypeError, ValueError):
            raise _console_fail("approval_ttl_s 必须是整数")
        clean["approval_ttl_s"] = max(60, min(86400, ttl))
    return clean


LEVELS_FOR_POLICY = ("read", "write", "ddl")


def _console_policy_put(body):
    mod = _console_policy_module()
    current = mod.read_policy("db")
    base = (current.get("data") or {}) if current.get("exists") and not current.get("corrupt") \
        else mod.default_policy("db")
    merged = json.loads(json.dumps(base))
    merged.setdefault("defaults", {})
    merged.setdefault("databases", {})
    if isinstance(body, dict) and isinstance(body.get("defaults"), dict):
        merged["defaults"].update(body["defaults"])
    if isinstance(body, dict) and isinstance(body.get("databases"), dict):
        for alias, entry in body["databases"].items():
            if alias not in merged["databases"] or not isinstance(merged["databases"][alias], dict):
                merged["databases"][alias] = {}
            merged["databases"][alias].update(entry or {})
    # 整体也允许直接 PUT 完整策略（有 version/defaults/databases 三键之一即可）
    if isinstance(body, dict) and ("defaults" in body or "databases" in body):
        clean = _console_sanitize_db_policy(merged)
        mod.write_policy("db", clean)
        return {"ok": True, "path": mod.tool_paths("db")["policy"]}
    raise _console_fail("策略请求体需要包含 defaults 或 databases")


def console_db_policy_get():
    mod = _console_policy_module()
    summary = mod.policy_summary("db")
    summary["effective"] = {
        alias: mod.effective_db_policy(summary.get("policy") or {}, alias)
        for alias in list((summary.get("policy") or {}).get("databases", {}))
    }
    return summary


def console_db_policy_put(body):
    return _console_policy_put(body)


def build_console_handlers():
    """给 bindkit_console.run_console 的 handlers（CONTRACT §7.1.1 冻结形状）。"""
