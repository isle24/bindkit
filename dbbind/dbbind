def find_project_config(start=None):
    """从 cwd 逐级向上找第一个 .dbbind.json。"""
    d = os.path.abspath(start or os.getcwd())
    while True:
        p = os.path.join(d, PROJECT_CONFIG_NAME)
        if os.path.isfile(p):
            return p
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def config_sources(explicit=None, cwd=None):
    """按优先级从低到高返回 [(path, kind)]。"""
    src = [(GLOBAL_CONFIG, "global")]
    proj = find_project_config(cwd)
    if proj:
        src.append((proj, "project"))
    src.append((STATE_FILE, "state"))
    extra = explicit or os.environ.get(CONFIG_ENV)
    if extra:
        src.append((os.path.abspath(os.path.expanduser(extra)), "extra"))
    return src


def _split_db_payload(payload, path, kind):
    """把一份配置文件拆成 (defaults, aliases, unknown_fields)。"""
    defaults, aliases, unknown = {}, {}, []
    if payload is None:
        return defaults, aliases, unknown
    if not isinstance(payload, dict):
        die("STATE_CORRUPT", "配置文件顶层必须是 JSON 对象：%s" % path,
            '示例：{"version": 1, "databases": {"别名": {...}}}')
    for key in payload:
        if key not in KNOWN_TOP_FIELDS:
            unknown.append("%s: 顶层未知字段 %r（已知：version/defaults/databases）"
                           % (path, key))
    d = payload.get("defaults")
    if isinstance(d, dict):
        for key, val in d.items():
            if key in KNOWN_DEFAULT_FIELDS:
                defaults[key] = val
            else:
                unknown.append("%s: defaults 里未知字段 %r（已知：read_only/limit）"
                               % (path, key))
    elif d is not None:
        unknown.append("%s: defaults 应该是对象" % path)
    dbs = payload.get("databases")
    if dbs is None:
        dbs = {}
    if not isinstance(dbs, dict):
        die("STATE_CORRUPT", "配置文件里的 databases 必须是对象：%s" % path,
            '形如 "databases": { "别名": { "engine": "mysql", ... } }')
    for alias, item in dbs.items():
        if not isinstance(item, dict):
            unknown.append("%s: 别名 %r 的值不是对象，已忽略" % (path, alias))
            continue
        bad_keys = []
        for key in item:
            if key not in KNOWN_DB_FIELDS:
                bad_keys.append(key)
                unknown.append("%s: 别名 %r 的未知字段 %r（已忽略，可能是拼错了；已知：%s）"
                               % (path, alias, key, "/".join(sorted(KNOWN_DB_FIELDS))))
        rec = dict(item)
        rec["_file"] = path
        rec["_unknown"] = bad_keys
        aliases[alias] = rec
    return defaults, aliases, unknown


def load_effective_config(explicit=None, cwd=None):
    """统一配置入口：多层加载 + 字段级合并 + $ENV 展开。

    优先级（低 → 高）：引擎默认值 < ~/.dbbind/config.json < 项目 .dbbind.json
                     < ~/.dbbind/databases.json < $DBBIND_CONFIG / --config
    """
    files = []
    merged = {}              # 别名 → 字段 → (值, 文件路径, kind)
    merged_defaults = {}
    unknown_fields = []
    unknown_by_alias = {}    # 别名 → [(字段/描述, 文件)]：进 list --json 的 warnings[]
    missing_env = []         # [(别名, 字段, 变量名)]
    explicit_path = os.path.abspath(os.path.expanduser(explicit)) if explicit else None

    for path, kind in config_sources(explicit_path, cwd):
        meta = {"path": path, "kind": kind, "exists": False, "readable": False,
                "aliases": [], "error": None, "unknown_fields": [], "defaults": {}}
        files.append(meta)
        if not os.path.exists(path):
            if kind == "extra":
                die("NOT_FOUND", "指定的配置文件不存在：%s" % path,
                    "检查 --config / $%s 指向的路径" % CONFIG_ENV)
            continue
        meta["exists"] = True
        if not os.access(path, os.R_OK):
            meta["error"] = "不可读"
            if kind == "extra":
                die("STATE_CORRUPT", "配置文件不可读：%s" % path)
            continue
        meta["readable"] = True
        try:
            with open(path, "r", encoding="utf-8") as f:
                text = f.read()
        except OSError as e:
            meta["error"] = redact(str(e))
            continue
        payload = parse_jsonc(text, path)
        defaults, aliases, unknown = _split_db_payload(payload, path, kind)
        meta["defaults"] = defaults
        meta["aliases"] = sorted(aliases)
        meta["unknown_fields"] = unknown
        unknown_fields.extend(unknown)
        merged_defaults.update(defaults)          # 后加载的覆盖前者
        file_level = [u for u in unknown if ("别名" not in u)]
        for alias, item in aliases.items():
            slot = merged.setdefault(alias, {})
            for key, val in item.items():
                if key == "_file":
                    continue
                if key == "_unknown":
                    unknown_by_alias.setdefault(alias, []).extend((f, path) for f in val)
                    continue
                slot[key] = (val, path, kind)     # 显式出现的字段才覆盖
            for u in file_level:
                unknown_by_alias.setdefault(alias, []).append((u, path))

    defaults = {"read_only": True, "limit": DEFAULT_LIMIT}
    defaults.update(merged_defaults)

    entries = {}
    for alias, slot in merged.items():
        raw, sources = {}, {}
        for key, (val, path, kind) in slot.items():
            if key == "_file":
                continue
            raw[key] = val
            sources[key] = (path, kind)
        entries[alias] = resolve_entry(alias, raw, sources, defaults, missing_env,
                                       unknown_by_alias.get(alias, []))
    return {
        "defaults": defaults,
        "entries": entries,
        "files": files,
        "unknown_fields": unknown_fields,
        "missing_env": missing_env,
        "explicit_config": explicit_path,
    }


def _as_bool(val, default=True):
    if isinstance(val, bool):
        return val
    if isinstance(val, (int, float)):
        return bool(val)
    if isinstance(val, str):
        s = val.strip().lower()
        if s in ("true", "yes", "on", "1"):
            return True
        if s in ("false", "no", "off", "0"):
            return False
    return default


def resolve_entry(alias, raw, sources, defaults, missing_env, unknown_fields=None):
    """合并后的原始字段 → 可执行条目（补默认值、展开 $ENV、判定 usable）。"""
    warnings = []
    seen_unknown = set()
    for field, path in (unknown_fields or []):
        if field in seen_unknown:
            continue
        seen_unknown.add(field)
        if "别名" in field or "未知字段" in field:
            warnings.append(field)             # 已经是完整描述
        else:
            warnings.append("配置文件 %s 里存在未知字段 %r（已忽略，可能是拼错了）"
                            % (path, field))
    kinds = {sources[k][1] for k in sources}
    origin = "state" if kinds == {"state"} else ("merged" if "state" in kinds else "config")
    # config_file：定义了这个别名的最高优先级非 state 文件
    config_file = None
    for key in ("engine", "host", "file", "port", "user", "password", "database",
                "via_ssh", "docker_exec", "read_only", "name"):
        if key in sources and sources[key][1] != "state":
            config_file = sources[key][0]
            break

    missing_here = []
    vals = {}
    for key, val in raw.items():
        vals[key] = expand_env(val, missing_here, key) if isinstance(val, str) else val
    for field, name in missing_here:
        missing_env.append((alias, field, name))

    engine = vals.get("engine")
    engine = engine.strip().lower() if isinstance(engine, str) else None
    if engine not in ENGINE_NAMES:
        return _make_entry(alias, vals, origin, config_file, warnings, missing_here,
                           defaults, False,
                           "engine 取值非法：%r（只能是 %s）"
                           % (raw.get("engine"), "|".join(ENGINE_NAMES)))

    port = vals.get("port")
    if port in (None, ""):
        port = DEFAULT_PORTS.get(engine)
    else:
        try:
            port = int(port)
        except (TypeError, ValueError):
            port = DEFAULT_PORTS.get(engine)

    read_only = defaults.get("read_only", True)
    if vals.get("read_only") is not None:
        read_only = _as_bool(vals["read_only"], read_only)

    via_ssh = vals.get("via_ssh") or None
    docker_exec = vals.get("docker_exec") or None
    user = vals.get("user") or None
    host = vals.get("host") or None
    database = vals.get("database") or None
    password = vals.get("password")
    if password is not None and not isinstance(password, str):
        password = str(password)

    file_path = vals.get("file") or None
    if engine == "sqlite" and file_path:
        if not (via_ssh or docker_exec):
            file_path = os.path.abspath(os.path.expanduser(str(file_path)))
        elif str(file_path).startswith("~"):
            warnings.append("远端 sqlite 路径不做 ~ 展开（由远端解释）：%s" % file_path)

    missing_fields = []
    if engine in ("mysql", "postgres"):
        if not host:
            missing_fields.append("host")
        if not user:
            missing_fields.append("user")
    if engine == "sqlite" and not file_path:
        missing_fields.append("file")

    if missing_here:
        names = "、".join(sorted({"$%s" % n for _, n in missing_here}))
        reason = "环境变量 %s 未设置（配置文件里引用了它）" % names
    elif missing_fields:
        reason = "配置缺少必填字段：%s" % "、".join(missing_fields)
    else:
        reason = None

    via = "docker" if docker_exec else ("ssh" if via_ssh else "local")
    client_found, client_path, client_reason = resolve_runner(engine, via)
    if reason is None and not client_found:
        reason = client_reason
        usable_code = "CLIENT_MISSING"
    usable_code = "USAGE"
    if reason is None and engine == "sqlite" and via == "local" and not os.path.isfile(file_path):
        reason = ("sqlite 数据库文件不存在：%s（先创建它，或指向已有文件）" % file_path)
        usable_code = "CONNECT_FAILED"

    if engine == "sqlite":
        host = port = user = password = None

    has_password = bool(password)
    if any(field == "password" for field, _ in missing_here):
        has_password = False
    entry = _make_entry(alias, vals, origin, config_file, warnings, missing_here,
                        defaults, reason is None, reason)
    entry["usable_code"] = usable_code
    entry.update({
        "engine": engine, "host": host, "port": port, "user": user,
        "password": password, "database": database, "file": file_path,
        "via_ssh": via_ssh, "docker_exec": docker_exec,
        "read_only": bool(read_only), "via": via,
        "created_at": vals.get("created_at"), "source": vals.get("source"),
        "has_password": has_password, "client_found": bool(client_found),
        "client_path": client_path,
    })
    return entry


def _make_entry(alias, vals, origin, config_file, warnings, missing_here, defaults,
                usable, reason):
    return {
        "name": alias,
        "engine": vals.get("engine"),
        "host": vals.get("host"),
        "port": vals.get("port"),
        "user": vals.get("user"),
        "password": vals.get("password"),
        "database": vals.get("database"),
        "file": vals.get("file"),
        "via_ssh": vals.get("via_ssh"),
        "docker_exec": vals.get("docker_exec"),
        "read_only": bool(defaults.get("read_only", True)),
        "via": "docker" if vals.get("docker_exec") else
               ("ssh" if vals.get("via_ssh") else "local"),
        "created_at": vals.get("created_at"),
        "source": vals.get("source"),
        "origin": origin,
        "config_file": config_file,
        "has_password": bool(vals.get("password")),
        "client_found": False,
        "client_path": None,
        "usable": bool(usable),
        "usable_reason": reason,
        "warnings": list(warnings),
        "missing_env": ["$%s" % n for _, n in missing_here],
    }


# ---------------------------------------------------------------------------
# 客户端 / 通道发现
# ---------------------------------------------------------------------------

_CLIENT_CACHE = {}


def find_client(engine):
    """返回 (路径 or None, 尝试过的位置列表)。$ENV 优先，其次常见前缀，最后 PATH。"""
    if engine in _CLIENT_CACHE:
        return _CLIENT_CACHE[engine]
    tried = []
    env_var = ENV_CLIENT.get(engine)
    override = os.environ.get(env_var) if env_var else None
    if override:
        tried.append("%s ($%s)" % (override, env_var))
        p = os.path.expanduser(override)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            _CLIENT_CACHE[engine] = (p, tried)
            return p, tried
    for cand in CLIENT_CANDIDATES.get(engine, []):
        tried.append(cand)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            _CLIENT_CACHE[engine] = (cand, tried)
            return cand, tried
    name = CLIENT_NAMES.get(engine)
    wh = shutil.which(name) if name else None
    tried.append("$PATH 里的 %s" % name)
    _CLIENT_CACHE[engine] = (wh, tried)
    return wh, tried


def resolve_runner(engine, via):
    """判定执行通道是否可用 → (found, path, reason)。

    本地通道看引擎客户端；ssh / docker 通道看传输工具（客户端在远端/容器里，
    本地无从检查），找不到时给出可执行的原因写进 usable_reason。
    """
    if via == "local":
        path, _ = find_client(engine)
        if path:
            return True, path, None
        pkg = "mysql-client" if engine == "mysql" else ("libpq" if engine == "postgres"
                                                        else "sqlite")
        return False, None, ("客户端缺失：找不到 %s，可 brew install %s（或用 $%s 指定路径）"
                             % (CLIENT_NAMES[engine], pkg, ENV_CLIENT.get(engine)))
    if via == "ssh":
        ssh = shutil.which("ssh")
        if not ssh:
            return False, None, "ssh 命令缺失，无法使用 ssh 通道"
        return True, ssh, None
    if ":" in str(getattr(resolve_runner, "_target", "") or ""):
        pass
    ssh = shutil.which("ssh")
    docker = shutil.which("docker")
    return (True, ssh, None) if ssh else (False, None, "ssh 命令缺失，无法使用 docker 通道")


