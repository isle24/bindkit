class Engine(object):
    def __init__(self, name, client, password_env, default_port, plan, parse):
        self.name = name
        self.client = client
        self.password_env = password_env
        self.default_port = default_port
        self.plan = plan          # (rec, sql, kind, allow_write) → (argv_tail, sql_text, mode)
        self.parse = parse        # (stdout, mode) → (columns, rows, affected, warnings)


class Pairs(list):
    """JSON 对象 → 有序键值对：保列序、重名列不互相覆盖。"""


def json_loads_pairs(text):
    return json.loads(text, object_pairs_hook=Pairs)


def plain_value(v):
    if isinstance(v, Pairs):
        return dict((k, plain_value(x)) for k, x in v)
    if isinstance(v, list):
        return [plain_value(x) for x in v]
    return v


def pairs_to_columns_rows(rows):
    """[Pairs] → (columns, 二维数组)。"""
    if not rows:
        return [], []
    first = rows[0]
    if isinstance(first, Pairs):
        columns = [k for k, _ in first]
        out = []
        for row in rows:
            if isinstance(row, Pairs):
                if [k for k, _ in row] == columns:
                    out.append([plain_value(v) for _, v in row])
                    continue
                buckets = {}
                for k, v in row:
                    buckets.setdefault(k, []).append(v)
                used, line = {}, []
                for col in columns:
                    arr = buckets.get(col, [])
                    idx = used.get(col, 0)
                    line.append(plain_value(arr[idx]) if idx < len(arr) else None)
                    used[col] = idx + 1
                out.append(line)
            elif isinstance(row, (list, tuple)):
                line = [plain_value(v) for v in row]
                line += [None] * (len(columns) - len(line))
                out.append(line[:len(columns)])
            else:
                out.append([plain_value(row)])
        return columns, out
    if isinstance(first, (list, tuple)):
        width = max(len(r) for r in rows if isinstance(r, (list, tuple)))
        return (["col%d" % (i + 1) for i in range(width)],
                [[plain_value(v) for v in r] for r in rows])
    return ["col1"], [[plain_value(r)] for r in rows]


def parse_json_lines(text):
    """一行一个 JSON 对象的输出 → [结果集]，每个结果集是 [Pairs]。

    适配：sqlite3 -json（[ {..},\\n {..} ]）、PG COPY(row_to_json)（每行一个对象/数组）。
    """
    tables, cur = [], []
    for raw in text.split("\n"):
        line = raw.strip()
        if not line:
            continue
        if line.startswith("["):
            if cur:
                tables.append(cur)
                cur = []
            line = line[1:].strip()
        if line.endswith("]"):
            line = line[:-1].strip()
        if line.endswith(","):
            line = line[:-1].strip()
        if not line:
            continue
        try:
            cur.append(json_loads_pairs(line))
        except ValueError:
            break                       # 半行（流式提前收手）→ 丢弃
    if cur:
        tables.append(cur)
    return tables


_INT_RE = re.compile(r"^(0|-?[1-9][0-9]*)$")
_FLOAT_RE = re.compile(r"^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?$")


def infer_scalar(value):
    """文本 → 数字，仅在**无损往返**时转换（"007" / "1.50" 保持字符串）。"""
    if not isinstance(value, str):
        return value
    if _INT_RE.match(value):
        try:
            iv = int(value)
        except ValueError:
            return value
        if -2 ** 63 <= iv < 2 ** 63 and str(iv) == value:
            return iv
        return value
    if ("." in value or "e" in value or "E" in value) and _FLOAT_RE.match(value):
        try:
            fv = float(value)
        except ValueError:
            return value
        if repr(fv) == value or str(fv) == value:
            return fv
    return value


# ---- MySQL -----------------------------------------------------------------
#
# mysql 客户端没有 --json，两条路：
#  1) 单条 SELECT/WITH/VALUES/TABLE → **JSON 包装**（默认走这条）：
#       select json_array(`c1`,`c2`) from ( <用户SQL> ) t
#     列名先用 `select * from (<用户SQL>) t limit 0` + --column-type-info 探一次
#     （LIMIT 0 不取数据，基本免费）。为什么必须这样：--batch 模式下 SQL NULL 与
#     字符串字面量 'NULL' 渲染成完全相同的字节（--raw、--null=、--column-type-info
#     都救不了），只有让 MySQL 自己序列化成 JSON 才能区分 [null, "NULL", ""]。
#     数字用 parse_float=infer_scalar 解析：DECIMAL 只在无损往返时变 float，
#     否则保留字符串（1.50 不会变成 1.5）。
#  2) 派生表不允许重名列、多语句、DML/DDL、SHOW 等 → 退回 `--batch` 的 TSV 路径：
#     值里的 tab/换行/反斜杠被转义成 \t \n \\，可无损还原（所以**不加 --raw**，
#     加了反而会破坏行列边界）。这条路上 SQL NULL 与字符串 'NULL' 无法区分，
#     退回时会记 warning 如实说明。
# 二进制列在 JSON 路径下会变成 MySQL 的 "base64:typeNNN:..." 形态（可还原，但与
# TSV 的原始字节形态不同）。batch 模式对 0 行结果不打印表头，探列名那一趟顺带解决。

_MYSQL_UNESCAPE = {"0": "\0", "t": "\t", "n": "\n", "r": "\r", "\\": "\\",
                   "Z": "\x1a", "b": "\b"}


def _mysql_unescape(field):
    if field == "NULL":
        return None
    if "\\" not in field:
        return field
    out, i, n = [], 0, len(field)
    while i < n:
        ch = field[i]
        if ch == "\\" and i + 1 < n:
            out.append(_MYSQL_UNESCAPE.get(field[i + 1], "\\" + field[i + 1]))
            i += 2
        else:
            out.append(ch)
            i += 1
    return "".join(out)


def mysql_json_wrappable(sql):
    """能不能用 json_array 包起来（单条 SELECT/WITH/VALUES/TABLE）。"""
    return first_keyword(sql, "mysql") in ("SELECT", "WITH", "VALUES", "TABLE") \
        and count_statements(sql, "mysql") == 1


def mysql_plan(rec, sql, kind, allow_write=False, columns_hint=None, force_tsv=False):
    argv = ["--batch", "--default-character-set=utf8mb4", "--connect-timeout=10",
            "-h", str(rec.get("host") or "127.0.0.1"),
            "-P", str(rec.get("port") or 3306),
            "-u", str(rec.get("user") or "root")]
    header_only = kind == "header"
    if header_only:
        # 0 行结果时 batch 不打印表头；这个开关强制打印（实测 8.4 / 9.1 均不额外输出元数据）
        argv.append("--column-type-info")
    if rec.get("read_only") and not allow_write:
        argv.append("--init-command=SET SESSION TRANSACTION READ ONLY")
    if rec.get("database"):
        argv.append(str(rec["database"]))
    if header_only:
        text = "select * from (\n%s\n) t limit 0;\n" % strip_sql_tail(sql, "mysql")
        return argv, text, "tsv"
    if kind == "query" and columns_hint and not force_tsv:
        argv.append("--skip-column-names")       # 列名来自探针，这里不要表头行
        cols = ", ".join("`%s`" % str(c).replace("`", "``") for c in columns_hint)
        text = ("select json_array(%s) from (\n%s\n) t;\n"
                % (cols, strip_sql_tail(sql, "mysql")))
        return argv, text, "mysql-json"
    text, mode = sql, "tsv"
    if kind == "write" and count_statements(sql, "mysql") == 1 \
            and not re.search(r"\bRETURNING\b", sql, re.I):
        text = strip_sql_tail(sql, "mysql") + ";\nselect row_count() as dbbind_affected_rows;\n"
        mode = "tsv-sentinel"
    return argv, text, mode


def _mysql_probe_columns(rec, sql, timeout):
    """探列名：`select * from (<sql>) t limit 0` + --column-type-info。

    LIMIT 0 不取数据，只是让服务端把结果集列元数据发回来。派生表不允许重名列等
    情况会失败，调用方据此退回 TSV 路径。
    """
    try:
        argv_tail, text, mode = mysql_plan(rec, sql, "header")
        argv, env, stdin_text = build_invocation(rec, argv_tail, text)
        rc, out, err, _, _ = run_proc(argv, env, stdin_text, timeout)
        if rc != 0:
            return None
        cols, _, _, _ = mysql_parse(out, mode)
        return cols or None
    except DbbindError:
        return None


def mysql_parse_json_rows(text):
    """json_array 每行一个 JSON 数组 → 二维数组（DECIMAL 走无损推断）。"""
    rows = []
    for raw in text.split("\n"):
        line = raw.strip()
        if not line or not line.startswith("["):
            continue                     # 空行 / 表头 / 杂音
        if not line.endswith("]"):
            break                        # 半行（流式被截断）
        # mysql 客户端在 batch 模式下会把输出里的反斜杠再转义一遍
        # （JSON 文本 ["a\tb"] 会变成 ["a\\tb"]），先还原再交给 json 解析
        line = _mysql_unescape(line)
        if not line:
            continue
        try:
            val = json.loads(line, parse_float=infer_scalar, parse_int=int)
        except ValueError:
            break
        if isinstance(val, list):
            rows.append([plain_value(v) for v in val])
    return rows


def _parse_tsv_tables(text):
    """mysql batch 输出 → [(header, rows)]。字段数变化即视为新的结果集表头。

    注意：按 "\\n" 切、只丢掉末尾那个空串。
      * 不能用 splitlines()：mysql 非 raw 模式不转义裸 \\r，值里的 \\r 会被切开。
      * 中间的空行不能当噪音丢掉：单列的空字符串值恰好就是一行空行。
    """
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    tables, header, rows = [], None, []
    for line in lines:
        fields = line.split("\t")
        if header is None:
            header = fields
            continue
        if len(fields) != len(header):
            tables.append((header, rows))
            header, rows = fields, []
            continue
        rows.append([_mysql_unescape(f) for f in fields])
    if header is not None:
        tables.append((header, rows))
    return tables


def mysql_parse(stdout, mode):
    warnings = []
    if mode == "mysql-json":
        return [], mysql_parse_json_rows(stdout), None, warnings
    tables = _parse_tsv_tables(stdout)
    affected = None
    if mode == "tsv-sentinel" and tables:
        last_header, last_rows = tables[-1]
        if last_header == ["dbbind_affected_rows"]:
            tables = tables[:-1]
            if last_rows and last_rows[0]:
                val = last_rows[0][0]
                if isinstance(val, str):
                    try:
                        val = int(val)
                    except ValueError:
                        val = None
                if val is not None and val >= 0:
                    affected = val
    if len(tables) > 1:
        warnings.append("检测到多条语句：只返回第一个结果集（其余 %d 个已忽略）"
                        % (len(tables) - 1))
    if not tables:
        return [], [], affected, warnings
    header, rows = tables[0]
    if header and header[0] == "dbbind_affected_rows":
        return [], [], affected, warnings
    return list(header), [[infer_scalar(v) for v in r] for r in rows], affected, warnings


# ---- PostgreSQL ------------------------------------------------------------
#
# 读路径：`copy (select row_to_json(t) from (<用户SQL>) t) to stdout`
#   * 一行一个 JSON 对象 → 可以流式读、limit+1 就收手
#   * 保留原生类型（bool/json/数字），NULL → JSON null，'' → ""，两者可区分
#   * 重名列不丢（Pairs 解析）
# 0 行时 COPY 不输出内容 → 用 `copy (... limit 0)` 的表头行拿列名。
# EXPLAIN/SHOW 等不能包进子查询的语句，以及写语句，走 psql --csv（表头恒定，
# 但 psql 的 CSV 无法区分 NULL 与 ''，这两种语句上属已知限制）。

def _pg_wrappable(sql):
    """能不能安全地包进子查询（SELECT/WITH/VALUES/TABLE 且只有一条语句）。"""
    kw = first_keyword(sql, "postgres")
    return kw in ("SELECT", "WITH", "VALUES", "TABLE") \
        and count_statements(sql, "postgres") == 1


def pg_classify(sql):
    if write_hits(sql):
        return "write"
    return "json" if _pg_wrappable(sql) else "csv"


def pg_plan(rec, sql, kind, allow_write=False, **_kw):
    argv = ["-X", "-w", "-v", "ON_ERROR_STOP=1",
            "-h", str(rec.get("host") or "127.0.0.1"),
            "-p", str(rec.get("port") or 5432),
            "-U", str(rec.get("user") or "postgres")]
    if rec.get("database"):
        argv += ["-d", str(rec["database"])]
    # kind: auto/query/write 是执行层的说法，这里翻译成取数方式
    if kind == "auto":
        kind = pg_classify(sql)
    elif kind == "query":
        kind = "json" if _pg_wrappable(sql) else "csv"
    elif kind == "write":
        # 写语句也可能带 RETURNING / CALL 返回行，统一用 --csv 拿结果 + 命令标签
        kind = "csv"
    if kind == "json":
        # 一行一个 JSON 对象，psql -t -A 原样输出：
        #  * 不用 COPY：COPY 的 text 格式会把反斜杠再转义一遍（数据里的 \ 变 \\，失真）
        #  * 别名用带空格的引用名：`row_to_json(x)` 里的 x 要是整行引用，若子查询里
        #    恰好有同名列（比如 select 1 as t）就会解析成那一列（function row_to_json(text)
        #    does not exist）——带空格的别名用户不可能取到
        body = strip_sql_tail(sql, "postgres")
        text = ('select row_to_json("dbbind row") from (\n%s\n) "dbbind row"\n' % body)
        argv += ["-t", "-A"]
        return argv, text, "json-lines"
    if kind in ("csv", "utility"):
        argv += ["--csv"]
        return argv, sql, "csv"
    argv += ["-t", "-A"]
    return argv, sql, "tags"


_PG_TAG_RE = re.compile(
    r"^(INSERT|UPDATE|DELETE|SELECT|COPY|MERGE|MOVE|FETCH|TRUNCATE TABLE|CREATE TABLE|"
    r"CREATE INDEX|CREATE VIEW|CREATE SEQUENCE|CREATE SCHEMA|CREATE TYPE|CREATE EXTENSION|"
    r"CREATE FUNCTION|DROP TABLE|ALTER TABLE|SET|BEGIN|COMMIT|ROLLBACK|GRANT|REVOKE)"
    r"(\s+\d+)?(\s+\d+)?$")


def pg_parse(stdout, mode):
    warnings = []
    if mode == "json-lines":
        tables = parse_json_lines(stdout)
        if not tables:
            return [], [], None, warnings
        columns, rows = pairs_to_columns_rows(tables[0])
        return columns, rows, None, warnings
    affected = None
    keep = []
    for line in stdout.split("\n"):
        if "," not in line and _PG_TAG_RE.match(line.strip()):
            nums = re.findall(r"\d+", line)
            if len(nums) >= 2:
                affected = int(nums[-1])
            keep.append("")
            continue
        keep.append(line)
    text = "\n".join(keep).strip("\n")
    if mode == "tags" or not text:
        return [], [], affected, warnings
    records = [r for r in csv_mod.reader(io.StringIO(text)) if r]
    if not records:
        return [], [], affected, warnings
    columns = records[0]
    rows = []
    for rec in records[1:]:
        if rec and _PG_TAG_RE.match(rec[0] or ""):
            continue
        line = [None if v == "" else infer_scalar(v) for v in rec]
        line += [None] * (len(columns) - len(line))
        rows.append(line[:len(columns)])
    return columns, rows, affected, warnings


# ---- SQLite ----------------------------------------------------------------
#
# `sqlite3 -bail -json`：一行一个 JSON 对象，可流式；NULL → null，'' → ""。
# 0 行结果 CLI 不打印任何表头（惰性输出）→ 本地文件用标准库 sqlite3 拿列名兜底。

def sqlite_plan(rec, sql, kind, allow_write=False, **_kw):
    argv = ["-bail", "-json"]
    if rec.get("read_only") and not allow_write:
        argv.insert(0, "-readonly")
    if rec.get("file"):
        argv.append(str(rec["file"]))
    text, mode = sql, "json-lines"
    if kind == "write" and count_statements(sql, "sqlite") == 1 \
            and not re.search(r"\bRETURNING\b", sql, re.I):
        text = strip_sql_tail(sql, "sqlite") + ";\nselect changes() as dbbind_affected_rows;\n"
        mode = "json-sentinel"
    return argv, text, mode


def sqlite_parse(stdout, mode):
    warnings = []
    tables = parse_json_lines(stdout)
    affected = None
    if mode == "json-sentinel" and tables:
        last = tables[-1]
        if last and isinstance(last[0], Pairs) and \
                [k for k, _ in last[0]] == ["dbbind_affected_rows"]:
            tables = tables[:-1]
            val = last[0][0][1]
            if isinstance(val, int) and val >= 0:
                affected = val
    if len(tables) > 1:
        warnings.append("检测到多条语句：只返回第一个结果集（其余 %d 个已忽略）"
                        % (len(tables) - 1))
    if not tables:
        return [], [], affected, warnings
    columns, rows = pairs_to_columns_rows(tables[0])
    return columns, rows, affected, warnings


ENGINES = {
    "mysql": Engine("mysql", "mysql", "MYSQL_PWD", 3306, mysql_plan, mysql_parse),
    "postgres": Engine("postgres", "psql", "PGPASSWORD", 5432, pg_plan, pg_parse),
    "sqlite": Engine("sqlite", "sqlite3", None, None, sqlite_plan, sqlite_parse),
}


def engine_of(rec):
    eng = ENGINES.get(rec.get("engine"))
    if not eng:
        die("UNSUPPORTED", "不支持的引擎：%r" % rec.get("engine"),
            "当前支持：%s" % "、".join(ENGINE_NAMES))
    return eng


