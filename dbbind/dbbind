SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=15",
            "-o", "StrictHostKeyChecking=accept-new"]


def _inside_strings(sql, backslash_escapes):
    """扫描出「落在引号里或注释里」的字符位置集合（这两处都不可能是客户端元命令）。

    backslash_escapes 用来切换两种转义约定：
      True  = MySQL 习惯（反斜杠转义引号）
      False = PG 标准（standard_conforming_strings，反斜杠不转义，'' 才转义）
    两种结果都算一遍、取交集，解析歧义时宁可误报（见 check_client_metacommands）。
    """
    n = len(sql)
    inside = set()
    i = 0
    in_sq = in_dq = in_bt = False
    line_comment = block_comment = False
    dollar_tag = None
    while i < n:
        ch = sql[i]
        if line_comment:
            inside.add(i)
            if ch == "\n":
                line_comment = False
            i += 1
            continue
        if block_comment:
            inside.add(i)
            if sql.startswith("*/", i):
                inside.update((i, i + 1))
                block_comment = False
                i += 2
                continue
            i += 1
            continue
        if dollar_tag is not None:
            inside.add(i)
            if sql.startswith(dollar_tag, i):
                for k in range(i, min(i + len(dollar_tag), n)):
                    inside.add(k)
                i += len(dollar_tag)
                dollar_tag = None
                continue
            i += 1
            continue
        if in_sq:
            inside.add(i)
            if backslash_escapes and ch == "\\" and i + 1 < n:
                inside.add(i + 1)
                i += 2
                continue
            if ch == "'":
                in_sq = False
            i += 1
            continue
        if in_dq:
            inside.add(i)
            if ch == '"':
                in_dq = False
            i += 1
            continue
        if in_bt:
            inside.add(i)
            if ch == "`":
                in_bt = False
            i += 1
            continue
        if sql.startswith("--", i):
            line_comment = True
            inside.update((i, i + 1))
            i += 2
            continue
        if sql.startswith("/*", i):
            block_comment = True
            inside.update((i, i + 1))
            i += 2
            continue
        if ch == "'":
            in_sq = True
            inside.add(i)
            i += 1
            continue
        if ch == '"':
            in_dq = True
            inside.add(i)
            i += 1
            continue
        if ch == "`":
            in_bt = True
            inside.add(i)
            i += 1
            continue
        if ch == "$":
            m = re.match(r"\$[A-Za-z_][A-Za-z0-9_]*\$|\$\$", sql[i:])
            if m:
                dollar_tag = m.group(0)
                for k in range(i, min(i + len(dollar_tag), n)):
                    inside.add(k)
                i += len(dollar_tag)
                continue
        i += 1
    return inside


def check_client_metacommands(sql, engine):
    """拒绝客户端元命令：psql 的 \\! \\i \\copy \\. / sqlite3 的 .shell .import .output …

    为什么必须在这里挡：元命令**不是 SQL**，根本不经过服务器，所以引擎级只读防线
    （PGOPTIONS / --init-command / -readonly）和 SQL 关键字守卫都看不见它，
    而它可以读任意文件、执行任意命令（实测 sqlite3 的 .shell 真能建文件、
    psql 的 \\! 能把 ~/.dbbind/config.json 的内容塞进结果里回传）。
    psql 加 -X 也挡不住 -c/stdin 里的 \\!，sqlite3 没有关闭点命令的开关 → 只能输入校验。
    """
    # 说明：反斜杠只放行「引号内」和「注释内」——psql 的元命令不可能出现在这两处
    # （注释里带反斜杠的合法 SQL 不该被误伤；行首 \\ 的检查仍然无条件生效，作为兜底）
    hint = ("客户端元命令被禁用，请用标准 SQL。psql 的 \\! / \\i / \\copy 与 sqlite3 的 "
            ".shell / .import / .output 不走服务器，会被当成任意命令执行")
    for raw in sql.split("\n"):
        line = raw.lstrip(" \t")
        if line.startswith("\\"):
            die("UNSUPPORTED", "客户端元命令被禁用（检测到以反斜杠开头的行：%s）"
                % line[:40], hint)
        if engine == "sqlite" and line.startswith("."):
            die("UNSUPPORTED", "客户端元命令被禁用（检测到以点号开头的行：%s）"
                % line[:40], hint)
    if "\\" in sql:
        lenient = _inside_strings(sql, True)      # MySQL 习惯
        strict = _inside_strings(sql, False)      # PG 标准
        for i, ch in enumerate(sql):
            if ch != "\\":
                continue
            if i in lenient and i in strict:
                continue                          # 两种约定都认为它在字符串里 → 是数据
            die("UNSUPPORTED",
                "SQL 里出现字符串外的反斜杠（psql 会把它当元命令执行）",
                hint)


def _require_native_ssh_alias(alias):
    path = os.path.join(os.path.expanduser('~'), '.ssh', 'sshbind', 'servers.json')
    try:
        with open(path, encoding='utf-8') as stream:
            text = stream.read(2 * 1024 * 1024 + 1)
        if len(text) > 2 * 1024 * 1024:
            raise ValueError()
        row = json.loads(text).get('servers', {}).get(alias) or {}
        if not isinstance(row, dict):
            raise ValueError()
    except FileNotFoundError:
        return
    except (OSError, ValueError, TypeError, AttributeError):
        die('STATE_CORRUPT', '无法核对 SSH 连接类型，请检查 sshbind 的连接记录')
    if row.get('verification_status') == 'pending' or row.get('installed') is False:
        die('UNSUPPORTED', '该 SSH 连接尚未验证，请先在控制台完成连接验证')
    if row.get('auth_type') == 'password' or (not row.get('key') and (row.get('login_credential_ref') or row.get('encrypted_login_ref'))):
        die('UNSUPPORTED', '此数据库 SSH 通道使用原生 OpenSSH，需要密钥别名；密码连接请通过 sshbind exec 使用')


def build_invocation(rec, argv_tail, sql_text, allow_write=False):
    """把「引擎参数 + SQL」装进执行通道 → (argv, env, stdin_text)。

    密码绝不进 argv：
      * local  → 环境变量 MYSQL_PWD / PGPASSWORD
      * ssh    → stdin 首行，由远端 shell read 进环境变量后 exec 客户端
      * docker → 同上，read 发生在容器内（docker exec -i）
    """
    eng = engine_of(rec)
    via = rec.get("via") or "local"
    password = rec.get("password") or ""
    if password and "\n" in password:
        die("USAGE", "密码包含换行符，无法通过 ssh / docker 通道安全传递",
            "改用 local 通道，或换一个不含换行的密码")
    use_password = bool(password) and bool(eng.password_env)
    env = dict(os.environ)
    # 校验的是「最终交给客户端的那个字符串」（含我们自己拼的 json/copy 包装）
    check_client_metacommands(sql_text, eng.name)

    if eng.name == "postgres" and rec.get("read_only") and not allow_write:
        # §4.2.3 引擎级第二道防线：服务端只读事务
        env["PGOPTIONS"] = "-c default_transaction_read_only=on"

    if via == "local":
        client = rec.get("client_path") or find_client(eng.name)[0]
        if not client:
            die("CLIENT_MISSING", "找不到 %s 客户端" % CLIENT_NAMES[eng.name],
                "安装后重试，或用 $%s 指定路径" % ENV_CLIENT[eng.name])
        if use_password:
            env[eng.password_env] = password
        return [client] + argv_tail, env, sql_text

    # 远端：客户端由远端 / 容器内的 PATH 解析 → 用裸名字
    remote_argv = [CLIENT_NAMES[eng.name]] + argv_tail
    prelude = ""
    if use_password:
        var = "DBBIND_DB_PASSWORD"
        prelude = ('IFS= read -r %s; export %s; %s="$%s"; export %s; '
                   % (var, var, eng.password_env, var, eng.password_env))
    if eng.name == "postgres" and rec.get("read_only") and not allow_write:
        prelude += "export PGOPTIONS='-c default_transaction_read_only=on'; "

    inner = prelude + "exec " + " ".join(shlex.quote(a) for a in remote_argv)
    stdin_text = (password + "\n" + sql_text) if use_password else sql_text

    if via == "ssh":
        _require_native_ssh_alias(str(rec['via_ssh']))
        return ["ssh"] + SSH_OPTS + [str(rec["via_ssh"]), inner], env, stdin_text

    target = str(rec.get("docker_exec") or "")
    if not target:
        die("USAGE", "docker 通道缺少 docker_exec 配置")
    ssh_alias, _, container = target.partition(":")
    container = container or ssh_alias
    docker_argv = ["docker", "exec", "-i", container, "sh", "-c", inner]
    if ":" in target:
        _require_native_ssh_alias(ssh_alias)
        remote = " ".join(shlex.quote(a) for a in docker_argv)
        return ["ssh"] + SSH_OPTS + [ssh_alias, remote], env, stdin_text
    return docker_argv, env, stdin_text


def _drain(stream, sink):
    try:
        sink.append(stream.read())
    except (OSError, ValueError):
        pass


def run_proc(argv, env, stdin_text, timeout, max_lines=None):
    """执行子进程 → (rc, stdout, stderr, killed_by_limit, timed_out)。

    max_lines 非空时按行流式读取：读够就杀掉子进程，避免大结果集把内存吃光。
    """
    if max_lines is None:
        try:
            proc = subprocess.run(
                argv,
                input=(stdin_text.encode("utf-8") if stdin_text is not None else None),
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                stdin=(None if stdin_text is not None else subprocess.DEVNULL),
                env=env, timeout=timeout)
        except subprocess.TimeoutExpired:
            die("TIMEOUT", "执行超时（%ss）" % timeout, "加大 --timeout，或把查询拆小")
        except FileNotFoundError as e:
            die("CLIENT_MISSING", "找不到可执行文件：%s" % e.filename, "修正 PATH 或安装客户端")
        except OSError as e:
            die("CLIENT_MISSING", "无法执行命令：%s" % e, "检查客户端是否可执行")
        return (proc.returncode, proc.stdout.decode("utf-8", "replace"),
                proc.stderr.decode("utf-8", "replace"), False, False)

    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env)
    except FileNotFoundError as e:
        die("CLIENT_MISSING", "找不到可执行文件：%s" % e.filename, "修正 PATH 或安装客户端")
    except OSError as e:
        die("CLIENT_MISSING", "无法执行命令：%s" % e, "检查客户端是否可执行")

    err_buf = []
    th_err = threading.Thread(target=_drain, args=(proc.stderr, err_buf))
    th_err.daemon = True
    th_err.start()

    def _feed():
        try:
            if stdin_text is not None:
                proc.stdin.write(stdin_text.encode("utf-8"))
            proc.stdin.close()
        except (BrokenPipeError, OSError, ValueError):
            pass

    th_in = threading.Thread(target=_feed)
    th_in.daemon = True
    th_in.start()

    state = {"timeout": False}

    def _kill():
        state["timeout"] = True
        try:
            proc.kill()
        except OSError:
            pass

    timer = threading.Timer(timeout, _kill)
    timer.daemon = True
    timer.start()
    lines, killed = [], False
    try:
        for line in proc.stdout:
            if not line.endswith(b"\n"):
                break                       # 半行（被 kill 截断）→ 丢弃
            lines.append(line)
            if len(lines) >= max_lines:
                killed = True
                try:
                    proc.kill()
                except OSError:
                    pass
                break
    finally:
        timer.cancel()
        try:
            proc.stdout.close()
        except (OSError, ValueError):
            pass
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        try:
            proc.kill()
        except OSError:
            pass
    th_in.join(timeout=5)
    th_err.join(timeout=5)
    if state["timeout"]:
        die("TIMEOUT", "执行超时（%ss）" % timeout, "加大 --timeout，或把查询拆小")
    out = b"".join(lines).decode("utf-8", "replace")
    err = b"".join(err_buf).decode("utf-8", "replace")
    return proc.returncode, out, err, killed, False


def first_line(text):
    for line in (text or "").splitlines():
        if line.strip():
            return redact(line.strip())
    return redact((text or "").strip()) or "未知错误"


def classify_db_error(stderr):
    e = stderr or ""
    low = e.lower()
    missing = ("command not found", "executable file not found", "not found in $path",
               "no such file or directory", "is not recognized as an internal or external")
    if any(m in low for m in missing):
        return "CLIENT_MISSING", first_line(e)
    connect = ("can't connect to mysql server", "unknown mysql server host",
               "access denied for user", "could not connect to server",
               "connection refused", "password authentication failed",
               "no pg_hba.conf entry", "could not translate host name",
               "connection timed out", "server closed the connection unexpectedly",
               "is the server running", "network is unreachable", "no route to host",
               "operation timed out", "unable to open database file",
               "cannot open shared object file", "no such container",
               "cannot connect to the docker daemon", "permission denied while trying")
    if any(m in low for m in connect):
        return "CONNECT_FAILED", first_line(e)
    if "permission denied" in low and "publickey" in low:
        return "CONNECT_FAILED", first_line(e)
    return "SQL_ERROR", first_line(e)


_ERROR_HINTS = {
    "CONNECT_FAILED": "检查 host/port/凭据；用 dbbind test <别名> 复测",
    "CLIENT_MISSING": "装客户端，或把别名改成 ssh/docker 通道",
    "SQL_ERROR": "检查 SQL 语法与对象名（用 dbbind tables/columns 看结构）",
}


# ---------------------------------------------------------------------------
# 结果集处理：流式读取 + 本地截断（CONTRACT §4.3）
# ---------------------------------------------------------------------------

def _max_lines_for(mode, kind, limit):
    """一行=一行的模式才能按行数收手；CSV 有跨行字段，不设行上限。

    limit=None 表示不限；limit=0 表示只读 1 行判断有没有数据。
    """
    if kind != "query" or limit is None:
        return None
    cap = limit + 1                          # 多读一行，用来判断 truncated
    if mode in ("tsv", "tsv-sentinel"):
        return cap + 1                       # 表头 + cap 行
    if mode in ("mysql-json", "json-lines", "json-sentinel"):
        return cap
    return None


def _describe_columns(rec, sql, timeout):
    """0 行结果拿列名的兜底（各引擎能力不同）。"""
    eng = engine_of(rec)
    try:
        if eng.name == "mysql":
            return _mysql_probe_columns(rec, sql, timeout) or []
        if eng.name == "postgres":
            body = strip_sql_tail(sql, "postgres")
            header_sql = ("copy (select * from (\n%s\n) t limit 0) to stdout "
                          "with (format csv, header true)\n" % body)
            argv_tail, text, mode = pg_plan(rec, header_sql, "csv")
            argv, env, stdin_text = build_invocation(rec, argv_tail, text)
            rc, out, err, _, _ = run_proc(argv, env, stdin_text, timeout)
            if rc == 0 and out.strip():
                first = out.split("\n")[0]
                return next(csv_mod.reader(io.StringIO(first)))
        elif eng.name == "sqlite" and rec.get("via") == "local" and rec.get("file"):
            uri = "file:%s?mode=ro" % quote(os.path.abspath(rec["file"]))
            con = sqlite_mod.connect(uri, uri=True)
            try:
                cur = con.execute(strip_sql_tail(sql, "sqlite"))
                return [d[0] for d in (cur.description or [])]
            finally:
                con.close()
    except Exception:
        return []
    return []


def execute_sql(rec, sql, mode="auto", timeout=DEFAULT_TIMEOUT, allow_write=False,
                limit=None, database=None):
    """执行 SQL → dict(columns, rows, row_count, truncated, affected_rows, ...)。

    mode: auto=按语句类型选路；query=按读处理；write=按写处理。
    limit: >0 时本地截断（读到 limit+1 行就收手）；0/None = 不限。
    """
    eng = engine_of(rec)
    rec2 = dict(rec)
    if database:
        rec2["database"] = database
    kind = mode
    if kind == "auto":
        kind = "write" if write_hits(sql) else "query"
    warnings = []
    # mysql 单条 SELECT：先探一次列名（limit 0，几乎免费），好走 json_array 包装。
    # 探不到（派生表重名等）就退回 TSV——TSV 那条路无法区分 'NULL' 与 SQL NULL。
    hint = None
    if eng.name == "mysql" and kind == "query" and mysql_json_wrappable(sql):
        hint = _mysql_probe_columns(rec2, sql, timeout)
    argv_tail, sql_text, plan_mode = eng.plan(rec2, sql, kind, allow_write=allow_write,
                                              columns_hint=hint)
    argv, env, stdin_text = build_invocation(rec2, argv_tail, sql_text,
                                             allow_write=allow_write)
    max_lines = _max_lines_for(plan_mode, kind, limit)
    t0 = time.monotonic()
    rc, out, err, killed, _ = run_proc(argv, env, stdin_text, timeout, max_lines)
    duration = int((time.monotonic() - t0) * 1000)

    if rc != 0 and not killed and plan_mode == "mysql-json":
        # JSON 包装在运行期失败（不可 JSON 化的列类型等）→ 用 TSV 再跑一次
        argv_tail2, sql_text2, plan_mode2 = eng.plan(rec2, sql, kind,
                                                     allow_write=allow_write,
                                                     force_tsv=True)
        argv2, env2, stdin_text2 = build_invocation(rec2, argv_tail2, sql_text2,
                                                    allow_write=allow_write)
        rc2, out2, err2, killed2, _ = run_proc(argv2, env2, stdin_text2, timeout,
                                               _max_lines_for(plan_mode2, kind, limit))
        if rc2 == 0:
            warnings.append("该查询退回 TSV 解析（JSON 包装失败：%s）；"
                            "字符串 'NULL' 可能被当作 NULL" % first_line(err))
            rc, out, err, killed, plan_mode = rc2, out2, err2, killed2, plan_mode2
            duration = int((time.monotonic() - t0) * 1000)

    if rc != 0 and not killed:
        code, message = classify_db_error(err)
        die(code, message, _ERROR_HINTS.get(code))

    columns, rows, affected, parse_warnings = eng.parse(out, plan_mode)
    warnings.extend(parse_warnings)
    if not columns and hint and plan_mode == "mysql-json":
        columns = list(hint)          # json_array 丢了列名，用探针结果补回

    # 0 行时补列名（mysql/sqlite 的 CLI 不打印空结果表头）
    if kind == "query" and not rows and not columns and count_statements(sql, eng.name) == 1:
        columns = _describe_columns(rec2, sql, timeout)

    row_count = len(rows)                    # 实际读取行数（截断时为 limit+1）
    truncated = bool(limit is not None and row_count > limit)
    if truncated:
        rows = rows[:limit]
    row_count_exact = not truncated
    return {
        "columns": columns,
        "rows": rows,
        "row_count": row_count,
        "row_count_exact": row_count_exact,
        "returned": len(rows),
        "truncated": truncated,
        "affected_rows": affected,
        "warnings": warnings,
        "duration_ms": duration,
        "stdout": out,
        "stderr": redact(err),
    }


# ---------------------------------------------------------------------------
# 内部只读查询：库 / 表 / 列 / 索引 / 服务器信息
# ---------------------------------------------------------------------------

def q(sql, rec, database=None, timeout=DEFAULT_TIMEOUT):
    return execute_sql(rec, sql, mode="query", timeout=timeout, database=database)


def list_databases(rec):
    eng = rec["engine"]
    if eng == "mysql":
        res = q("show databases", rec)
        return [{"name": r[0]} for r in res["rows"]]
    if eng == "postgres":
        res = q("select datname from pg_database where not datistemplate order by 1", rec)
        return [{"name": r[0]} for r in res["rows"]]
    res = q("pragma database_list", rec)
    out = []
    for row in res["rows"]:
        name = row[1] if len(row) > 1 else row[0]
        out.append({"name": name, "file": row[2] if len(row) > 2 else None})
    return out


def database_exists(rec, db):
    """库/schema 是否存在（sqlite 指 attach 进来的 schema 名）。查不了就返回 True，避免误报。"""
    eng = rec["engine"]
    try:
        if eng == "mysql":
            res = q("select schema_name from information_schema.schemata where schema_name = %s"
                    % sql_str_literal(db, "mysql"), rec)
            return bool(res["rows"])
        if eng == "postgres":
            res = q("select schema_name from information_schema.schemata where schema_name = %s"
                    % sql_str_literal(db, "postgres"), rec)
            return bool(res["rows"])
        names = set()
        for r in q("pragma database_list", rec)["rows"]:
            names.add(r[1] if len(r) > 1 else r[0])
        return db in names
    except DbbindError:
        return True


def list_tables(rec, database=None, limit=None):
    eng = rec["engine"]
    if eng == "mysql":
        db = database or rec.get("database")
        if not db:
            die("USAGE", "mysql 别名没有默认库，请用 --database 指定",
                "例如：dbbind tables %s --database appdb" % rec["name"])
        sql = ("select table_schema as `schema`, table_name as `name`, "
               "table_type as `type`, table_rows as `rows_estimate`, "
               "table_comment as `comment` from information_schema.tables "
               "where table_schema = %s order by table_name"
               % sql_str_literal(db, "mysql"))
    elif eng == "postgres":
        where = "table_schema not in ('pg_catalog','information_schema')"
        if database:
            where += " and table_schema = %s" % sql_str_literal(database, "postgres")
        sql = ("select table_schema as schema, table_name as name, table_type as type, "
               "null as rows_estimate, null as comment from information_schema.tables "
               "where %s order by 1,2" % where)
    else:
        schema = quote_ident(database or "main", "sqlite", "库名")
        sql = ("select null as schema, name, type, null as rows_estimate, "
               "null as comment from %s.sqlite_master "
               "where type in ('table','view') and name not like 'sqlite_%%' "
               "order by name" % schema)
    try:
        res = q(sql, rec)
    except DbbindError:
        # sqlite 用 "<schema>".sqlite_master，schema 不存在时会直接报错
        if database and not database_exists(rec, database):
            die("NOT_FOUND", "没有这个库/schema：%s" % database,
                "用 dbbind databases %s 看有哪些库" % rec["name"])
        raise
    cols = res["columns"] or ["schema", "name", "type", "rows_estimate", "comment"]
    out = []
    for row in res["rows"]:
        item = dict(zip(cols, row))
        if eng == "sqlite":
            item.pop("schema", None)
        out.append(item)
    if limit is not None and limit >= 0:
        out = out[:limit]
    if not out and database and not database_exists(rec, database):
        die("NOT_FOUND", "没有这个库/schema：%s" % database,
            "用 dbbind databases %s 看有哪些库" % rec["name"])
    return out, res


def list_columns(rec, table, database=None, timeout=DEFAULT_TIMEOUT):
    eng = rec["engine"]
    schema, _, bare = table.rpartition(".")
    bare = bare or table
    if eng == "mysql":
        db = database or schema or rec.get("database")
        if not db:
            die("USAGE", "mysql 别名没有默认库，请用 --database 指定")
        sql = ("select column_name as `name`, column_type as `type`, "
               "is_nullable as `nullable`, column_key as `key`, "
               "column_default as `default`, extra as `extra` "
               "from information_schema.columns where table_schema = %s "
               "and table_name = %s order by ordinal_position"
               % (sql_str_literal(db, "mysql"), sql_str_literal(bare, "mysql")))
    elif eng == "postgres":
        conds = ["table_name = %s" % sql_str_literal(bare, "postgres")]
        conds.append("table_schema = %s" % sql_str_literal(schema, "postgres") if schema
                     else "table_schema not in ('pg_catalog','information_schema')")
        sql = ("select column_name as name, data_type as type, is_nullable as nullable, "
               "null as key, column_default as default, null as extra "
               "from information_schema.columns where %s order by ordinal_position"
               % " and ".join(conds))
    else:
        sql = ("select name, type, "
               "case when \"notnull\" = 0 then 'YES' else 'NO' end as nullable, "
               "case when pk > 0 then 'PRI' else null end as key, "
               "dflt_value as \"default\", null as extra "
               "from pragma_table_info(%s)" % sql_str_literal(bare, "sqlite"))
    return q(sql, rec, timeout=timeout)


def list_indexes(rec, database=None):
    eng = rec["engine"]
    if eng == "mysql":
        db = database or rec.get("database")
        if not db:
            return []
        sql = ("select table_name as `table`, index_name as `name`, "
               "case when non_unique = 0 then 1 else 0 end as `unique`, "
               "group_concat(column_name order by seq_in_index) as `columns` "
               "from information_schema.statistics where table_schema = %s "
               "group by table_name, index_name, non_unique "
               "order by table_name, index_name" % sql_str_literal(db, "mysql"))
    elif eng == "postgres":
        where = "schemaname not in ('pg_catalog','information_schema')"
        if database:
            where += " and schemaname = %s" % sql_str_literal(database, "postgres")
        sql = ("select tablename as table, indexname as name, null as unique, "
               "indexdef as columns from pg_indexes where %s "
               "order by tablename, indexname" % where)
    else:
        schema = quote_ident(database or "main", "sqlite", "库名")
        sql = ("select tbl_name as \"table\", name, null as \"unique\", sql as columns "
               "from %s.sqlite_master where type = 'index' and name not like 'sqlite_%%' "
               "order by tbl_name, name" % schema)
    res = q(sql, rec)
    cols = res["columns"] or ["table", "name", "unique", "columns"]
    return [dict(zip(cols, r)) for r in res["rows"]]


def dbinfo_data(rec, timeout=DEFAULT_TIMEOUT):
    eng = rec["engine"]
    out = {"ok": True, "alias": rec["name"], "engine": eng, "version": None,
           "current_database": None, "current_user": None, "server_encoding": None,
           "databases": []}
    t0 = time.monotonic()
    if eng == "mysql":
        # 别名一律加反引号：current_user 之类在 MySQL 9 里是保留字
        res = q("select version() as `version`, database() as `current_database`, "
                "current_user() as `current_user`, "
                "@@character_set_server as `server_encoding`", rec, timeout=timeout)
        keys = res["columns"] or ["version", "current_database", "current_user",
                                  "server_encoding"]
        if res["rows"]:
            out.update(dict(zip(keys, res["rows"][0])))
        res2 = q("select table_schema as name, "
                 "cast(coalesce(sum(data_length + index_length), 0) as signed) as size_bytes, "
                 "count(*) as table_count from information_schema.tables "
                 "where table_schema not in ('information_schema','performance_schema','sys') "
                 "group by table_schema order by table_schema", rec, timeout=timeout)
        out["databases"] = [{"name": r[0], "size_bytes": r[1], "table_count": r[2]}
                            for r in res2["rows"]]
    elif eng == "postgres":
        res = q("select current_setting('server_version') as version, "
                "current_database() as current_database, current_user as current_user, "
                "current_setting('server_encoding') as server_encoding",
                rec, timeout=timeout)
        keys = res["columns"] or ["version", "current_database", "current_user",
                                  "server_encoding"]
        if res["rows"]:
            out.update(dict(zip(keys, res["rows"][0])))
        try:
            # table_count 只能统计当前库（跨库要 dblink），其余库如实给 null
            res2 = q("select d.datname as name, pg_database_size(d.datname) as size_bytes, "
                     "case when d.datname = current_database() then "
                     " (select count(*) from pg_class c join pg_namespace n "
                     "  on n.oid = c.relnamespace "
                     "  where c.relkind in ('r','p','v','m','f') "
                     "  and n.nspname not in ('pg_catalog','information_schema')) "
                     "else null end as table_count "
                     "from pg_database d where not d.datistemplate order by 1",
                     rec, timeout=timeout)
        except DbbindError:
            res2 = q("select datname, null, null from pg_database "
                     "where not datistemplate order by 1", rec, timeout=timeout)
        out["databases"] = [{"name": r[0], "size_bytes": r[1], "table_count": r[2]}
                            for r in res2["rows"]]
    else:
        try:
            res = q("select sqlite_version() as version, 'main' as current_database, "
                    "null as current_user, 'UTF-8' as server_encoding",
                    rec, timeout=timeout)
            keys = res["columns"] or ["version", "current_database", "current_user",
                                      "server_encoding"]
            if res["rows"]:
                out.update(dict(zip(keys, res["rows"][0])))
        except DbbindError:
            pass
        size_bytes = table_count = None
        try:
            res2 = q("select (select page_count from pragma_page_count()) * "
                     "(select page_size from pragma_page_size()) as size_bytes, "
                     "(select count(*) from sqlite_master where type = 'table' "
                     " and name not like 'sqlite_%') as table_count", rec, timeout=timeout)
            if res2["rows"]:
                size_bytes, table_count = res2["rows"][0][0], res2["rows"][0][1]
        except DbbindError:
            pass
        if size_bytes is None and rec.get("via") == "local" and rec.get("file"):
            try:
                size_bytes = os.path.getsize(rec["file"])
            except OSError:
                size_bytes = None
        out["databases"] = [{"name": "main", "size_bytes": size_bytes,
                             "table_count": table_count}]
        try:
            for r in q("pragma database_list", rec, timeout=timeout)["rows"]:
                name = r[1] if len(r) > 1 else r[0]
                if name and name != "main":
                    out["databases"].append({"name": name, "size_bytes": None,
                                             "table_count": None})
        except DbbindError:
            pass
    out["duration_ms"] = int((time.monotonic() - t0) * 1000)
    return out


