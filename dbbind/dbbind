## 排错顺序

1. `dbbind doctor` —— 环境、客户端、配置文件、`$ENV` 自检
2. `dbbind test <别名>` —— 区分「网络/凭据问题」与「SQL 问题」
3. `dbbind show <别名>` —— 看来源（origin/config_file）与实际连接参数
4. `usable: false` —— 按 `usable_reason` 处理（装客户端 / 补字段 / 设置环境变量）
"""


# ---------------------------------------------------------------------------
# SQL 词法小工具（引号/注释感知；只用于解析与守卫，不改变 SQL 语义）
# ---------------------------------------------------------------------------

def scan_sql(sql, engine="mysql"):
    """扫描 SQL → (sig_end, statements)。

    sig_end = 最后一个有效字符之后的位置（注释/空白不算）。
    识别：'...' "..." `...` [...]、-- 注释、/* */ 注释、PG 的 $tag$ 引用。
    """
    n = len(sql)
    i = 0
    sig_end = 0
    stmts = []
    cur_start = None
    in_sq = in_dq = in_bt = in_br = False
    line_comment = block_comment = False
    dollar_tag = None
    while i < n:
        ch = sql[i]
        if line_comment:
            if ch == "\n":
                line_comment = False
            i += 1
            continue
        if block_comment:
            if sql.startswith("*/", i):
                block_comment = False
                i += 2
                continue
            i += 1
            continue
        if dollar_tag is not None:
            if sql.startswith(dollar_tag, i):
                i += len(dollar_tag)
                dollar_tag = None
                sig_end = i
                continue
            i += 1
            continue
        if in_sq:
            if ch == "\\" and i + 1 < n:
                i += 2
                sig_end = i
                continue
            if ch == "'":
                in_sq = False
            i += 1
            sig_end = i
            continue
        if in_dq:
            if ch == '"':
                in_dq = False
            i += 1
            sig_end = i
            continue
        if in_bt:
            if ch == "`":
                in_bt = False
            i += 1
            sig_end = i
            continue
        if in_br:
            if ch == "]":
                in_br = False
            i += 1
            sig_end = i
            continue
        if sql.startswith("--", i):
            line_comment = True
            i += 2
            continue
        if engine == "mysql" and ch == "#":
            line_comment = True
            i += 1
            continue
        if sql.startswith("/*", i):
            block_comment = True
            i += 2
            continue
        if ch == "'":
            in_sq = True
        elif ch == '"':
            in_dq = True
        elif ch == "`":
            in_bt = True
        elif ch == "[":
            in_br = True
        elif ch == "$":
            m = re.match(r"\$[A-Za-z_][A-Za-z0-9_]*\$|\$\$", sql[i:])
            if m:
                dollar_tag = m.group(0)
                i += len(dollar_tag)
                sig_end = i
                continue
        elif ch == ";":
            if cur_start is not None:
                stmts.append((cur_start, i))
                cur_start = None
            i += 1
            sig_end = i
            continue
        elif not ch.isspace():
            if cur_start is None:
                cur_start = i
        i += 1
        sig_end = i
    if cur_start is not None:
        stmts.append((cur_start, n))
    return sig_end, stmts


def strip_sql_tail(sql, engine="mysql"):
    """去掉尾部空白/分号/注释（把用户 SQL 嵌进子查询时必须做）。"""
    sig_end, _ = scan_sql(sql, engine)
    body = sql[:sig_end].rstrip()
    while body.endswith(";"):
        body = body[:-1].rstrip()
    return body


def count_statements(sql, engine="mysql"):
    _, stmts = scan_sql(sql, engine)
    return len([s for s in stmts if sql[s[0]:s[1]].strip()])


def first_keyword(sql, engine="mysql"):
    """忽略前导注释/空白，取第一个关键字（大写）。"""
    n = len(sql)
    i = 0
    while i < n:
        if sql[i].isspace():
            i += 1
            continue
        if sql.startswith("--", i) or (engine == "mysql" and sql[i] == "#"):
            j = sql.find("\n", i)
            i = n if j < 0 else j + 1
            continue
        if sql.startswith("/*", i):
            j = sql.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        break
    m = re.match(r"[A-Za-z_][A-Za-z0-9_$]*", sql[i:])
    return m.group(0).upper() if m else ""


# ---------------------------------------------------------------------------
# 只读守卫（宁可误报，不可漏报）+ 放行等级（DML / DDL 分权，CONTRACT §4.1）
# ---------------------------------------------------------------------------

# 只改数据、可回滚的：--write 可以放行
DML_KEYWORDS = {"INSERT", "UPDATE", "DELETE", "REPLACE", "MERGE"}

# 改结构 / 不可逆 / 能执行任意代码的：--write 挡住，必须 --unsafe
# 注意：只放**无歧义的独立关键字**。像 INTO / START / COMMENT 这种常见列名的词，
# 一律走下面的上下文模式（曾经把 `INSERT INTO` 误判成 DDL，等于 --write 对最高频的
# 写操作失效，还把用户往 --unsafe 引导）。
DDL_KEYWORDS = {
    "TRUNCATE", "DROP", "ALTER", "CREATE", "RENAME", "GRANT", "REVOKE", "ATTACH",
    "DETACH", "VACUUM", "LOCK", "UNLOCK", "COPY", "PRAGMA", "LOAD", "DO",
    "CALL", "EXECUTE", "PREPARE", "FLUSH", "OPTIMIZE", "REINDEX", "REFRESH",
    "SHUTDOWN", "INSTALL", "UNINSTALL",
    # 事务控制：只读场景下不该出现。它们是「先翻转引擎级 read-only 再写」的跳板
    # （verifier 实测 SET SESSION TRANSACTION READ WRITE; DELETE ... 能绕过安全网），
    # 按高危处理，要放行只能 --unsafe。
    "BEGIN", "COMMIT", "ROLLBACK", "SAVEPOINT",
}
WRITE_KEYWORDS = sorted(DML_KEYWORDS | DDL_KEYWORDS)

# 上下文相关的危险形态：不能裸匹配关键字，否则误报（见上）
_INSERT_INTO_RE = re.compile(r"\b(?:INSERT|REPLACE|MERGE)\s+INTO\b", re.I)
_TX_FLIP_PATTERNS = [
    # SELECT ... INTO newtable / INTO OUTFILE / COPY ... INTO（先把 DML 的 INTO 摘掉）
    (re.compile(r"\bCOPY\b[\s\S]*\bINTO\b", re.I), "COPY INTO"),
    (re.compile(r"\bSELECT\b[\s\S]*\bINTO\b", re.I), "SELECT INTO"),
    # START TRANSACTION（用上下文而不是裸 START，免得 select start from ... 被误拦）
    (re.compile(r"\bSTART\s+TRANSACTION\b", re.I), "START TRANSACTION"),
    # COMMENT ON TABLE ...（裸 COMMENT 是常见列名）
    (re.compile(r"\bCOMMENT\s+ON\b", re.I), "COMMENT ON"),
    # SET [SESSION] TRANSACTION READ WRITE / BEGIN READ WRITE /
    # SET SESSION CHARACTERISTICS AS TRANSACTION READ WRITE
    (re.compile(r"\bREAD\s+WRITE\b", re.I), "READ WRITE"),
    # SET ... transaction_read_only = off/false/0/no（MySQL 与 PG 的 sysvar 形式）
    (re.compile(r"\bSET\b[^;]*\b(?:transaction_read_only|default_transaction_read_only|"
                r"read_only)\b[^;]*?(?:=|\bTO\b)\s*(?:off|false|0|no)\b", re.I),
     "SET READ ONLY OFF"),
]
CONTEXT_LABELS = frozenset(label for _, label in _TX_FLIP_PATTERNS)
HIGH_RISK = frozenset(DDL_KEYWORDS | CONTEXT_LABELS)

# 只读 PRAGMA 白名单；不在名单里的一律当写操作（含赋值形式 pragma x=1）
PRAGMA_READ_OK = {
    "table_info", "table_xinfo", "table_list", "index_list", "index_info",
    "index_xinfo", "foreign_key_list", "database_list", "compile_options",
    "collation_list", "function_list", "module_list", "pragma_list",
    "integrity_check", "quick_check", "encoding", "page_count", "page_size",
    "freelist_count", "user_version", "schema_version", "application_id",
    "auto_vacuum", "journal_mode", "synchronous", "cache_size", "mmap_size",
    "temp_store", "locking_mode", "max_page_count", "secure_delete",
    "recursive_triggers", "foreign_keys", "defer_foreign_keys",
    "read_uncommitted", "query_only", "threads", "data_version", "stats",
    "busy_timeout", "wal_autocheckpoint", "cell_size_check", "trusted_schema",
}

_COMMENT_MARK = re.compile(r"/\*!?\d*|\*/|--[^\n]*|#[^\n]*")


def flatten_sql(sql, join=False):
    """去注释标记；join=True 时把内容粘起来，抓 DR/**/OP 这类拆分写法。"""
    if join:
        return _COMMENT_MARK.sub("", sql)
    return re.sub(r"/\*!?\d*|\*/", " ", re.sub(r"--[^\n]*|#[^\n]*", " ", sql))


def _pragma_is_write(text):
    for m in re.finditer(r"\bPRAGMA\b\s*(?:[A-Za-z_][A-Za-z0-9_]*\s*\.\s*)?"
                         r"([A-Za-z_][A-Za-z0-9_]*)?", text, re.I):
        name = (m.group(1) or "").lower()
        if not name or name not in PRAGMA_READ_OK:
            return True
        seg = text[m.end():m.end() + 80].split(";")[0]
        if "=" in seg:
            return True
    return False


def write_hits(sql):
    """返回命中的写关键字/危险形态（去重、保序）。空列表 = 放行。"""
    hits = []

    def add(word):
        if word not in hits:
            hits.append(word)

    for text in (sql, flatten_sql(sql), flatten_sql(sql, join=True)):
        if not text:
            continue
        for word in WRITE_KEYWORDS:
            if word == "PRAGMA":
                continue
            if re.search(r"\b%s\b" % word, text, re.I):
                add(word)
        if re.search(r"\bPRAGMA\b", text, re.I) and _pragma_is_write(text):
            add("PRAGMA")
        # 上下文相关的危险形态：先把 DML 的 `INSERT/REPLACE/MERGE INTO` 摘掉再判
        ctx = _INSERT_INTO_RE.sub(" ", text)
        for pat, label in _TX_FLIP_PATTERNS:
            if pat.search(ctx):
                add(label)
    return hits


def guard_sql(rec, sql, write_ok=False, unsafe=False):
    """只读守卫。返回要追加的 warnings；拒绝时抛 READONLY_BLOCKED / DDL_BLOCKED(3)。"""
    hits = write_hits(sql)
    if not hits:
        return []
    alias = rec["name"]
    if not rec.get("read_only"):
        return []                                    # 可写别名：建别名时就接受了
    high = [h for h in hits if h in HIGH_RISK]
    if unsafe:
        return ["已用 --unsafe 放行只读守卫（命中：%s）" % "、".join(hits)]
    if write_ok:
        if high:
            die("DDL_BLOCKED",
                "别名 %s 为只读模式，--write 只放行数据修改，拒绝执行结构变更" % alias,
                "命中高危形态：%s；确认要改结构请加 --unsafe" % "、".join(high),
                exit_code=EXIT_READONLY)
        return ["--write 放行：在只读别名 %s 上执行了数据修改（命中：%s）"
                % (alias, "、".join(hits))]
    die("READONLY_BLOCKED",
        "别名 %s 为只读模式，拒绝执行写操作" % alias,
        "命中写关键字：%s；确认要写请：dbbind add %s --allow-write --force，"
        "或单次加 --write（改结构用 --unsafe）" % ("、".join(hits), alias),
        exit_code=EXIT_READONLY)


