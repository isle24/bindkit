def _strip_block(text):
    out, skip = [], False
    for line in text.splitlines(True):
        stripped = line.strip()
        if stripped.startswith("# >>> sshbind managed block"):
            skip = True
            continue
        if stripped.startswith("# <<< sshbind managed block"):
            skip = False
            continue
        if not skip:
            out.append(line)
    return "".join(out)


def render_block(servers):
    servers = {name: server for name, server in servers.items()
               if server.get('key') and server.get('verification_status') != 'pending'}
    if not servers:
        return ""
    parts = [BLOCK_BEGIN]
    for name in sorted(servers):
        s = servers[name]
        parts.append("")
        parts.append("Host %s" % s["name"])
        parts.append("    HostName %s" % s["host"])
        parts.append("    User %s" % s["user"])
        parts.append("    Port %s" % s["port"])
        parts.append("    IdentityFile %s" % s["key"])
        if s.get("certificate"):
            parts.append("    CertificateFile %s" % s["certificate"])
        parts.append("    IdentitiesOnly yes")
        parts.append("    ServerAliveInterval 30")
        parts.append("    ServerAliveCountMax 3")
    parts.append("")
    parts.append(BLOCK_END)
    return "\n".join(parts) + "\n"


def write_ssh_config(servers):
    ensure_dirs()
    existing = ""
    if os.path.exists(SSH_CONFIG):
        with open(SSH_CONFIG, "r", encoding="utf-8") as f:
            existing = f.read()
        try:
            shutil.copy2(SSH_CONFIG, SSH_CONFIG + ".sshbind.bak")
        except OSError:
            pass

    body = _strip_block(existing).rstrip("\n")
    block = render_block(servers)
    new_content = (body + "\n\n" + block) if block else (body + "\n" if body else "")
    if new_content == existing:
        return False
    tmp = SSH_CONFIG + ".sshbind.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(new_content)
    os.chmod(tmp, 0o600)
    os.replace(tmp, SSH_CONFIG)
    return True


