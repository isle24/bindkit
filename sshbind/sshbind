def cmd_test(args):
    state = load_state()
    servers = state["servers"]
    targets = sorted(servers) if args.all else [args.name]
    if not targets or targets == [None]:
        die("请指定名称，或用 --all 测试全部")
    bad = 0
    for name in targets:
        s = servers.get(name)
        if not s:
            print("  %-16s %s" % (name, "未找到该绑定"))
            bad += 1
            continue
        if s.get("verification_status") == "pending":
            # CLI test is a read-only probe. Installing keys and activating an
            # imported alias requires the user's explicit Web test action.
            print("  %-16s 待验证，请本人在 Web 控制台点击测试连接完成启用" % name)
            bad += 1
            continue
        if not os.path.exists(s["key"]):
            print("  %-16s %s" % (name, "私钥文件缺失，无法测试"))
            bad += 1
            continue
        alive, details = test_connection(s["host"], s["user"], s["port"],
                                         s["key"], s.get("certificate"))
        if alive:
            head = details[0] if details else ""
            tail = details[1] if len(details) > 1 else ""
            print("  %-16s 连通  %s%s" % (name, head, (" (%s)" % tail) if tail else ""))
        else:
            print("  %-16s 失败  %s" % (name, details[0] if details else "未知"))
            bad += 1
    print()
    if bad:
        print("  %s" % (C_WARN + "%d/%d 台不可用" % (bad, len(targets)) + C_OFF))
        return 1
    print("  %s" % (C_OK + "全部 %d 台连通正常" % len(targets) + C_OFF))
    return 0


def cmd_remove(args):
    state = load_state()
    s = state["servers"].get(args.name)
    if not s:
        die("没有名为 %s 的绑定" % args.name)

    adopted = s.get("source") == "adopted"
    do_revoke = not args.no_revoke
    delete_key = args.delete_key or (not adopted and not args.keep_key)
    keyfile = s.get("key")
    has_key_path = isinstance(keyfile, str) and bool(keyfile.strip()) and "\x00" not in keyfile

    print()
    print("  即将解绑  %s  (%s@%s:%s)" % (bold(args.name), s["user"], s["host"], s["port"]))
    print("  %s" % ("-" * 46))
    if do_revoke:
        print("   · 从远端 ~/.ssh/authorized_keys 移除对应公钥行")
    else:
        print("   · 跳过远端清理（--no-revoke）")
    print("   · 从 ~/.ssh/config 移除该 Host 条目")
    print("   · 删除本地密钥文件" if delete_key else "   · 保留本地密钥文件 %s" % s["key"])
    if adopted and not args.delete_key:
        print()
        print("  %s" % (C_DIM + "ℹ️  这是 adopt 纳管的已有密钥，默认保留不删" + C_OFF))
    print()

    if not args.yes:
        if not sys.stdin.isatty():
            die("非交互式终端，请加 --yes 确认")
        ans = input("  确认解绑？输入 yes 继续: ").strip().lower()
        if ans != "yes":
            print("  已取消，未做任何改动")
            return 0

    if do_revoke and has_key_path and os.path.isfile(keyfile):
        info("正在从远端移除公钥 …")
        pubkey = read_pubkey_for(s["key"])
        if not pubkey:
            warn("无法读取公钥（加密私钥且无 .pub），跳过远端清理")
        else:
            remote_ok, remote_msg = uninstall_pubkey(
                s["host"], s["user"], s["port"], s["key"], pubkey,
                s.get("certificate"))
            if remote_ok:
                ok(remote_msg)
            else:
                warn(remote_msg)
                if not args.force:
                    print()
                    print("  远端清理失败，服务器上仍保留着这把公钥（等于留了一把能登录的钥匙）。")
                    print("  建议你手动登录删掉它；确认无所谓可加 --force 继续。")
                    print()
                    if not ask_yes_no("  仍要继续？[y/N] ", default=False):
                        print("  已取消")
                        return 1
    elif do_revoke:
        warn("本地私钥不存在，跳过远端清理")

    if delete_key and has_key_path:
        for p in (keyfile, keyfile + ".pub"):
            if os.path.isfile(p):
                os.remove(p)
        info("本地密钥已删除")
    elif delete_key:
        info("此连接没有本地密钥，无需删除")
    else:
        info("本地密钥已保留：%s" % s["key"])

    state["servers"].pop(args.name, None)
    save_state(state)
    write_ssh_config(state["servers"])
    ok("已解绑 %s" % args.name)
    print()
    return 0


def cmd_import(args):
    source = args.source.lower()
    if source not in ("finalshell", "fs"):
        die("暂不支持的来源：%s\n  目前支持：finalshell" % args.source)

    base_dir = find_finalshell_dir(args.dir)
    if not base_dir:
        die("找不到 FinalShell 配置目录。\n  已尝试：\n    %s\n"
            "  可以用 --dir 手动指定。" % "\n    ".join(FINALSSHELL_DIRS))

    conns, keyed = parse_finalshell(base_dir)
    if not conns:
        die("在 %s 里没有找到任何连接配置" % base_dir)

    if args.only:
        wanted = set(x.strip() for x in args.only.split(",") if x.strip())
        conns = [c for c in conns if c["name"] in wanted or c["host"] in wanted]
        if not conns:
            die("--only 没有匹配到任何连接")

    renames = {}
    for pair in (args.rename or []):
        if "=" not in pair:
            die("--rename 需要 OLD=NEW 格式，例如 --rename '混混pay=pay'")
        k, v = pair.split("=", 1)
        renames[k.strip()] = v.strip()

    state = load_state()
    taken = set(state["servers"].keys())
    planned = []
    for c in conns:
        alias = make_alias(renames.get(c["name"], c["name"]), c["host"], taken)
        taken.add(alias)
        planned.append((alias, c))

    print()
    print("  来源：%s" % base_dir)
    print("  找到 %d 个连接%s" % (len(planned),
                                 ("（其中 %d 个是密钥型，暂不自动导入）" % keyed) if keyed else ""))
    print("  %s" % ("-" * 68))
    print("  %-18s %-24s %-16s %s" % ("SSH 别名", "服务器", "用户名", "备注"))
    print("  %s" % ("-" * 68))
    for alias, c in planned:
        note = "密钥型，跳过" if c["is_key"] else ("有密码" if c["password_enc"] else "无密码")
        orig = "" if alias == c["name"] else "（原名 %s）" % c["name"]
        print("  %-18s %-24s %-16s %s%s" % (
            alias, "%s:%s" % (c["host"], c["port"]), c["user"], note, orig))
    print()

    if not args.with_passwords:
        print("  以上仅为预览，尚未做任何改动。")
        print()
        print("  要真正导入并完成免密绑定（会解密 FinalShell 保存的密码，仅用于登录一次）：")
        print("      %s" % bold("sshbind import finalshell --with-passwords"))
        print()
        print("  想改别名：%s" % "sshbind import finalshell --rename '原名=新名'")
        print("  只导入部分：%s" % "sshbind import finalshell --only 名称1,名称2")
        print()
        return 0

    if not args.yes:
        if not sys.stdin.isatty():
            die("非交互式终端，请加 --yes 确认")
        ans = input("  开始导入？会对每台服务器发起一次真实连接。输入 yes 继续: ").strip().lower()
        if ans != "yes":
            print("  已取消，未做任何改动")
            return 0

    print()
    stats = {"bound": 0, "pending": 0, "skipped": 0}
    for alias, c in planned:
        tag = "%-18s" % alias
        if c["is_key"]:
            warn("%s 跳过：密钥型连接，请用 sshbind adopt 手动纳管" % tag)
            stats["skipped"] += 1
            continue
        try:
            password = finalshell_decode_password(c["password_enc"])
        except Exception as e:
            warn("%s 跳过：密码解密失败（%s）" % (tag, e))
            stats["skipped"] += 1
            continue
        if not password:
            warn("%s 跳过：FinalShell 里没有保存密码" % tag)
            stats["skipped"] += 1
            continue

        priv, pub = gen_keypair(alias, key_type=args.key_type)
        pubkey = read_pubkey(alias)
        fp = fingerprint_of(pubkey)

        auth = make_auth(AUTH_PASSWORD, password=password)
        del password
        pushed, msg = install_pubkey(c["host"], c["user"], c["port"], auth,
                                     pubkey, restrict=args.restrict)
        auth = None

        if pushed:
            alive, details = test_connection(c["host"], c["user"], c["port"], priv)
            state["servers"][alias] = _record(
                alias, c["host"], c["user"], c["port"], priv, fp,
                args.key_type, args.restrict, None, "generated", installed=True)
            save_state(state)
            if alive:
                ok("%s ✅ 已绑定  %s@%s:%s" % (tag, c["user"], c["host"], c["port"]))
                stats["bound"] += 1
            else:
                warn("%s 公钥已推送但免密验证未通过：%s" % (tag, details[0] if details else "?"))
                stats["pending"] += 1
        else:
            warn("%s 绑定失败：%s" % (tag, msg))
            warn("%s   → 私钥已生成保留，可手动加公钥：sshbind pubkey %s" % (" " * 18, alias))
            state["servers"][alias] = _record(
                alias, c["host"], c["user"], c["port"], priv, fp,
                args.key_type, args.restrict, None, "generated", installed=False)
            save_state(state)
            stats["pending"] += 1

    write_ssh_config(state["servers"])
    print()
    print("  完成：成功 %d，待处理 %d，跳过 %d" % (
        stats["bound"], stats["pending"], stats["skipped"]))
    if stats["bound"]:
        print("  试试：  ssh %s" % planned[0][0])
    print()
    return 0 if stats["bound"] or not stats["pending"] else 1


# ---------------------------------------------------------------------------
# bindconsole：策略闸门 + 本机 Web 控制台（CONTRACT bindconsole §3/§4/§8）
# ---------------------------------------------------------------------------

BINDCONSOLE_INSTALL_CMD = "curl -fsSL https://github.com/isle24/bindkit/releases/latest/download/install.sh | bash"


def die_fail_closed(message, code="STATE_CORRUPT", hint=None):
    """fail-closed 拒绝：人类可读输出必须打印稳定的 error.code（契约 §8.1.1）。"""
    sys.stderr.write("ERROR %s\n" % message)
    sys.stderr.write("     code: %s\n" % code)
    if hint:
        sys.stderr.write("     %s\n" % hint)
    sys.stderr.flush()
    sys.exit(1)
_POLICY_MODULE = None
SSH_APPROVAL_RC = {"AUTHZ_DENIED": 5, "SUDO_DENIED": 5, "APPROVAL_REQUIRED": 6}


def bindconsole_home():
    return (os.environ.get("BINDCONSOLE_HOME")
            or os.path.join(os.path.expanduser("~"), ".bindconsole"))


def bindconsole_lib():
    return os.path.join(bindconsole_home(), "lib")


def load_policy_module(required=False):
    """从 ~/.bindconsole/lib 加载策略模块（单一真源）。

    fail-closed 边界（CONTRACT §8.1.1）：
      * policy.json 不存在 + 模块缺失 → 返回 None（allow，保持改造前行为）
      * policy.json 存在   + 模块缺失 → 直接拒绝并给安装命令（不能静默放行）
    """
    global _POLICY_MODULE
    if _POLICY_MODULE is not None:
        return _POLICY_MODULE
    lib = bindconsole_lib()
    if os.path.isdir(lib) and lib not in sys.path:
        sys.path.insert(0, lib)
    try:
        import bindkit_policy as mod
        _POLICY_MODULE = mod
        return mod
    except Exception as e:                     # noqa: BLE001
        if required:
            die("找不到 bindconsole 内核：%s（%s）\n  先安装：%s"
                % (lib, e, BINDCONSOLE_INSTALL_CMD))
        policy_path = os.path.join(os.path.expanduser("~"), ".ssh", "sshbind",
                                   "policy.json")
        if os.path.exists(policy_path):
            # 人类输出带 code=STATE_CORRUPT（dbbind 同款），机器/人都能稳定判定
            die_fail_closed(
                "策略文件存在但 bindconsole 内核缺失/无法加载，已按 fail-closed 拒绝。\n"
                "  policy: %s\n  重新安装内核：%s\n  （加载错误：%s）"
                % (policy_path, BINDCONSOLE_INSTALL_CMD, e))
        return None


def _extension_module(name, required=False):
    for directory in (bindconsole_lib(), os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "bindconsole")):
        if os.path.isdir(directory) and directory not in sys.path:
            sys.path.insert(0, directory)
    try:
        return importlib.import_module(name)
    except Exception:
        if required:
            raise _console_fail("扩展内核不可用，请重新安装 BindKit。", "UNSUPPORTED") from None
        return None


def _self_module():
    return types.SimpleNamespace(**globals())


def _policy_gate_ssh(alias, command, context=None):
    mod = load_policy_module()
    if mod is None:
        return None
    try:
        return mod.gate_ssh(alias, command, requester="ai", **({"context": context} if context is not None else {}))
    except Exception:                          # noqa: BLE001 —— 闸门绝不抛给主流程
        return {"decision": "deny", "code": "AUTHZ_DENIED",
                "message": "策略校验内部错误，已按 fail-closed 拒绝",
                "hint": "查看 ~/.bindconsole/audit.log"}


def _emit_gate_ssh(args, gate, command):
    """输出闸门拒绝/待审批并返回退出码（CONTRACT §5.1 ssh 结构）。"""
    code = gate.get("code") or "AUTHZ_DENIED"
    rc = SSH_APPROVAL_RC.get(code, 1)
    err = {"code": code, "message": gate.get("message") or "授权校验未通过"}
    for key in ("hint", "request_id", "expires_at"):
        if gate.get(key):
            err[key] = gate[key]
    if getattr(args, "json", False):
        print(json.dumps({
            "ok": False, "blocked": True, "alias": args.name, "command": command,
            "error": err, "exit_code": rc, "stdout": "", "stderr": "", "duration_ms": 0,
        }, ensure_ascii=False, indent=2))
        return rc
    sys.stdout.flush()
    print("%s❌ %s%s" % (C_ERR, err["message"], C_OFF) if _tty() else "ERROR " + err["message"],
          file=sys.stderr)
    print("     code: %s" % code, file=sys.stderr)
    if err.get("request_id"):
        print("     request_id: %s" % err["request_id"], file=sys.stderr)
    if err.get("expires_at"):
        print("     过期时间: %s" % err["expires_at"], file=sys.stderr)
    if err.get("hint"):
        print("     %s" % err["hint"], file=sys.stderr)
    sys.stderr.flush()
    return rc


# ---- 控制台 handlers ------------------------------------------------------

_SSH_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
_SSH_SUDO_MODES = ("allow", "ask", "deny")


# 业务错误码 → HTTP 状态（内核会把 ConsoleError.status 原样映射）
_CONSOLE_STATUS = {"NOT_FOUND": 404, "CONFLICT": 409, "ALREADY_EXISTS": 409,
                   "INVALID_REQUEST": 400, "INVALID_PARAM": 400}


def _console_fail(message, code="INVALID_REQUEST", hint=None):
    """抛给内核的四类错误：优先用内核的 ConsoleError（带精确 4xx），否则 ValueError。"""
    status = _CONSOLE_STATUS.get(code, 400)
    try:
        from bindkit_console import ConsoleError
        return ConsoleError(code, message, hint, status=status)
    except Exception:                          # noqa: BLE001
        return ValueError(message)


def _console_policy_module():
    mod = load_policy_module()
    if mod is None:
        raise _console_fail("bindconsole 内核未安装，无法读写策略", "INTERNAL",
                            "先执行：%s" % BINDCONSOLE_INSTALL_CMD)
    return mod


def _console_name(name):
    name = str(name or "").strip()
    if not _SSH_NAME_RE.match(name) or ".." in name:
        raise _console_fail("服务器名不合法（只允许字母数字._-，且不能以符号开头）")
    return name


def _console_ssh_policy_map(mod):
    pol = mod.read_policy("ssh")
    return (pol.get("data") or {}) if pol.get("exists") and not pol.get("corrupt") else {}


def _self_script():
    """自己的可执行路径（控制台 handler 需要 subprocess 调自身 CLI）。"""
    own = os.path.abspath(__file__)
    if os.path.isfile(own):
        return own
    wh = shutil.which("sshbind")
    if wh:
        return wh
    cand = os.path.abspath(sys.argv[0]) if sys.argv and sys.argv[0] else ""
    if cand and os.path.isfile(cand):
        return cand
    return os.path.join(os.path.expanduser("~"), ".local", "bin", "sshbind")


def _run_self(extra_args, stdin_data=None, timeout=180):
    """参数数组调自身 CLI（不经 shell）；密码走 stdin，不进 argv。"""
    cmd = [sys.executable, _self_script()] + list(extra_args)
    try:
        proc = subprocess.run(cmd, input=stdin_data.encode("utf-8") if stdin_data else None,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              stdin=None if stdin_data else subprocess.DEVNULL,
                              timeout=timeout)
    except subprocess.TimeoutExpired:
        raise _console_fail("操作超时（%ss）" % timeout)
    return (proc.returncode, proc.stdout.decode("utf-8", "replace"),
            proc.stderr.decode("utf-8", "replace"))


def _console_ssh_item(name, srv, mod):
    key_ok = os.path.exists(srv.get("key") or "")
    installed = bool(srv.get("installed", True))
    eff = mod.effective_ssh_policy(_console_ssh_policy_map(mod), name) if mod else None
    policy_entry = (_console_ssh_policy_map(mod).get("servers", {}) or {}).get(name) or {}
    return {
        "name": name,
        "host": srv.get("host"),
        "user": srv.get("user"),
        "port": srv.get("port"),
        "source": srv.get("source", "generated"),
        "installed": installed,
        "key_exists": key_ok,
        "usable": bool(key_ok and installed and srv.get("verification_status") != "pending"),
        "fingerprint": srv.get("fingerprint"),
        "created_at": srv.get("created_at"),
        "has_key": key_ok,
        "sudo": eff["sudo"] if eff else "ask",
        "approval_ttl_s": eff["approval_ttl_s"] if eff else 600,
        "note": policy_entry.get("note"),
        "last_test": None,
        "id": srv.get("id"), "revision": srv.get("revision", 0),
        "allowed_users": eff.get("allowed_users", []) if eff else [],
        "sudo_auth": srv.get("sudo_auth", "none"),
        "has_sudo_credential": bool(srv.get("sudo_credential_ref")),
        "verification_status": srv.get("verification_status", "verified" if installed else "pending"),
        "has_login_credential": bool(srv.get("login_credential_ref")),
        "has_encrypted_login": bool(srv.get("encrypted_login_ref")),
    }


def console_ssh_list():
    state = load_state()
    mod = load_policy_module()
    return {"items": [_console_ssh_item(n, state["servers"][n], mod)
                      for n in sorted(state["servers"])]}


def console_ssh_get(name):
    name = _console_name(name)
    state = load_state()
    if name not in state["servers"]:
        raise _console_fail("没有这个服务器：%s" % name, "NOT_FOUND")
    return _console_ssh_item(name, state["servers"][name], load_policy_module())


def console_ssh_create(body):
    # The CLI create subprocess takes the shared mutation lock itself. Do not
    # hold it while waiting for that subprocess; credential attachment takes a
    # separate lock after its verified state commit.
    return _console_ssh_create_transaction(body)


def console_ssh_create_unverified(body):
    pending = _extension_module("bindkit_pending", required=True)
    connections = _extension_module("bindkit_connections", required=True)
    try:
        return pending.create_unverified(_self_module(), body)
    except connections.ConnectionError as exc:
        raise _console_fail(str(exc), exc.code) from None


def _console_ssh_create_transaction(body):
    """创建失败且未登记服务器时，恢复本次写入前的策略。"""
    if not isinstance(body, dict):
        raise _console_fail("请求体必须是 JSON 对象")
    name = _console_name(body.get("name") or body.get("alias"))
    if name in load_state()["servers"]:
        raise _console_fail("服务器已存在：%s" % name, "CONFLICT")
    mod = _console_policy_module()
    before = mod.read_policy("ssh")
    if before.get("corrupt"):
        raise _console_fail("SSH 策略损坏，请先修复策略", "INVALID_REQUEST")
    try:
        pending = _extension_module("bindkit_pending", required=True)
        return pending.preserve_verified_password(_self_module(), body, lambda: _console_ssh_create(body))
    except Exception:
        # adopt 可能已保存记录、随后更新 SSH config 失败；这种情况保留密钥与策略。
        if name not in load_state()["servers"]:
            after = mod.read_policy("ssh")
            if after.get("exists") and not after.get("corrupt"):
                base = json.loads(json.dumps(before.get("data") or mod.default_policy("ssh")))
                entry = {k: body[k] for k in ("sudo", "note", "approval_ttl_s", "allowed_users") if k in body}
                base.setdefault("servers", {}).setdefault(name, {}).update(entry)
                expected = _console_clean_ssh_policy(base)
                # 只恢复本次自己写出的版本，避免覆盖并发发生的其它策略编辑。
                if after.get("data") == expected:
                    if before.get("exists"):
                        mod.write_policy("ssh", before["data"])
                    else:
                        os.remove(mod.tool_paths("ssh")["policy"])
        raise _console_fail("创建连接失败，请检查连接信息、凭据与本地存储权限；未撤销远端已有公钥，可用正确密码或私钥重新绑定。", "CONNECTION_CREATE_FAILED") from None


def _console_ssh_create(body):
    if not isinstance(body, dict):
        raise _console_fail("请求体必须是 JSON 对象")
    name = _console_name(body.get("name") or body.get("alias"))
    host = str(body.get("host") or "").strip()
    if not host:
        raise _console_fail("必须提供 host")
    user = str(body.get("user") or "root").strip() or "root"
    try:
        port = int(body.get("port") or 22)
    except (TypeError, ValueError):
        raise _console_fail("port 必须是整数")
    auth = body.get("auth") if isinstance(body.get("auth"), dict) else {}
    password = auth.get("password")
    if password is None:
        password = body.get("password")
    private_key = auth.get("private_key") or body.get("private_key")
    state = load_state()
    if name in state["servers"]:
        raise _console_fail("服务器已存在：%s" % name, "CONFLICT")
    policy_entry = {key: body[key] for key in ("sudo", "note", "approval_ttl_s", "allowed_users")
                    if key in body}
    if policy_entry:
        policy_entry = _console_clean_ssh_policy(
            {"servers": {name: policy_entry}})["servers"][name]
        # 登记前先落策略；无效策略/写失败不能留下无授权限制的新服务器。
        console_ssh_policy_put({"servers": {name: policy_entry}})

    if isinstance(private_key, str) and private_key.strip():
        # adopt 只登记路径：粘贴的私钥必须保留在受管目录，失败才清理本次文件。
        os.makedirs(KEYS_DIR, mode=0o700, exist_ok=True)
        fd, keyfile = tempfile.mkstemp(prefix=name + "-console-", dir=KEYS_DIR)
        adopted = False
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(private_key if private_key.endswith("\n")
                        else private_key + "\n")
            rc, out, err = _run_self(["adopt", name, "--require-verified", "--host", host, "--user", user,
                                      "--port", str(port), "--identity", keyfile])
            adopted = rc == 0
        finally:
            if not adopted:
                # 非零退出也可能已经登记成功；清理前查持久状态，避免删掉在用私钥。
                registered = any(s.get("key") == keyfile
                                 for s in load_state()["servers"].values())
                if not registered:
                    try:
                        os.remove(keyfile)
                    except OSError:
                        pass
        if rc != 0:
            raise _console_fail("导入私钥失败，请检查密钥与连接信息。", "CONNECTION_CREATE_FAILED")
        row = load_state()["servers"].get(name) or {}
        return {"ok": True, "name": name, "auth": "private_key", "id": row.get("id")}

    if isinstance(password, str) and password:
        # 密码导入：走 add --password-stdin（密码走 stdin，不进 argv）
        rc, out, err = _run_self(["add", name, "--require-verified", "--host", host, "--user", user,
                                  "--port", str(port), "--password-stdin"],
                                 stdin_data=password + "\n")
        if rc != 0:
            raise _console_fail("添加连接失败，请检查登录凭据与网络。", "CONNECTION_CREATE_FAILED")
        row = load_state()["servers"].get(name) or {}
        return {"ok": True, "name": name, "auth": "password", "id": row.get("id")}

    raise _console_fail("需要提供 auth.password 或 auth.private_key")


def console_ssh_update(name, body):
    name = _console_name(name)
    if not isinstance(body, dict):
        raise _console_fail("请求体必须是 JSON 对象")
    state = load_state()
    if name not in state["servers"]:
        raise _console_fail("没有这个服务器：%s" % name, "NOT_FOUND")
    mod = _console_policy_module()
    current = mod.read_policy("ssh")
    if current.get("corrupt"):
        raise _console_fail("SSH 策略损坏，请先修复策略", "STATE_CORRUPT")
    policy = json.loads(json.dumps(current.get("data") or mod.default_policy("ssh")))
    policy_fields = {key: body[key] for key in ("sudo", "note", "approval_ttl_s", "allowed_users") if key in body}
    # Validate the complete combined request before any credential/network mutation.
    clean = _console_clean_ssh_policy({"servers": {name: policy_fields}})["servers"][name]
    credential_fields = {key: body[key] for key in ("host", "user", "port", "login_password", "private_key", "sudo_password", "sudo_auth", "clear_sudo_password") if key in body}
    result = {"ok": True, "name": name, "changed": []}
    connections = None
    if credential_fields:
        connections = _extension_module("bindkit_connections", required=True)
        try:
            connections._validate(state["servers"][name], credential_fields)
        except connections.ConnectionError as exc:
            raise _console_fail(str(exc), exc.code) from None
    if policy_fields:
        policy.setdefault("servers", {})
        if not isinstance(policy["servers"].get(name), dict):
            policy["servers"][name] = {}
        policy["servers"][name].update(clean)
        try:
            mod.write_policy("ssh", policy)
        except Exception:
            raise _console_fail("策略保存失败，连接凭据未修改。", "POLICY_UPDATE_FAILED") from None
    try:
        if credential_fields:
            result = connections.update_connection(_self_module(), name, credential_fields)
    except Exception as exc:
        if policy_fields:
            try:
                latest = mod.read_policy("ssh")
                if latest.get("data") == policy:
                    if current.get("exists"):
                        mod.write_policy("ssh", current["data"])
                    else:
                        os.remove(mod.tool_paths("ssh")["policy"])
            except Exception:
                raise _console_fail("凭据更新失败且策略恢复失败，请人工检查服务器策略。", "ROLLBACK_FAILED") from None
        if connections is not None and isinstance(exc, connections.ConnectionError):
            raise _console_fail(str(exc), exc.code) from None
        raise _console_fail("连接凭据更新失败，请检查连接与钥匙串状态。", "CONNECTION_UPDATE_FAILED") from None
    result["changed"].extend(policy_fields)
    return result


def console_ssh_users(name):
    name = _console_name(name)
    server = load_state()["servers"].get(name)
    if not server:
        raise _console_fail("没有这个服务器", "NOT_FOUND")
    if not server.get("installed", True) or not os.path.isfile(server.get("key") or ""):
        raise _console_fail("连接或私钥不可用", "CONNECTION_UNAVAILABLE")
    command = ssh_with_key(server["host"], server["user"], server["port"], server["key"], server.get("certificate")) + ["getent passwd"]
    try:
        rc, out, _ = run_ssh(command, timeout=20)
    except Exception:
        raise _console_fail("读取服务器用户失败，请检查连接与 getent 支持。", "USER_DISCOVERY_FAILED") from None
    if rc or len(out) > 1024 * 1024:
        raise _console_fail("读取服务器用户失败或结果超出限制。", "USER_DISCOVERY_FAILED")
    users = []
    for line in out.splitlines():
        fields = line.split(":")
        if len(fields) < 7 or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]{0,63}", fields[0]) or not fields[2].isdigit():
            continue
        uid = int(fields[2])
        users.append({"name": fields[0], "uid": uid, "sensitive": uid < 1000 or fields[0].lower() in ("root", "admin", "administrator", "sudo", "wheel", "nobody")})
        if len(users) > 5000:
            raise _console_fail("服务器用户数量超出限制。", "USER_DISCOVERY_FAILED")
    return {"users": users}


def console_ssh_delete(name, body=None):
    name = _console_name(name)
    state = load_state()
    if name not in state["servers"]:
        raise _console_fail("没有这个服务器：%s" % name, "NOT_FOUND")
    body = body if isinstance(body, dict) else {}
    args = ["remove", name, "--yes"]
    # 默认只删本地记录/密钥，不联网吊销（控制台删除要快且可离线）；
    # 需要吊销远端公钥时传 {"revoke": true}
    if not body.get("revoke"):
        args.append("--no-revoke")
    if body.get("delete_key"):
        args.append("--delete-key")
    if body.get("keep_key"):
        args.append("--keep-key")
    if body.get("force"):
        args.append("--force")
    rc, out, err = _run_self(args)
    if rc != 0:
        raise _console_fail("删除失败：%s" % (_last_line(err) or _last_line(out)
                                             or "未知错误"))
    return {"ok": True, "deleted": name, "revoked": bool(body.get("revoke"))}


def console_ssh_test(name):
    name = _console_name(name)
    state = load_state()
    srv = state["servers"].get(name)
    if not srv:
        raise _console_fail("没有这个服务器：%s" % name, "NOT_FOUND")
    if srv.get("verification_status") == "pending":
        pending = _extension_module("bindkit_pending", required=True)
        connections = _extension_module("bindkit_connections", required=True)
        try:
            return pending.verify_pending(_self_module(), name)
        except connections.ConnectionError as exc:
            raise _console_fail(str(exc), exc.code) from None
    if not os.path.exists(srv.get("key") or ""):
        return {"ok": False, "usable": False, "message": "私钥文件缺失，无法测试"}
    alive, details = test_connection(srv["host"], srv["user"], srv["port"],
                                     srv["key"], srv.get("certificate"))
    return {"ok": bool(alive), "usable": bool(alive),
            "message": (details[0] if details else ("连通正常" if alive else "失败")),
            "details": details[:3]}


def console_ssh_unlock(name, body):
