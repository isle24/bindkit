# SSH config 的 Host 别名只接受这些字符（中文会报 "hostname contains invalid characters"）
ALIAS_SAFE = re.compile(r"[^A-Za-z0-9._-]")


def make_alias(preferred, host, taken):
    """把任意名称转成 SSH config 能接受的 ASCII 别名，并保证不重复。"""
    base = ALIAS_SAFE.sub("", (preferred or "").strip())
    base = base.strip("._-")
    if not base or not re.match(r"^[A-Za-z0-9]", base):
        base = ALIAS_SAFE.sub("-", (host or "").strip()).strip("-")
        base = re.sub(r"-+", "-", base)
    if not base:
        base = "server"
    base = base[:48]
    alias, n = base, 2
    while alias in taken:
        alias = "%s-%d" % (base, n)
        n += 1
    return alias


def find_finalshell_dir(explicit=None):
    for d in ([explicit] if explicit else FINALSSHELL_DIRS):
        if d and os.path.isdir(os.path.join(d, "conn")):
            return d
    return None


def parse_finalshell(base_dir):
    """解析 FinalShell 的连接配置。返回 (连接列表, 密钥型连接数)。"""
    conn_dir = os.path.join(base_dir, "conn")
    conns, keyed = [], 0
    for path in sorted(glob_mod.glob(os.path.join(conn_dir, "*_connect_config.json"))):
        try:
            with open(path, "r", encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        host = (d.get("host") or "").strip()
        if not host:
            continue
        is_key = bool(d.get("secret_key_id")) or d.get("authentication_type") == 2
        if is_key:
            keyed += 1
        conns.append({
            "name": (d.get("name") or host).strip(),
            "host": host,
            "port": int(d.get("port") or 22),
            "user": (d.get("user_name") or "root").strip(),
            "password_enc": d.get("password") or "",
            "is_key": is_key,
            "source_file": path,
        })
    return conns, keyed


# ---------------------------------------------------------------------------
# ssh 调用封装
# ---------------------------------------------------------------------------

BASE_SSH_OPTS = [
    "-o", "StrictHostKeyChecking=accept-new",   # 首次自动记录主机指纹
    "-o", "ConnectTimeout=15",
    "-o", "ServerAliveInterval=30",
    "-o", "ServerAliveCountMax=3",
]


def ssh_base(host, user, port):
    return ["ssh"] + BASE_SSH_OPTS + ["-p", str(port)]


def ssh_with_key(host, user, port, keyfile, certificate=None, batch=True):
    """用指定私钥构造 ssh 命令；batch=True 时禁止回退到密码，真正验证密钥生效。"""
    cmd = ssh_base(host, user, port) + ["-i", keyfile, "-o", "IdentitiesOnly=yes"]
    if certificate:
        cmd += ["-o", "CertificateFile=%s" % certificate]
    if batch:
        cmd += ["-o", "BatchMode=yes", "-o", "PasswordAuthentication=no",
                "-o", "PreferredAuthentications=publickey"]
    cmd.append("%s@%s" % (user, host))
    return cmd


def run_ssh(cmd, secret_handle=None, stdin_data=None, timeout=120):
    env = secret_handle.env() if secret_handle else None
    try:
        proc = subprocess.run(
            cmd,
            input=(stdin_data.encode("utf-8") if isinstance(stdin_data, str) else stdin_data),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            stdin=(subprocess.DEVNULL if stdin_data is None else None),
            env=env,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return 124, "", "超时（%ss）：无法在限定时间内完成" % timeout
    return (proc.returncode,
            proc.stdout.decode("utf-8", "replace"),
            proc.stderr.decode("utf-8", "replace"))


def classify_ssh_error(rc, err, out, timeout=120):
    """把 ssh 的报错翻译成人话。"""
    e = err or ""
    if rc == 124:
        return "连接超时"
    if "Permission denied" in e or "Authentication failed" in e:
        return "认证失败：凭据不正确，或服务器不接受这种认证方式"
    if "no such identity" in e or "No such file or directory" in e:
        return "找不到指定的私钥文件"
    if "Connection refused" in e:
        return "连接被拒绝：地址或端口不正确，或未开放 SSH"
    if "Connection timed out" in e or "Operation timed out" in e:
        return "连接超时：网络不可达或被防火墙拦截"
    if "Host key verification failed" in e:
        return "主机密钥校验失败（可能是中间人攻击，或主机重装过）"
    if "Too many authentication failures" in e:
        return "认证尝试次数过多：agent 里的密钥太多，试试加 -o IdentitiesOnly=yes 或减少 agent 中的密钥"
    first = (e.strip() or out.strip() or "未知错误（退出码 %s）" % rc)
    return first.splitlines()[0]


# ---------------------------------------------------------------------------
# 密钥生成 / 读取
# ---------------------------------------------------------------------------

def key_paths(name):
    return os.path.join(KEYS_DIR, name), os.path.join(KEYS_DIR, name + ".pub")


def gen_keypair(name, key_type="ed25519", comment=None, passphrase=""):
    priv, pub = key_paths(name)
    if os.path.exists(priv):
        die("密钥已存在：%s\n  如需重建，请先执行：sshbind remove %s" % (priv, name))
    comment = comment or ("sshbind:%s@%s" % (name, os.uname().nodename))
    cmd = ["ssh-keygen", "-t", key_type, "-f", priv, "-N", passphrase, "-C", comment, "-q"]
    if key_type == "rsa":
        cmd += ["-b", "4096"]
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode != 0:
        die("ssh-keygen 失败：%s" % proc.stderr.decode("utf-8", "replace").strip())
    os.chmod(priv, 0o600)
    os.chmod(pub, 0o644)
    info("已生成密钥对：%s" % priv)
    return priv, pub


def read_pubkey_for(keyfile):
    """读取公钥；若 .pub 不存在则尝试从私钥推导（加密私钥会失败）。"""
    keyfile = os.path.expanduser(keyfile)
    pub = keyfile + ".pub"
    if os.path.exists(pub):
        with open(pub, "r", encoding="utf-8") as f:
            return f.read().strip()
    proc = subprocess.run(["ssh-keygen", "-y", "-f", keyfile],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          stdin=subprocess.DEVNULL)
    if proc.returncode == 0:
        return proc.stdout.decode("utf-8", "replace").strip()
    return None


def read_pubkey(name):
    priv, _ = key_paths(name)
    pubkey = read_pubkey_for(priv)
    if not pubkey:
        die("找不到公钥：%s.pub\n  若是加密私钥，请手动提供公钥文件" % priv)
    return pubkey


def fingerprint_of(pubkey_line):
    """从公钥内容算指纹，不依赖本地文件。"""
    proc = subprocess.run(["ssh-keygen", "-lf", "-"],
                          input=pubkey_line.encode("utf-8"),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode != 0:
        return "?"
    out = proc.stdout.decode("utf-8", "replace").strip()
    parts = out.split()
    return parts[1] if len(parts) > 1 else out


def find_certificate(keyfile):
    """自动发现 <key>-cert.pub（OpenSSH SSH 证书）。"""
    cand = os.path.expanduser(keyfile) + "-cert.pub"
    return cand if os.path.exists(cand) else None


