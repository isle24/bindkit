REMOTE_INSTALL = (
    "set -e; umask 077; "
    'if [ -z "$HOME" ] || [ ! -d "$HOME" ]; then echo "SSHBIND_NO_HOME"; exit 1; fi; '
    "mkdir -p ~/.ssh; chmod 700 ~/.ssh; "
    "touch ~/.ssh/authorized_keys; chmod 600 ~/.ssh/authorized_keys; "
    'KEY="$(cat)"; '
    'if [ -z "$KEY" ]; then echo "SSHBIND_EMPTY_KEY"; exit 1; fi; '
    'if grep -qxF "$KEY" ~/.ssh/authorized_keys 2>/dev/null; then echo "SSHBIND_ALREADY"; '
    "else "
    '  printf \'%s\\n\' "$KEY" >> ~/.ssh/authorized_keys || { echo "SSHBIND_WRITE_FAILED"; exit 1; }; '
    '  grep -qxF "$KEY" ~/.ssh/authorized_keys || { echo "SSHBIND_WRITE_FAILED"; exit 1; }; '
    '  echo "SSHBIND_ADDED"; '
    "fi"
)

REMOTE_UNINSTALL = (
    "set -e; "
    'KEY="$(cat)"; '
    'if [ ! -f ~/.ssh/authorized_keys ]; then echo "SSHBIND_NOFILE"; exit 0; fi; '
    'if ! grep -qxF "$KEY" ~/.ssh/authorized_keys; then echo "SSHBIND_NOTFOUND"; exit 0; fi; '
    'TMP="$(mktemp)"; grep -vxF "$KEY" ~/.ssh/authorized_keys > "$TMP"; '
    'cat "$TMP" > ~/.ssh/authorized_keys; rm -f "$TMP"; '
    'chmod 600 ~/.ssh/authorized_keys; '
    # 回读校验：确认这条公钥真的没了
    'if grep -qxF "$KEY" ~/.ssh/authorized_keys; then echo "SSHBIND_REMOVE_FAILED"; exit 1; fi; '
    'echo "SSHBIND_REMOVED"'
)


def install_pubkey(host, user, port, auth, pubkey, restrict=False):
    """用给定的认证方式登录一次，把公钥追加到远端 authorized_keys。"""
    key_line = pubkey
    if restrict:
        parts = pubkey.split(None, 2)
        key_line = ("restrict " + pubkey) if len(parts) < 3 else \
                   ("restrict %s %s %s" % (parts[0], parts[1], parts[2]))

    auth_opts, handle = auth_ssh_opts(auth)
    cmd = ssh_base(host, user, port) + auth_opts + \
          ["%s@%s" % (user, host), REMOTE_INSTALL]

    if handle:
        with handle:
            rc, out, err = run_ssh(cmd, secret_handle=handle, stdin_data=key_line)
    else:
        rc, out, err = run_ssh(cmd, stdin_data=key_line)

    if "SSHBIND_ADDED" in out:
        return True, "公钥已写入远端 authorized_keys"
    if "SSHBIND_ALREADY" in out:
        return True, "公钥此前已存在于远端（跳过重复写入）"
    if "SSHBIND_NO_HOME" in out:
        return False, ("服务器上该用户的家目录不存在或不可写，无法创建 ~/.ssh。\n"
                       "     sshd 因此读不到 authorized_keys → 密钥登录不可用。\n"
                       "     常见于 NAS / 精简系统，需要在服务器端修复家目录。")
    if "SSHBIND_WRITE_FAILED" in out:
        return False, "写入远端 authorized_keys 失败（家目录不可写或磁盘只读）"
    if "SSHBIND_EMPTY_KEY" in out:
        return False, "公钥内容为空，已中止"
    return False, classify_ssh_error(rc, err, out)


def uninstall_pubkey(host, user, port, keyfile, pubkey, certificate=None):
    """用已有密钥登录，从远端 authorized_keys 移除对应公钥行。"""
    cmd = ssh_with_key(host, user, port, keyfile, certificate) + [REMOTE_UNINSTALL]
    rc, out, err = run_ssh(cmd, stdin_data=pubkey)
    if "SSHBIND_REMOVED" in out:
        return True, "已从远端 authorized_keys 移除公钥"
    if "SSHBIND_NOTFOUND" in out:
        return True, "远端本来就没有这条公钥"
    if "SSHBIND_NOFILE" in out:
        return True, "远端没有 authorized_keys 文件"
    if "SSHBIND_REMOVE_FAILED" in out:
        return False, "远端 authorized_keys 未能成功更新（公钥可能仍在服务器上）"
    return False, "无法连接远端：%s" % classify_ssh_error(rc, err, out)


def test_connection(host, user, port, keyfile, certificate=None, timeout=20):
    """只用密钥认证做一次真实连通性测试。"""
    cmd = ssh_with_key(host, user, port, keyfile, certificate) + \
          ["echo SSHBIND_OK && hostname && whoami"]
    rc, out, err = run_ssh(cmd, timeout=timeout)
    if rc == 0 and "SSHBIND_OK" in out:
        lines = [l for l in out.strip().splitlines() if l and l != "SSHBIND_OK"]
        return True, lines
    return False, [classify_ssh_error(rc, err, out, timeout)]


