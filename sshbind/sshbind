def ensure_dirs():
    for d in (BASE_DIR, KEYS_DIR, SSH_DIR):
        os.makedirs(d, exist_ok=True)
    for d in (BASE_DIR, KEYS_DIR):
        os.chmod(d, 0o700)


def load_state():
    if not os.path.exists(STATE_FILE):
        return {"version": 1, "servers": {}}
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (ValueError, OSError) as e:
        die("状态文件损坏，无法解析：%s\n  %s" % (STATE_FILE, e))
    data.setdefault("version", 1)
    data.setdefault("servers", {})
    return data


def save_state(state):
    ensure_dirs()
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=2, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


# ---------------------------------------------------------------------------
# 密码 / 口令传递：临时文件 + SSH_ASKPASS（避免出现在 ps / argv 里）
# ---------------------------------------------------------------------------

class SecretHandle(object):
    """把密码或口令写进 600 权限的临时文件供 SSH_ASKPASS 读取，退出时粉碎删除。"""

    def __init__(self, secret):
        self.dir = tempfile.mkdtemp(prefix="sshbind-")
        os.chmod(self.dir, 0o700)
        pw_path = os.path.join(self.dir, "secret")
        fd = os.open(pw_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secret + "\n")
        ask = os.path.join(self.dir, "askpass.sh")
        with open(ask, "w") as f:
            f.write("#!/bin/sh\nexec cat %s\n" % shlex.quote(pw_path))
        os.chmod(ask, 0o700)
        self.askpass = ask
        self.secret_path = pw_path

    def env(self):
        env = dict(os.environ)
        env["SSH_ASKPASS"] = self.askpass
        env["SSH_ASKPASS_REQUIRE"] = "force"   # OpenSSH 8.4+，强制用 askpass
        env.setdefault("DISPLAY", ":0")
        return env

    def close(self):
        try:
            if os.path.exists(self.secret_path):
                size = os.path.getsize(self.secret_path)
                with open(self.secret_path, "r+b") as f:
                    f.write(b"\0" * size)
        except OSError:
            pass
        shutil.rmtree(self.dir, ignore_errors=True)

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False


