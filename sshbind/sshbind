def add_auth_args(p):
    """给 add / adopt 挂上认证相关的参数。"""
    g = p.add_argument_group("首次认证方式（三选一，默认交互式提示密码）")
    g.add_argument("--password-stdin", action="store_true",
                   help="从标准输入读登录密码")
    g.add_argument("--identity", action="append", metavar="私钥文件",
                   help="用已有私钥认证（可重复指定多把）")
    g.add_argument("--identity-passphrase-stdin", action="store_true",
                   help="从标准输入读已有私钥的口令")
    g.add_argument("--agent", action="store_true",
                   help="用 ssh-agent 中已加载的密钥认证")


def build_parser():
    p = argparse.ArgumentParser(
        prog="sshbind",
        description="绑定 Linux 服务器：认证一次，之后永久免密；密钥可集中管理。",
        epilog="认证方式示例：\n"
               "  sshbind add prod --host 10.0.0.5                      # 提示输入密码\n"
               "  sshbind add prod --host 10.0.0.5 --identity ~/.ssh/id_rsa\n"
               "  sshbind add prod --host 10.0.0.5 --agent\n"
               "  sshbind adopt old --host 10.0.0.6 --identity ~/.ssh/id_ed25519\n"
               "\n本机 Web 控制台：\n"
               "  sshbind --startserver [--port 8790] [--host 127.0.0.1] [--daemon] [--open]\n"
               "      # Web 控制台；--host HOST 监听地址（默认 127.0.0.1，局域网访问用 0.0.0.0）\n",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd")

    a = sub.add_parser("add", help="绑定服务器（生成专属密钥并推送公钥）")
    a.add_argument("name", help="别名，之后 ssh <别名> 即可")
    a.add_argument("--host", required=True, help="服务器地址（IP 或域名）")
    a.add_argument("--user", default="root", help="登录用户名（默认 root）")
    a.add_argument("--port", type=int, default=22, help="SSH 端口（默认 22）")
    a.add_argument("--key-type", default="ed25519",
                   choices=["ed25519", "rsa", "ecdsa"], help="新密钥算法（默认 ed25519）")
    a.add_argument("--key-passphrase", default=None,
                   help="给新私钥加口令（默认无口令便于自动化；加了需配合 ssh-agent）")
    a.add_argument("--restrict", action="store_true",
                   help="在远端给公钥加 restrict 前缀（禁用端口转发/pty 等）")
    a.add_argument("--force", action="store_true", help="覆盖同名绑定")
    a.add_argument("--require-verified", action="store_true", help=argparse.SUPPRESS)
    add_auth_args(a)
    a.set_defaults(func=cmd_add)

    ad = sub.add_parser("adopt", help="纳管已有密钥（不生成、不推送，只登记并验证）")
    ad.add_argument("name", help="别名")
    ad.add_argument("--host", required=True, help="服务器地址")
    ad.add_argument("--user", default="root", help="登录用户名（默认 root）")
    ad.add_argument("--port", type=int, default=22, help="SSH 端口（默认 22）")
    ad.add_argument("--identity", action="append", metavar="私钥文件", required=True,
                    help="要纳管的私钥文件")
    ad.add_argument("--certificate", metavar="证书文件",
                    help="SSH 证书（默认自动查找 <私钥>-cert.pub）")
    ad.add_argument("--password-stdin", action="store_true",
                    help="从标准输入首行读密码（控制台统一入口用；adopt 用密钥验证，不消费密码）")
    ad.add_argument("--force", action="store_true", help="验证失败也强行登记")
    ad.add_argument("--require-verified", action="store_true", help=argparse.SUPPRESS)
    ad.set_defaults(func=cmd_adopt)

    l = sub.add_parser("list", help="列出所有绑定")
    l.add_argument("--json", action="store_true", help="输出 JSON（推荐给脚本/agent 用）")
    l.set_defaults(func=cmd_list)

    ex = sub.add_parser("exec", help="在远端执行命令（自动化/agent 推荐入口）")
    ex.add_argument("--json", action="store_true",
                    help="以 JSON 输出（含 exit_code / stdout / stderr / duration_ms）")
    ex.add_argument("--timeout", type=int, default=120, help="超时秒数（默认 120）")
    ex.add_argument("--as-user", help="通过受管 sudo 以指定身份执行")
    ex.add_argument("--stdin", action="store_true", help="将标准输入送给远端命令（最多8MiB）")
    ex.add_argument("name", help="服务器别名")
    ex.add_argument("command", nargs=argparse.REMAINDER,
                    help="要执行的命令（选项须写在别名之前）")
    ex.set_defaults(func=cmd_exec)

    s = sub.add_parser("show", help="查看某台服务器的详情")
    s.add_argument("name")
    s.set_defaults(func=cmd_show)

    pk = sub.add_parser("pubkey", help="打印公钥（用于手动粘贴到服务器）")
    pk.add_argument("name")
    pk.set_defaults(func=cmd_pubkey)

    t = sub.add_parser("test", help="测试免密登录是否正常")
    t.add_argument("name", nargs="?", help="服务器别名")
    t.add_argument("--all", action="store_true", help="测试全部")
    t.set_defaults(func=cmd_test)

    r = sub.add_parser("remove", help="解绑：远端删公钥 + 清 config（本地密钥可选删）")
    r.add_argument("name")
    r.add_argument("--keep-key", action="store_true", help="保留本地密钥文件")
    r.add_argument("--delete-key", action="store_true",
                   help="纳管的已有密钥也一并删除密钥文件（默认保留）")
    r.add_argument("--no-revoke", action="store_true", help="跳过远端公钥清理")
    r.add_argument("--force", action="store_true", help="远端清理失败时也继续")
    r.add_argument("--yes", action="store_true", help="跳过确认")
    r.set_defaults(func=cmd_remove)

    im = sub.add_parser("import", help="从其他 SSH 客户端导入连接（目前支持 FinalShell）")
    im.add_argument("source", help="来源，目前支持：finalshell")
    im.add_argument("--dir", help="手动指定该客户端的配置目录")
    im.add_argument("--with-passwords", action="store_true",
                    help="解密客户端保存的密码并自动完成免密绑定（默认只预览）")
    im.add_argument("--only", help="只导入这些名称/地址，逗号分隔")
    im.add_argument("--rename", action="append", metavar="原名=新名",
                    help="指定别名映射（可重复）。中文名无法直接用作 SSH 别名，会自动转换")
    im.add_argument("--key-type", default="ed25519",
                    choices=["ed25519", "rsa", "ecdsa"], help="新密钥算法（默认 ed25519）")
    im.add_argument("--restrict", action="store_true",
                    help="在远端给公钥加 restrict 前缀")
    im.add_argument("--yes", action="store_true", help="跳过确认")
    im.set_defaults(func=cmd_import)

    d = sub.add_parser("doctor", help="自检环境")
    d.set_defaults(func=cmd_doctor)

    return p


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # bindconsole 契约 §2：先扫描 --startserver，不影响任何既有子命令
    if "--startserver" in argv:
        try:
            return start_console_mode(argv)
        except KeyboardInterrupt:
            warn("已中断")
            return 130
        except SystemExit:
            raise
        except Exception as e:                 # noqa: BLE001
            sys.stderr.write("ERROR 控制台启动失败：%s\n" % e)
            return 1
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return 0
    ensure_dirs()
    try:
        if args.cmd in ("add", "adopt", "remove", "import"):
            connections = _extension_module("bindkit_connections")
            if connections is not None:
                with connections._lock(_self_module()):
                    return args.func(args)
        return args.func(args)
    except KeyboardInterrupt:
        print()
        warn("已中断")
        return 130


if __name__ == "__main__":
    sys.exit(main())
