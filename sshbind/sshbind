AUTH_PASSWORD = "password"
AUTH_KEY = "key"
AUTH_AGENT = "agent"


def make_auth(mode, password=None, identities=None, passphrase=None):
    return {"mode": mode, "password": password,
            "identities": identities or [], "passphrase": passphrase}


def auth_ssh_opts(auth):
    """把认证方式翻译成 ssh 选项，并返回需要随行清理的 SecretHandle（可能为 None）。"""
    opts, handle = [], None
    mode = auth["mode"]

    if mode == AUTH_PASSWORD:
        opts += ["-o", "PubkeyAuthentication=no",
                 "-o", "PreferredAuthentications=password,keyboard-interactive",
                 "-o", "NumberOfPasswordPrompts=1"]
        handle = SecretHandle(auth["password"])

    elif mode == AUTH_KEY:
        for f in auth["identities"]:
            opts += ["-i", os.path.expanduser(f)]
        opts += ["-o", "IdentitiesOnly=yes",
                 "-o", "PreferredAuthentications=publickey",
                 "-o", "NumberOfPasswordPrompts=1"]
        if auth.get("passphrase"):
            handle = SecretHandle(auth["passphrase"])

    elif mode == AUTH_AGENT:
        opts += ["-o", "PreferredAuthentications=publickey",
                 "-o", "IdentitiesOnly=no"]

    return opts, handle


def auth_label(auth):
    if auth["mode"] == AUTH_PASSWORD:
        return "密码"
    if auth["mode"] == AUTH_KEY:
        return "私钥 %s" % ", ".join(os.path.basename(i) for i in auth["identities"])
    return "ssh-agent"


def key_is_encrypted(path):
    """判断私钥是否带口令（不需要口令即可判断）。

    OpenSSH 新格式（-----BEGIN OPENSSH PRIVATE KEY-----）的二进制结构是：
        "openssh-key-v1\\0" + [4字节长度 + ciphername] + [4字节长度 + kdfname] + ...
    未加密时 ciphername == "none"；加密时为 "aes256-ctr" 等。
    """
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()
    except OSError:
        return False

    # 老式 PEM（RSA/DSA/EC）加密时会有这个头
    if "Proc-Type: 4,ENCRYPTED" in content or "ENCRYPTED" in content:
        return True

    m = re.search(r"-----BEGIN OPENSSH PRIVATE KEY-----\s*(.+?)\s*-----END",
                  content, re.S)
    if not m:
        return False
    try:
        blob = base64.b64decode("".join(m.group(1).split()))
    except (ValueError, TypeError):
        return False

    prefix = b"openssh-key-v1\x00"
    if not blob.startswith(prefix):
        return False
    rest = blob[len(prefix):]
    if len(rest) < 4:
        return False
    try:
        n = int.from_bytes(rest[:4], "big")
        cipher = rest[4:4 + n].decode("ascii", "replace")
    except (ValueError, UnicodeDecodeError):
        return False
    return cipher != "none"


# ---------------------------------------------------------------------------
# DES（用于解密 FinalShell 保存的密码）
#
# 说明：只实现解密 + 密钥派生。凭据是你自己机器上、你自己工具里的数据，
# 解密结果仅在内存中使用一次，不会打印、不会写入磁盘。
# ---------------------------------------------------------------------------

def des_ecb_decrypt(data, key8):
    """DES-ECB 解密。依次尝试 cryptography / pycryptodome / 系统 openssl，避免强制装依赖。"""
    # 后端 1：cryptography（TripleDES 用 8 字节密钥时等价于单 DES）
    try:
        import warnings
        from cryptography.hazmat.primitives.ciphers import Cipher, modes
        try:
            from cryptography.hazmat.decrepit.ciphers.algorithms import TripleDES
        except ImportError:
            from cryptography.hazmat.primitives.ciphers.algorithms import TripleDES
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            dec = Cipher(TripleDES(key8), modes.ECB()).decryptor()
            out = dec.update(data) + dec.finalize()
        if len(out) == len(data):
            return out
    except Exception:
        pass

    # 后端 2：pycryptodome
    try:
        from Crypto.Cipher import DES as _DES
        out = _DES.new(key8, _DES.MODE_ECB).decrypt(data)
        if len(out) == len(data):
            return out
    except Exception:
        pass

    # 后端 3：openssl 命令行。macOS 自带 /usr/bin/openssl(LibreSSL) 直接支持 des-ecb；
    #          Homebrew 的 OpenSSL 3.x 需要显式加载 legacy provider。
    for argv in (["/usr/bin/openssl", "enc", "-d", "-des-ecb"],
                 ["/usr/bin/openssl", "enc", "-d", "-des-ecb", "-nopad"],
                 ["openssl", "enc", "-d", "-des-ecb", "-provider", "legacy",
                  "-provider", "default"]):
        try:
            p = subprocess.run(argv + ["-K", key8.hex()],
                               input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if p.returncode == 0 and len(p.stdout) == len(data):
                return p.stdout
        except OSError:
            continue

    raise RuntimeError("找不到可用的 DES 实现（cryptography / pycryptodome / openssl 均不可用）")


class JavaRandom(object):
    """精确复刻 java.util.Random（JDK 8+），FinalShell 用它的 nextLong 派生密钥。"""

    MULTIPLIER = 0x5DEECE66D
    ADDEND = 0xB
    MASK = (1 << 48) - 1

    def __init__(self, seed):
        if seed < 0:
            seed += (1 << 64)
        self._seed = (seed ^ self.MULTIPLIER) & self.MASK

    def _next(self, bits):
        self._seed = (self._seed * self.MULTIPLIER + self.ADDEND) & self.MASK
        result = self._seed >> (48 - bits)
        if bits >= 32 and result >= 0x80000000:
            result -= 0x100000000
        return result

    def next_int(self, bound=None):
        if bound is None:
            return self._next(32)
        if bound <= 0:
            raise ValueError("bound must be positive")
        r = self._next(31)
        m = bound - 1
        if (bound & m) == 0:
            r = (bound * r) >> 31
        else:
            u = r
            r = u % bound
            while u - r + m < 0:
                u = self._next(31)
                r = u % bound
        return r

    def next_long(self):
        hi = self._next(32)
        lo = self._next(32)
        val = ((hi << 32) + lo) & 0xFFFFFFFFFFFFFFFF
        if val >= 0x8000000000000000:
            val -= 0x10000000000000000
        return val


def _signed(b):
    return b - 256 if b >= 128 else b


def finalshell_derive_key(head):
    """由密文头部 8 字节派生 DES 密钥（8 字节）。"""
    rand_for_divisor = JavaRandom(_signed(head[5]))
    divisor = rand_for_divisor.next_int(127) or 1
    ks = 3680984568597093857 // divisor

    random_ = JavaRandom(ks)
    t = _signed(head[0])
    for _ in range(t if t > 0 else 0):
        random_.next_long()

    r2 = JavaRandom(random_.next_long())

    longs = [
        _signed(head[4]), r2.next_long(), _signed(head[7]), _signed(head[3]),
        r2.next_long(), _signed(head[1]), random_.next_long(), _signed(head[2]),
    ]
    key_data = b"".join(struct.pack(">q", v) for v in longs)
    return hashlib.md5(key_data).digest()[:8]


def finalshell_decode_password(encoded):
    """解密 FinalShell 的 password 字段。返回明文 str，失败抛异常。"""
    if not encoded:
        return ""
    buf = base64.b64decode(encoded.strip())
    if len(buf) <= 8:
        raise ValueError("密文长度不足")
    head, body = buf[:8], buf[8:]
    key = finalshell_derive_key(head)
    raw = des_ecb_decrypt(body, key)
    pad = raw[-1] if raw else 0
    if 1 <= pad <= 8 and raw.endswith(bytes([pad]) * pad):
        raw = raw[:-pad]
    return raw.decode("utf-8", errors="replace")


