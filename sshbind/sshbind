def _cmd_add_verified(args):
    """Console-only transaction: publish an alias only after new-key verification.

    Unique candidate names let a failed import retry without overwriting a user's
    existing key. No remote key is revoked, including after an uncertain install.
    """
    name = args.name
    validate_name(name)
    if args.force:
        die("严格验证模式不允许覆盖已有连接")
    if name in load_state()["servers"]:
        die("名称已存在：%s" % name)
    candidate_name = name + "-verified-" + uuid.uuid4().hex
    owned_paths = key_paths(candidate_name)
    committed = False
    config_written = False
    preserve_candidate = False
    try:
        auth = resolve_auth(args)
        priv, pub = gen_keypair(candidate_name, key_type=args.key_type,
                                passphrase=args.key_passphrase or "")
        pubkey = read_pubkey(candidate_name)
        fingerprint = fingerprint_of(pubkey)
        certificate = find_certificate(priv)
        installed, _ = install_pubkey(args.host, args.user, args.port, auth, pubkey,
                                       restrict=args.restrict)
        auth = None
        if not installed:
            warn("公钥安装未确认，未登记别名；可用正确登录密码重试。远端已有公钥未撤销。")
            return 1
        verified, _ = test_connection(args.host, args.user, args.port, priv, certificate)
        if not verified:
            warn("公钥安装后登录验证失败，未登记别名；可用登录密码重新绑定。远端公钥未撤销。")
            return 1
        # main() holds the shared mutation lock. Re-read as an extra safeguard for
        # direct callers and never overwrite a newly-created alias.
        current = load_state()
        if name in current["servers"]:
            warn("同名连接已存在，未覆盖；远端公钥未撤销。")
            return 1
        updated = json.loads(json.dumps(current))
        updated["servers"][name] = _record(name, args.host, args.user, args.port, priv,
            fingerprint, args.key_type, args.restrict, certificate, "generated", installed=True)
        config_written = True
        write_ssh_config(updated["servers"])
        save_state(updated)
        committed = True
        ok("连接已验证并登记：%s" % name)
        return 0
    except (Exception, SystemExit):
        warn("连接创建未完成，请检查凭据、网络与本地存储；远端已有公钥未撤销。")
        return 1
    finally:
        if not committed:
            # Only delete files created with this attempt's unique name. If a
            # partial persistence retained a reference, keep its credential.
            try:
                latest = load_state()
                preserve_candidate = any(row.get("key") == owned_paths[0]
                                         for row in latest["servers"].values())
                if config_written and not preserve_candidate:
                    try:
                        write_ssh_config(latest["servers"])
                    except (Exception, SystemExit):
                        preserve_candidate = True
                        warn("SSH配置恢复失败，已保留本次候选密钥供人工恢复。")
            except (Exception, SystemExit):
                preserve_candidate = True
            if not preserve_candidate:
                for path in owned_paths:
                    try:
                        os.remove(path)
                    except FileNotFoundError:
                        pass
                    except OSError:
                        warn("本次候选密钥清理失败，请检查本地存储权限。")


def cmd_add(args):
    if getattr(args, "require_verified", False):
        return _cmd_add_verified(args)
    name = args.name
    validate_name(name)

    state = load_state()
    if name in state["servers"] and not args.force:
        die("名称已存在：%s\n  换个名字，或加 --force 覆盖（会重建密钥）" % name)

    host, user, port = args.host, args.user, args.port

    print()
    print("  绑定服务器  %s" % bold("%s@%s:%s" % (user, host, port)))
    print("  %s" % ("-" * 46))

    # 1) 认证凭据
    auth = resolve_auth(args)
    print("  首次认证方式：%s" % auth_label(auth))
    print()

    # 2) 生成专属密钥
    if args.force and name in state["servers"]:
        old = state["servers"].pop(name)
        if old.get("source") != "adopted":
            for p in (old["key"], old["key"] + ".pub"):
                if os.path.exists(p):
                    os.remove(p)
        info("已移除旧的 %s 记录" % name)

    priv, pub = gen_keypair(name, key_type=args.key_type,
                            passphrase=args.key_passphrase or "")
    pubkey = read_pubkey(name)
    fp = fingerprint_of(pubkey)
    certificate = find_certificate(priv)
    if certificate:
        info("检测到 SSH 证书：%s" % os.path.basename(certificate))

    # 3) 推送公钥
    info("正在用%s登录并把公钥写入远端 …" % auth_label(auth))
    success, msg = install_pubkey(host, user, port, auth, pubkey,
                                  restrict=args.restrict)
    auth = None   # 尽快释放凭据
    if not success:
        warn("公钥推送失败：%s" % msg)
        print()
        print("  别急，密钥已经生成好了。你可以手动完成最后一步：")
        print()
        print("    1. 执行下面命令拿到公钥：")
        print("         sshbind pubkey %s" % name)
        print("    2. 登录服务器，把公钥整行粘贴进 ~/.ssh/authorized_keys")
        print()
        print("  %s" % (C_DIM + "（有些服务器禁用了密码登录，只能这样手动加）" + C_OFF))
        print()
        if not ask_yes_no("  要保留这把已生成的密钥吗？[Y/n] ", default=True):
            for p in (priv, pub):
                if os.path.exists(p):
                    os.remove(p)
            die("已清理，未做任何改动")
        state["servers"][name] = _record(name, host, user, port, priv, fp,
                                         args.key_type, args.restrict,
                                         certificate, "generated", installed=False)
        save_state(state)
        write_ssh_config(state["servers"])
        warn("已记录为「待手动安装」状态，装好后执行 sshbind test %s 验证" % name)
        return 1

    ok(msg)

    # 4) 真实连通性验证（只用新密钥，禁密码回退）
    info("验证免密登录 …")
    alive, details = test_connection(host, user, port, priv, certificate)
    if alive:
        ok("免密登录成功 — %s" % " / ".join(details))
    else:
        warn("公钥已写入，但免密验证未通过：%s" % (details[0] if details else "未知"))
        warn("可稍后再试：sshbind test %s" % name)

    # 5) 记录
    state["servers"][name] = _record(name, host, user, port, priv, fp,
                                     args.key_type, args.restrict,
                                     certificate, "generated", installed=True)
    save_state(state)
    write_ssh_config(state["servers"])

    print()
    ok("已绑定 %s" % bold(name))
    print()
    print("  直接连接：   %s" % bold("ssh %s" % name))
    print("  执行命令：   %s" % bold('ssh %s "uptime"' % name))
    print("  指纹：       %s" % fp)
    return 0


def _record(name, host, user, port, key, fp, key_type, restrict,
            certificate, source, installed):
    return {
        "name": name, "host": host, "user": user, "port": port,
        "id": str(uuid.uuid4()), "revision": 1, "sudo_auth": "none", "sudo_credential_ref": None,
        "key": key, "fingerprint": fp, "key_type": key_type,
        "restrict": bool(restrict), "certificate": certificate,
        "source": source, "installed": bool(installed),
        "created_at": datetime.now().isoformat(timespec="seconds"),
    }


def cmd_adopt(args):
    """纳管已有密钥：不生成、不推送，只登记并验证。"""
    # 契约 §8.2 要求 add/adopt 都有 --password-stdin（控制台统一入口）。adopt 只用密钥
    # 验证、不需要密码，这里读掉首行避免调用方的管道阻塞，不使用该值。
    if getattr(args, "password_stdin", False):
        try:
            sys.stdin.readline()
        except (OSError, ValueError):
            pass
    name = args.name
    validate_name(name)
    if getattr(args, "require_verified", False) and args.force:
        die("严格验证模式不允许跳过验证")

    state = load_state()
    if name in state["servers"] and not args.force:
        die("名称已存在：%s\n  换个名字，或加 --force 覆盖" % name)

    keyfile = os.path.expanduser(args.identity[0] if args.identity else "")
    if not keyfile or not os.path.exists(keyfile):
        die("必须用 --identity 指定一个已存在的私钥文件")
    # 不擅自改动你的文件权限，只提示（私钥过宽会被 ssh 拒绝）
    try:
        mode = os.stat(keyfile).st_mode & 0o777
        if mode & 0o077:
            warn("私钥权限过宽（%o），ssh 可能会拒绝使用：%s" % (mode, keyfile))
            warn("建议执行：chmod 600 %s" % keyfile)
    except OSError:
        pass

    certificate = os.path.expanduser(args.certificate) if args.certificate \
        else find_certificate(keyfile)
    if certificate and not os.path.exists(certificate):
        die("找不到证书文件：%s" % certificate)

    host, user, port = args.host, args.user, args.port
    print()
    print("  纳管已有密钥  %s" % bold("%s@%s:%s" % (user, host, port)))
    print("  %s" % ("-" * 46))
    print("  私钥：  %s" % keyfile)
    if certificate:
        print("  证书：  %s" % certificate)
    print()

    pubkey = read_pubkey_for(keyfile)
    fp = fingerprint_of(pubkey) if pubkey else "?"

    info("验证这把密钥能否登录 …")
    alive, details = test_connection(host, user, port, keyfile, certificate)
    if alive:
        ok("验证通过 — %s" % " / ".join(details))
    else:
        if getattr(args, "require_verified", False):
            warn("私钥登录验证失败，未登记连接，也未修改提供的私钥。")
            return 1
        warn("验证未通过：%s" % (details[0] if details else "未知"))
        if not args.force:
            print()
            print("  可能原因：密钥不对、服务器没配这把公钥、或需要跳板机。")
            print("  如果你确定要登记，加 --force 跳过验证。")
            print()
            if not ask_yes_no("  仍要登记吗？[y/N] ", default=False):
                print("  已取消，未做任何改动")
                return 1

    state["servers"][name] = _record(name, host, user, port, keyfile, fp,
                                     "existing", False, certificate,
                                     "adopted", installed=bool(alive))
    save_state(state)
    write_ssh_config(state["servers"])

    print()
    ok("已纳管 %s" % bold(name))
    print()
    print("  直接连接：   %s" % bold("ssh %s" % name))
    print("  指纹：       %s" % fp)
    print()
    print("  %s" % (C_DIM + "注意：这是你原有的密钥，sshbind remove 默认不会删除它" + C_OFF))
    return 0


def cmd_list(args):
    state = load_state()
    servers = state["servers"]

    # agent 友好：结构化输出，便于可靠解析（不要靠截屏幕文本）
    if getattr(args, "json", False):
        out = []
        for name in sorted(servers):
            s = servers[name]
            key_ok = os.path.exists(s["key"])
            out.append({
                "name": name,
                "host": s["host"],
                "user": s["user"],
                "port": s["port"],
                "source": s.get("source", "generated"),
                "key_path": s["key"],
                "key_exists": key_ok,
                "fingerprint": s.get("fingerprint"),
                "installed": bool(s.get("installed", True)),
                "usable": bool(key_ok and s.get("installed", True) and s.get("verification_status") != "pending"),
                "verification_status": s.get("verification_status", "verified" if s.get("installed", True) else "pending"),
                "has_login_credential": bool(s.get("login_credential_ref")),
                "has_encrypted_login": bool(s.get("encrypted_login_ref")),
            })
        print(json.dumps({"count": len(out), "servers": out},
                         ensure_ascii=False, indent=2))
        return 0

    if not servers:
        print("还没有绑定任何服务器。用这条命令开始：")
        print("    sshbind add myserver --host 1.2.3.4 --user root")
        print("    sshbind add myserver --host 1.2.3.4 --identity ~/.ssh/id_rsa")
        return 0

    rows = []
    for name in sorted(servers):
        s = servers[name]
        rows.append((name,
                     "%s@%s:%s" % (s["user"], s["host"], s["port"]),
                     os.path.exists(s["key"]),
                     s.get("source", "generated"),
                     s.get("installed", True)))

    w = max(max(len(r[0]) for r in rows), 4)
    wh = max(len(r[1]) for r in rows)
    print()
    print("  %-*s  %-*s  %-8s  %-6s  %s" % (w, "名称", wh, "目标", "密钥", "来源", "状态"))
    print("  %s" % ("-" * (w + wh + 32)))
    for name, target, key_ok, source, installed in rows:
