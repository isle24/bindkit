BLOCK_BEGIN = "# >>> sshbind managed block — 由 sshbind 自动生成，请勿手工编辑 >>>"
BLOCK_END = "# <<< sshbind managed block <<<"

C_OK = "\033[32m"
C_WARN = "\033[33m"
C_ERR = "\033[31m"
C_DIM = "\033[2m"
C_BOLD = "\033[1m"
C_OFF = "\033[0m"


def _tty():
    return sys.stdout.isatty()


def ok(msg):
    print(("%s✅ %s%s" % (C_OK, msg, C_OFF)) if _tty() else "OK   " + msg)


def info(msg):
    print(("%s→ %s%s" % (C_DIM, msg, C_OFF)) if _tty() else "     " + msg)


def warn(msg):
    sys.stdout.flush()   # 保证警告在管道/重定向下仍按逻辑顺序出现
    print(("%s⚠️  %s%s" % (C_WARN, msg, C_OFF)) if _tty() else "WARN " + msg,
          file=sys.stderr)
    sys.stderr.flush()


def die(msg, code=1):
    sys.stdout.flush()
    print(("%s❌ %s%s" % (C_ERR, msg, C_OFF)) if _tty() else "ERROR " + msg,
          file=sys.stderr)
    sys.exit(code)


def bold(msg):
    return ("%s%s%s" % (C_BOLD, msg, C_OFF)) if _tty() else msg


def ask_yes_no(prompt, default=True):
    """交互式询问；非终端环境（管道/脚本）下直接返回默认值，不抛 EOFError。"""
    if not sys.stdin.isatty():
        return default
    try:
        ans = input(prompt).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return default
    if not ans:
        return default
    return ans in ("y", "yes")


