def console_ssh_policy_get():
    mod = _console_policy_module()
    summary = mod.policy_summary("ssh")
    summary["effective"] = {
        alias: mod.effective_ssh_policy(summary.get("policy") or {}, alias)
        for alias in list((summary.get("policy") or {}).get("servers", {}))
    }
    return summary


def _clean_allowed_users(value):
    if not isinstance(value, list) or len(value) > 200 or any(not isinstance(user, str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]{0,63}", user) for user in value):
        raise _console_fail("allowed_users 必须是有效的用户名称数组（最多200项）")
    return list(dict.fromkeys(value))


def _console_clean_ssh_policy(payload):
    if not isinstance(payload, dict):
        raise _console_fail("策略必须是 JSON 对象")
    out = {"version": 1, "defaults": {}, "servers": {}}
    defaults = payload.get("defaults") if isinstance(payload.get("defaults"), dict) else {}
    if "sudo" in defaults:
        sudo = str(defaults.get("sudo") or "").lower()
        if sudo not in _SSH_SUDO_MODES:
            raise _console_fail("defaults.sudo 必须是 allow/ask/deny")
        out["defaults"]["sudo"] = sudo
    if "approval_ttl_s" in defaults:
        try:
            out["defaults"]["approval_ttl_s"] = max(60, min(86400,
                                                           int(defaults["approval_ttl_s"])))
        except (TypeError, ValueError):
            raise _console_fail("approval_ttl_s 必须是整数")
    if "allowed_users" in defaults:
        out["defaults"]["allowed_users"] = _clean_allowed_users(defaults["allowed_users"])
    servers = payload.get("servers") if isinstance(payload.get("servers"), dict) else {}
    for alias, entry in servers.items():
        alias = _console_name(alias)
        if not isinstance(entry, dict):
            raise _console_fail("服务器 %s 的策略必须是对象" % alias)
        clean = {}
        if "sudo" in entry:
            sudo = str(entry.get("sudo") or "").lower()
            if sudo not in _SSH_SUDO_MODES:
                raise _console_fail("sudo 策略必须是 allow/ask/deny（%s）" % alias)
            clean["sudo"] = sudo
        if "approval_ttl_s" in entry and entry["approval_ttl_s"] not in (None, ""):
            try:
                clean["approval_ttl_s"] = max(60, min(86400, int(entry["approval_ttl_s"])))
            except (TypeError, ValueError):
                raise _console_fail("approval_ttl_s 必须是整数（%s）" % alias)
        if "note" in entry:
            clean["note"] = str(entry["note"])[:200] if entry.get("note") else None
        if "allowed_users" in entry:
            clean["allowed_users"] = _clean_allowed_users(entry["allowed_users"])
        out["servers"][alias] = clean
    return out


def console_ssh_policy_put(body):
    mod = _console_policy_module()
    current = mod.read_policy("ssh")
    base = (current.get("data") or {}) if current.get("exists") and \
        not current.get("corrupt") else mod.default_policy("ssh")
    merged = json.loads(json.dumps(base))
    merged.setdefault("defaults", {})
    merged.setdefault("servers", {})
    if isinstance(body, dict):
        if isinstance(body.get("defaults"), dict):
            merged["defaults"].update(body["defaults"])
        if isinstance(body.get("servers"), dict):
            for alias, entry in body["servers"].items():
                if alias not in merged["servers"] or \
                        not isinstance(merged["servers"][alias], dict):
                    merged["servers"][alias] = {}
                merged["servers"][alias].update(entry or {})
        if "defaults" in body or "servers" in body:
            clean = _console_clean_ssh_policy(merged)
            mod.write_policy("ssh", clean)
            return {"ok": True, "path": mod.tool_paths("ssh")["policy"]}
    raise _console_fail("策略请求体需要包含 defaults 或 servers")


def build_console_handlers():
    return {
        "resource": "servers",
        "list": console_ssh_list,
        "get": console_ssh_get,
        "create": console_ssh_create,
        "create_unverified": console_ssh_create_unverified,
        "update": console_ssh_update,
        "delete": console_ssh_delete,
        "test": console_ssh_test,
        "unlock": console_ssh_unlock,
        "users": console_ssh_users,
        "policy_get": console_ssh_policy_get,
        "policy_put": console_ssh_policy_put,
    }


def _last_line(text):
    for line in reversed((text or "").strip().splitlines()):
        if line.strip():
            return line.strip()
    return ""


# ---- --startserver --------------------------------------------------------

DEFAULT_CONSOLE_PORT = 8790


def _parse_startserver_args(argv):
    port = DEFAULT_CONSOLE_PORT
    host = "127.0.0.1"
    daemon = open_browser = False
    saw = False
    rest = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--startserver":
            saw = True
        elif a == "--daemon":
            daemon = True
        elif a in ("--open", "--open-browser"):
            open_browser = True
        elif a == "--port":
            i += 1
            if i >= len(argv):
                die("--port 需要一个端口号", code=2)
            try:
                port = int(argv[i])
            except (TypeError, ValueError):
                die("--port 必须是整数：%r" % argv[i], code=2)
        elif a.startswith("--port="):
            try:
                port = int(a.split("=", 1)[1])
            except (TypeError, ValueError):
                die("--port 必须是整数：%r" % a, code=2)
        elif a == "--host":
            i += 1
            if i >= len(argv):
                die("--host 需要一个地址（默认 127.0.0.1；局域网用 0.0.0.0）", code=2)
            host = argv[i]
        elif a.startswith("--host="):
            host = a.split("=", 1)[1]
        elif a in ("-h", "--help"):
            rest.append(a)
        else:
            rest.append(a)
        i += 1
    if rest:
        die("--startserver 与其他子命令/参数互斥：%s\n"
            "  用法：sshbind --startserver [--port 8790] [--host 127.0.0.1] "
            "[--daemon] [--open]"
            % " ".join(rest), code=2)
    if not saw:
        die("内部错误：未检测到 --startserver", code=2)
    if not (1 <= port <= 65535):
        die("端口超出范围：%d" % port, code=2)
    return port, host, daemon, open_browser


def start_console_mode(argv):
    port, host, daemon, open_browser = _parse_startserver_args(argv)
    lib = bindconsole_lib()
    kernel = os.path.join(lib, "bindkit_console.py")
    if not os.path.isfile(kernel):
        sys.stderr.write("ERROR 找不到 bindconsole 内核：%s\n"
                         "       code: UNSUPPORTED\n"
                         "      先安装：%s\n" % (kernel, BINDCONSOLE_INSTALL_CMD))
        return 1
    if lib not in sys.path:
        sys.path.insert(0, lib)
    try:
        from bindkit_console import run_console
    except Exception as e:                     # noqa: BLE001
        sys.stderr.write("ERROR 加载 bindconsole 内核失败：%s\n"
                         "      重新安装：%s\n" % (e, BINDCONSOLE_INSTALL_CMD))
        return 1
    os.environ.setdefault("BINDCONSOLE_HOME", bindconsole_home())
    try:
        rc = run_console("ssh", port=port, handlers=build_console_handlers(),
                         daemon=daemon, open_browser=open_browser, host=host)
    except TypeError:
        # 老内核没有 host 参数：回环模式退化成旧签名，非回环明确报错
        if host not in ("127.0.0.1", "localhost", "::1"):
            sys.stderr.write("ERROR 当前 bindconsole 内核不支持 --host（需要重新安装）：%s\n"
                             "      重新安装：%s\n" % (host, BINDCONSOLE_INSTALL_CMD))
            return 1
        rc = run_console("ssh", port, build_console_handlers(),
                         daemon=daemon, open_browser=open_browser)
    return 0 if rc is None else int(rc)




def cmd_exec(args):
    """Preserve legacy execution, with managed identity and authentication when requested."""
    state = load_state()
    server = state["servers"].get(args.name)
    if not server:
        die("没有名为 %s 的绑定。先执行 sshbind list 看看有哪些" % args.name)
    if not server.get("installed", True) or server.get("verification_status") == "pending":
        die("连接尚未验证启用，请在 Web 控制台补充凭据并点击测试连接。")
    if not os.path.exists(server["key"]):
        die("私钥缺失，无法连接：%s" % server["key"])
    command = " ".join(args.command).strip()
    if not command:
        die("请给出要执行的命令")
    try:
        words = shlex.split(command)
    except ValueError:
        words = args.command
    misplaced = [token for token in args.command if token in ("--json", "--timeout", "--as-user", "--stdin")]
    misplaced += [token for token in words if token == "--as-user" or token.startswith("--as-user=")]
    if misplaced:
        die("选项必须写在别名之前，例如 sshbind exec --as-user app --json 别名 '命令'")
    stdin_data = None
    if getattr(args, "stdin", False):
        source = getattr(sys.stdin, "buffer", sys.stdin)
        stdin_data = source.read(8 * 1024 * 1024 + 1)
        if len(stdin_data) > 8 * 1024 * 1024:
            die("标准输入超过8MiB限制")
    privilege = _extension_module("bindkit_privilege")
    orchestration = _extension_module("bindkit_orchestration")
    plan = None; context = None; mod = load_policy_module()
    if getattr(args, "as_user", None) and (privilege is None or orchestration is None):
        return _emit_gate_ssh(args, {"decision": "deny", "code": "UNSUPPORTED_PRIVILEGE", "message": "受管身份功能不可用，请重新安装 BindKit。"}, command)
    managed_enabled = bool(getattr(args, "as_user", None) or server.get("sudo_auth") in ("keyring", "nopasswd"))
    if privilege is not None and managed_enabled:
        try:
            raw = mod.read_policy("ssh") if mod else {}
            effective = mod.effective_ssh_policy(raw.get("data") or {}, args.name) if mod else {}
            plan = privilege.build_plan(command, server["user"], as_user=getattr(args, "as_user", None), allowed_users=effective.get("allowed_users", []))
            if plan.get("unsupported"):
                return _emit_gate_ssh(args, {"decision": "deny", "code": "UNSUPPORTED_PRIVILEGE", "message": "复杂或交互式提权不受支持；请用 --as-user 指定身份与非交互命令。"}, command)
            if plan.get("managed"):
                def resolve_uid(target):
                    identity = target[1:] if target.startswith("#") else target
                    query = ssh_with_key(server["host"], server["user"], server["port"], server["key"], server.get("certificate")) + ["id -u -- " + shlex.quote(identity)]
                    rc, out, _ = run_ssh(query, timeout=min(20, args.timeout))
                    return int(out.strip()) if rc == 0 and re.fullmatch(r"[0-9]{1,10}", out.strip()) else None
                plan = privilege.build_plan(command, server["user"], as_user=getattr(args, "as_user", None), allowed_users=effective.get("allowed_users", []), uid_resolver=resolve_uid)
                if orchestration is None:
                    raise ValueError("missing orchestration")
                context = dict(plan, connection=orchestration.connection_context(server))
        except Exception:
            return _emit_gate_ssh(args, {"decision": "deny", "code": "AUTHZ_DENIED", "message": "执行身份校验失败，已拒绝执行。"}, command)
    if context is None and orchestration is not None and mod is not None and mod.is_sudo_command(command)[0]:
        context = {"connection": orchestration.connection_context(server), "managed": False,
                   "target_user": None, "target_uid": None, "approval_exempt": False}
    gate = _policy_gate_ssh(args.name, command, context=context)
    if gate and gate.get("decision") == "ask" and mod and orchestration:
        review_context = {"policy_revision": mod.policy_revision("ssh"),
            "operation": "as_user" if getattr(args, "as_user", None) else "sudo",
            "resource": {"alias": args.name, "host": server["host"], "port": server["port"], "user": server["user"]},
            "target_user": (plan or {}).get("target_user"), "target_uid": (plan or {}).get("target_uid"),
            "effective_level": "sudo", "hard_allowed": True,
            "protected": orchestration.protected_operation(command), "command": command}
        gate = orchestration.review_gate("ssh", gate, review_context, mod,
            lambda: _policy_gate_ssh(args.name, command, context=context))
    if gate and gate.get("decision") in ("deny", "ask"):
        return _emit_gate_ssh(args, gate, command)
    started = None; managed_result = None; t0 = time.time()
    if plan and plan.get("managed"):
        try:
            latest = load_state()["servers"].get(args.name)
            if not latest or orchestration.connection_context(latest) != context["connection"]:
                started = False
                managed_result = {"exit_code": 5, "stdout": "", "stderr": "", "started": False, "authenticated": False,
                    "error": {"code": "CONNECTION_CHANGED", "message": "连接已变化，请重新提交命令以重新审核。"}}
            else:
                vault_module = _extension_module("bindkit_vault", required=True)
                managed_result = privilege.execute_plan(_self_module(), server, plan, vault_module.Vault(), stdin_data=stdin_data, timeout=args.timeout)
                started = managed_result.get("started")
        except Exception:
            managed_result = {"exit_code": 255, "stdout": "", "stderr": "", "started": None, "authenticated": False,
                "error": {"code": "EXECUTION_STATE_UNKNOWN", "message": "无法确认执行状态，请勿自动重试。"}}
        finally:
            if gate and gate.get("approval_lease"):
                try:
                    mod.finish_approval("ssh", gate["consumed_approval"], gate["approval_lease"], started=started)
                except Exception:
                    # Never replay when lease persistence fails after an execution attempt.
                    if managed_result is None:
                        managed_result = {"exit_code": 255, "stdout": "", "stderr": "", "started": None, "authenticated": False}
                    managed_result["error"] = {"code": "APPROVAL_FINALIZATION_FAILED", "message": "执行占用保存失败，请人工检查执行结果，勿自动重试。"}
                    managed_result["exit_code"] = 255
        rc, out, err = managed_result["exit_code"], managed_result["stdout"], managed_result["stderr"]
    else:
        cmd = ssh_with_key(server["host"], server["user"], server["port"], server["key"], server.get("certificate")) + [command]
        rc, out, err = run_ssh(cmd, timeout=args.timeout, **({"stdin_data": stdin_data} if stdin_data is not None else {}))
    ms = int((time.time() - t0) * 1000)
    if args.json:
        envelope = {"alias": args.name, "host": server["host"], "user": server["user"], "command": command,
                    "exit_code": rc, "stdout": out, "stderr": err, "duration_ms": ms}
        if managed_result:
            envelope.update({key: managed_result.get(key) for key in ("started", "authenticated", "error")})
            envelope["target_user"] = plan["target_user"]
        print(json.dumps(envelope, ensure_ascii=False, indent=2))
    else:
        if out: sys.stdout.write(out)
        if err: sys.stderr.write(err)
        if managed_result and managed_result.get("error"):
            sys.stderr.write(managed_result["error"]["code"] + ": " + managed_result["error"]["message"] + "\n")
    return rc if 0 <= rc <= 255 else 1


def cmd_doctor(args):
    print()
    checks = [("ssh 命令", shutil.which("ssh") is not None),
              ("ssh-keygen 命令", shutil.which("ssh-keygen") is not None)]
    ver = subprocess.run(["ssh", "-V"], stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT).stdout.decode()
    checks.append(("OpenSSH 版本: %s" % ver.strip(), True))
    askpass_ok = True
    try:
        askpass_ok = int(re.search(r"OpenSSH_(\d+)", ver).group(1)) >= 9
    except (AttributeError, ValueError, TypeError):
        pass
    checks.append(("SSH_ASKPASS_REQUIRE 支持（非交互输密码/口令）", askpass_ok))
    agent_keys = subprocess.run(["ssh-add", "-l"], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT)
    if agent_keys.returncode == 0:
        n = len([l for l in agent_keys.stdout.decode().splitlines() if l.strip()])
        checks.append(("ssh-agent 可用（已加载 %d 把密钥）" % n, True))
    else:
        checks.append(("ssh-agent 可用", False))
    for label, good in checks:
        print("  %s %s" % (("✅" if good else "⚠️ "), label))
    print()
    state = load_state()
    adopted = sum(1 for s in state["servers"].values() if s.get("source") == "adopted")
    print("  已绑定服务器：%d 台（其中纳管 %d 台）" % (len(state["servers"]), adopted))
    print("  密钥目录：%s" % KEYS_DIR)
    print()
    return 0


