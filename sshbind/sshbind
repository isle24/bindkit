def resolve_auth(args, for_what="推送公钥"):
    """
    根据命令行参数决定认证方式与凭据。
    优先级：--agent > --identity > --password / --password-stdin > 交互式提示密码
    """
    if getattr(args, "agent", False) and getattr(args, "identity", None):
        die("--agent 与 --identity 不能同时使用，请二选一")

    if getattr(args, "agent", False):
        return make_auth(AUTH_AGENT)

    if getattr(args, "identity", None):
        identities = []
        for f in args.identity:
            p = os.path.expanduser(f)
            if not os.path.exists(p):
                die("找不到私钥文件：%s" % p)
            identities.append(p)
        passphrase = None
        need_prompt = any(key_is_encrypted(p) for p in identities)
        if getattr(args, "identity_passphrase_stdin", False):
            passphrase = sys.stdin.readline().rstrip("\n")
            if not passphrase:
                die("从 stdin 读到的私钥口令为空")
        elif need_prompt:
            if not sys.stdin.isatty():
                die("私钥 %s 带口令，但当前不是交互式终端。\n"
                    "  请用 --identity-passphrase-stdin 从管道传入口令。"
                    % os.path.basename(identities[0]))
            try:
                passphrase = getpass.getpass("  私钥口令（输入时不可见）: ")
            except (KeyboardInterrupt, EOFError):
                print()
                die("已取消")
            if not passphrase:
                die("私钥口令为空，已取消")
        return make_auth(AUTH_KEY, identities=identities, passphrase=passphrase)

    # 密码模式
    if getattr(args, "password_stdin", False):
        password = sys.stdin.readline().rstrip("\n")
        if not password:
            die("从 stdin 读到的密码为空")
        return make_auth(AUTH_PASSWORD, password=password)

    if not sys.stdin.isatty():
        die("当前不是交互式终端，无法提示输入密码。请改用：\n"
            "   --password-stdin          从管道读密码\n"
            "   --identity ~/.ssh/id_rsa  用已有私钥认证\n"
            "   --agent                   用 ssh-agent 认证")
    try:
        password = getpass.getpass("  密码（输入时不可见）: ")
    except (KeyboardInterrupt, EOFError):
        print()
        die("已取消")
    if not password:
        die("密码为空，已取消")
    return make_auth(AUTH_PASSWORD, password=password)


def validate_name(name):
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", name):
        die("名称只能包含字母、数字、点、下划线、连字符，且不能以符号开头：%s" % name)
    if name in ("*", "?", "!"):
        die("名称非法：%s" % name)


